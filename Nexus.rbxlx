<Item class="ReplicatedStorage" referent="RBX00000050"><Properties></Properties><Item class="Folder" referent="RBX00000017"><Properties><string name="Name">Nexus</string></Properties><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Config</string><ProtectedString name="Source">--!strict
--[[
	Config/init.luau
	Aggregates every configuration table behind one require. Because this folder
	has an init.luau, `require(ReplicatedStorage.Nexus.Config)` returns this
	bundle, while `require(...Config.Buildings)` still works for direct access.
]]

local Config = {
	Balance = require(script.Balance),
	Resources = require(script.Resources),
	Buildings = require(script.Buildings),
	Technologies = require(script.Technologies),
	Governments = require(script.Governments),
	Laws = require(script.Laws),
}

return Config
</ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Balance</string><ProtectedString name="Source">--!strict
--[[
	Config/Balance.luau
	Every tunable number that shapes the feel of the game. Isolated from code so
	an economy designer can rebalance without reading a single service.
]]

local Balance = {}

-- Starting state for a brand-new nation.
Balance.START = {
	resources = {
		money = 25000,
		materials = 500,
		energy = 0,
		food = 300,
		research = 0,
		influence = 50,
	},
	population = 20,
	treasury = 25000,
	taxRate = 0.15,
}

-- Economy tuning.
Balance.ECONOMY = {
	-- Each employed citizen contributes this much raw output to GDP per tick.
	gdpPerWorker = 12,
	-- Tax revenue = gdp * taxRate * this efficiency (corruption erodes it).
	taxEfficiency = 1.0,
	-- Above this tax rate, happiness starts to fall each politics tick.
	taxHappinessThreshold = 0.35,
	-- Debt accrues interest each economy tick at interestRate / ticksPerYear.
	baseInterestRate = 4.0, -- percent, annual
	ticksPerYear = 365,
	-- Inflation drifts toward this target based on money-supply pressure.
	inflationTarget = 2.0,
	inflationDrift = 0.02,
	-- Bankruptcy: treasury below this triggers emergency measures.
	bankruptcyFloor = -50000,
	-- Food shortfall converts to unrest at this rate.
	starvationUnrest = 0.5,
	-- Food consumed per citizen per economy tick.
	foodPerCapita = 0.35,
	-- Fraction of a surplus applied to debt repayment each tick.
	debtRepayFraction = 0.10,
}

-- Population / citizen tuning.
Balance.CITIZENS = {
	-- Baseline happiness with no buildings and moderate taxes.
	baseHappiness = 55,
	-- Population grows/shrinks toward capacity by this fraction per citizen tick.
	growthRate = 0.03,
	-- Happiness needed to attract new residents; below it, people leave.
	migrationHappiness = 50,
	-- Each unit of housing capacity supports this many citizens.
	housingMultiplier = 1.0,
	-- Fraction of the population that is working-age and seeking work.
	participation = 0.6,
	-- Unemployment above this fraction erodes happiness.
	unemploymentTolerance = 0.15,
	-- Education and health each nudge happiness toward their own value.
	serviceInfluence = 0.15,
}

-- Politics tuning.
Balance.POLITICS = {
	-- Approval drifts toward a target derived from happiness &amp; economy.
	approvalDrift = 0.1,
	-- Stability = weighted blend; below this, crises can fire.
	crisisStabilityThreshold = 35,
	-- Corruption naturally creeps up; anti-corruption laws push it down.
	corruptionCreep = 0.05,
	-- Term length in seconds of real playtime for elective governments.
	electionTermSeconds = 60 * 20,
}

-- Research tuning.
Balance.RESEARCH = {
	-- Research buildings convert their output into points at this rate.
	pointConversion = 1.0,
	-- Flat passive research from an educated populace.
	passivePerEducation = 0.05,
}

-- Construction tuning.
Balance.CONSTRUCTION = {
	-- Refund fraction when a player demolishes a building.
	demolishRefund = 0.4,
	-- Condition lost per economy tick; maintenance offsets it.
	decayPerTick = 0.002,
	-- Below this condition a building goes offline until repaired.
	offlineCondition = 0.25,
	-- Upgrade cost multiplier growth is defined per-building; this is the cap.
	maxLevel = 5,
}

return Balance
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Buildings</string><ProtectedString name="Source">--!strict
--[[
	Config/Buildings.luau
	The catalogue every construction decision reads from. Each entry is a pure
	data record (Types.BuildingDef). Costs scale per upgrade level via `scale`,
	which keeps the tables terse while remaining fully data-driven.

	Balance intent:
	  * Level 1 is affordable early; upgrades cost geometrically more.
	  * Producers need power and jobs, so growth forces power + housing first.
	  * Every category has a clear role in the economy/citizen loop.
]]

local Types = require(script.Parent.Parent.Types)

type BuildingDef = Types.BuildingDef
type ResourceBag = Types.ResourceBag

-- Build a per-level cost table from a base cost and a geometric growth factor.
local function scale(base: ResourceBag, maxLevel: number, growth: number): { [number]: ResourceBag }
	local out: { [number]: ResourceBag } = {}
	for level = 1, maxLevel do
		local factor = growth ^ (level - 1)
		local bag: ResourceBag = {}
		for resource, amount in base do
			bag[resource :: any] = math.floor(amount * factor + 0.5)
		end
		out[level] = bag
	end
	return out
end

local Buildings: { [string]: BuildingDef } = {}

local function define(def: BuildingDef)
	Buildings[def.kind] = def
end

-- ---- Housing --------------------------------------------------------------

define({
	kind = "house",
	displayName = "Housing Block",
	category = "Housing",
	description = "Homes for citizens. More housing raises your population cap.",
	footprint = { w = 2, h = 2 },
	requiresTech = nil,
	maxLevel = 5,
	cost = scale({ money = 1200, materials = 40 }, 5, 1.8),
	upkeep = { money = 20 },
	produces = {},
	jobs = 0,
	powerDraw = 4,
	powerSupply = 0,
	happiness = 1,
	housing = 25,
})

define({
	kind = "apartments",
	displayName = "Apartment Tower",
	category = "Housing",
	description = "Dense vertical housing. Efficient land use, higher upkeep.",
	footprint = { w = 2, h = 2 },
	requiresTech = "construction_1",
	maxLevel = 5,
	cost = scale({ money = 6000, materials = 180 }, 5, 1.7),
	upkeep = { money = 90 },
	produces = {},
	jobs = 0,
	powerDraw = 14,
	powerSupply = 0,
	happiness = 0,
	housing = 120,
})

-- ---- Power ----------------------------------------------------------------

define({
	kind = "coal_plant",
