}

return Governments
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Laws</string><ProtectedString name="Source">--!strict
--[[
	Config/Laws.luau
	Toggleable national policies. Each law is a trade-off applied while active,
	so a player crafts an identity by stacking laws that fit their strategy.
	Some laws require a government type or technology to enact.
]]

local Types = require(script.Parent.Parent.Types)

type GovernmentId = Types.GovernmentId

export type LawDef = {
	id: string,
	displayName: string,
	description: string,
	requiresTech: string?,
	forbiddenGovernments: { GovernmentId },
	modifiers: {
		happiness: number?,
		taxEfficiency: number?,
		corruption: number?,
		researchBonus: number?,
		foodProduction: number?,
		stability: number?,
		upkeep: number?, -- multiplier on all building upkeep
	},
}

local Laws: { [string]: LawDef } = {
	free_healthcare = {
		id = "free_healthcare",
		displayName = "Universal Healthcare",
		description = "+happiness and health, but building upkeep rises 8%.",
		requiresTech = "medicine_1",
		forbiddenGovernments = {},
		modifiers = { happiness = 5, upkeep = 0.08 },
	},
	free_education = {
		id = "free_education",
		displayName = "Free Education",
		description = "Boosts research output 15% at the cost of 6% upkeep.",
		requiresTech = nil,
		forbiddenGovernments = {},
		modifiers = { researchBonus = 0.15, upkeep = 0.06 },
	},
	anti_corruption = {
		id = "anti_corruption",
		displayName = "Anti-Corruption Bureau",
		description = "Sharply reduces corruption; slightly lowers stability.",
		requiresTech = "government_1",
		forbiddenGovernments = { "authoritarian" },
		modifiers = { corruption = -12, stability = -2 },
	},
	subsidised_farming = {
		id = "subsidised_farming",
		displayName = "Farm Subsidies",
		description = "+20% food production, funded by lower tax efficiency.",
		requiresTech = nil,
		forbiddenGovernments = {},
		modifiers = { foodProduction = 0.20, taxEfficiency = -0.05 },
	},
	martial_law = {
		id = "martial_law",
		displayName = "Martial Law",
		description = "Large stability gain, heavy happiness cost.",
		requiresTech = nil,
		forbiddenGovernments = { "democracy" },
		modifiers = { stability = 15, happiness = -10 },
	},
	press_freedom = {
		id = "press_freedom",
		displayName = "Press Freedom",
		description = "Happier, less corrupt citizens; a small stability risk.",
		requiresTech = nil,
		forbiddenGovernments = { "authoritarian", "military" },
		modifiers = { happiness = 4, corruption = -5, stability = -3 },
	},
}

return Laws
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Resources</string><ProtectedString name="Source">--!strict
--[[
	Config/Resources.luau
	Display metadata for each resource. Simulation math lives elsewhere; this is
	purely how a resource is labelled and coloured in the UI.
]]

export type ResourceMeta = {
	id: string,
	displayName: string,
	symbol: string,
	color: { number }, -- {r, g, b} 0..1
	-- Whether the HUD shows an absolute stockpile or a per-tick flow.
	kind: "stock" | "flow",
	description: string,
}

local Resources: { [string]: ResourceMeta } = {
	money = {
		id = "money",
		displayName = "Treasury",
		symbol = "$",
		color = { 0.36, 0.82, 0.45 },
		kind = "stock",
		description = "Liquid national funds used for construction and services.",
	},
	materials = {
		id = "materials",
		displayName = "Materials",
		symbol = "▣",
		color = { 0.78, 0.6, 0.36 },
		kind = "stock",
		description = "Raw building stock consumed by construction and upgrades.",
	},
	energy = {
		id = "energy",
		displayName = "Power",
		symbol = "⚡",
		color = { 0.98, 0.82, 0.32 },
		kind = "flow",
		description = "Net electrical capacity. Negative power idles buildings.",
	},
	food = {
		id = "food",
		displayName = "Food",
		symbol = "❖",
		color = { 0.55, 0.78, 0.4 },
		kind = "stock",
		description = "Feeds the population. Shortfalls breed unrest.",
	},
	research = {
		id = "research",
		displayName = "Research",
		symbol = "✦",
		color = { 0.45, 0.66, 0.95 },
		kind = "flow",
		description = "Points that advance the technology tree.",
	},
	influence = {
		id = "influence",
		displayName = "Influence",
		symbol = "◆",
		color = { 0.72, 0.5, 0.92 },
		kind = "stock",
		description = "Diplomatic capital spent on treaties and expansion.",
	},
}

return Resources
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Technologies</string><ProtectedString name="Source">--!strict
--[[
	Config/Technologies.luau
	The research tree. Each tech gates buildings and/or applies named modifiers
	that services look up (e.g. EconomyService reads "taxBonus"). Prerequisites
	form a DAG validated by ResearchService before anything can be unlocked.
]]

local Types = require(script.Parent.Parent.Types)

type TechDef = Types.TechDef

local Technologies: { [string]: TechDef } = {}

local function define(def: TechDef)
	Technologies[def.id] = def
end

-- ---- Construction branch --------------------------------------------------

define({
	id = "construction_1",
	displayName = "Reinforced Concrete",
	branch = "Construction",
	description = "Unlocks dense apartment towers and cuts material costs 5%.",
	cost = 40,
	requires = {},
	unlocksBuildings = { "apartments" },
	modifiers = { materialCost = -0.05 },
})

-- ---- Energy branch --------------------------------------------------------

define({
	id = "energy_1",
	displayName = "Grid Efficiency",
	branch = "Energy",
	description = "Power plants supply 10% more energy.",
