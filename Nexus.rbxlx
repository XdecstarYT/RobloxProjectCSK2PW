</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Constants</string><ProtectedString name="Source">--!strict
--[[
	Constants.luau
	Immutable, project-wide constants. No gameplay balance numbers live here —
	those belong in Config/Balance.luau so designers can tune them separately.
]]

local Constants = {}

-- Schema version of the persisted profile. Bump this whenever the shape of
-- Types.Profile changes, and add a matching migration in DataService.
Constants.PROFILE_SCHEMA_VERSION = 1

-- DataStore names. Suffixing with an environment tag lets us keep test saves
-- isolated from production ones.
Constants.DATASTORE_NAME = "NexusProfiles_v1"
Constants.DATASTORE_BACKUP_NAME = "NexusProfileBackups_v1"

-- Simulation cadence (seconds of real time per simulated tick).
Constants.ECONOMY_TICK = 5
Constants.CITIZEN_TICK = 10
Constants.POLITICS_TICK = 30

-- Autosave cadence and session-lock behaviour.
Constants.AUTOSAVE_INTERVAL = 90
Constants.SESSION_LOCK_STALE_AFTER = 60 * 30 -- a lock older than this is reclaimable
Constants.DATASTORE_MAX_RETRIES = 5

-- World grid. The buildable map is a square grid of this many tiles per side,
-- each tile STUDS_PER_TILE studs wide.
Constants.GRID_SIZE = 64
Constants.STUDS_PER_TILE = 8

-- Networking guardrails.
Constants.NET_FOLDER_NAME = "NexusRemotes"
Constants.NET_REQUEST_TIMEOUT = 10

-- How many GDP samples to retain for the economy graph.
Constants.GDP_HISTORY_LENGTH = 60

-- The set of resource ids, in a stable display order.
Constants.RESOURCE_ORDER = { "money", "materials", "energy", "food", "research", "influence" } :: { string }

return Constants
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Logger</string><ProtectedString name="Source">--!strict
--[[
	Logger.luau
	Namespaced, level-filtered logging. Every subsystem creates its own logger
	via Logger.new("EconomyService") so output is greppable and can be muted per
	scope in production without touching call sites.
]]

local Logger = {}
Logger.__index = Logger

export type Level = "debug" | "info" | "warn" | "error"

local LEVEL_WEIGHT: { [Level]: number } = {
	debug = 10,
	info = 20,
	warn = 30,
	error = 40,
}

-- Raise this to "info" or "warn" in a shipped build to quiet the console.
local minLevel: Level = "debug"

export type Logger = {
	Debug: (self: Logger, ...any) -&gt; (),
	Info: (self: Logger, ...any) -&gt; (),
	Warn: (self: Logger, ...any) -&gt; (),
	Error: (self: Logger, ...any) -&gt; (),
}

function Logger.setMinLevel(level: Level)
	minLevel = level
end

local function format(scope: string, level: Level, ...: any): string
	local parts = {}
	for i = 1, select("#", ...) do
		parts[i] = tostring(select(i, ...))
	end
	return ("[Nexus/%s][%s] %s"):format(scope, level:upper(), table.concat(parts, " "))
end

function Logger.new(scope: string): Logger
	local self = setmetatable({ _scope = scope }, Logger)
	return (self :: any) :: Logger
end

function Logger:_emit(level: Level, ...: any)
	if LEVEL_WEIGHT[level] &lt; LEVEL_WEIGHT[minLevel] then
		return
	end
	local message = format(self._scope, level, ...)
	if level == "error" then
		warn(message) -- keep the traceback path but never `error()` from logging
	elseif level == "warn" then
		warn(message)
	else
		print(message)
	end
end

function Logger:Debug(...: any)
	self:_emit("debug", ...)
end

function Logger:Info(...: any)
	self:_emit("info", ...)
end

function Logger:Warn(...: any)
	self:_emit("warn", ...)
end

function Logger:Error(...: any)
	self:_emit("error", ...)
end

return Logger
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Net</string><ProtectedString name="Source">--!strict
--[[
	Net.luau
	The single, guarded gateway between client and server.

	Everything that crosses the wire goes through one RemoteFunction (`Request`,
	for round-trip actions) and one RemoteEvent (`Push`, for fire-and-forget in
	both directions). Traffic is multiplexed by a string `route`, so adding a new
	message never means adding a new Instance a exploiter could probe.

	Server responsibilities baked in here (never trust the client):
	  * per-player, per-route token-bucket rate limiting
	  * payload shape/size guards before a handler ever runs
	  * every handler wrapped so a thrown error becomes a clean NetResult, not a
	    leaked stack trace or a dropped RemoteFunction invocation

	The module detects its context via RunService and only exposes the API that
	is safe for that side.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(script.Parent.Constants)
local Logger = require(script.Parent.Logger)
local Types = require(script.Parent.Types)

type NetResult = Types.NetResult

local log = Logger.new("Net")
local IS_SERVER = RunService:IsServer()

local Net = {}

-- Default rate budget applied to every route unless a handler overrides it.
local DEFAULT_RATE = { rate = 20, per = 1 } -- 20 requests per second, bursty via bucket

-- ---------------------------------------------------------------------------
-- Remote instances
-- ---------------------------------------------------------------------------

local requestRemote: RemoteFunction
local pushRemote: RemoteEvent

local function buildRemotes()
	local folder = Instance.new("Folder")
	folder.Name = Constants.NET_FOLDER_NAME

	requestRemote = Instance.new("RemoteFunction")
	requestRemote.Name = "Request"
	requestRemote.Parent = folder

	pushRemote = Instance.new("RemoteEvent")
	pushRemote.Name = "Push"
	pushRemote.Parent = folder

	folder.Parent = ReplicatedStorage
end

local function findRemotes()
	local folder = ReplicatedStorage:WaitForChild(Constants.NET_FOLDER_NAME, 20)
	assert(folder, "[Net] remote folder never replicated")
	requestRemote = folder:WaitForChild("Request") :: RemoteFunction
	pushRemote = folder:WaitForChild("Push") :: RemoteEvent
end

-- ---------------------------------------------------------------------------
-- Server implementation
-- ---------------------------------------------------------------------------

if IS_SERVER then
	local Players = game:GetService("Players")

	type RequestHandler = (player: Player, payload: any) -&gt; any
	type EventHandler = (player: Player, payload: any) -&gt; ()
	type RateConfig = { rate: number, per: number }

	local requestHandlers: { [string]: { fn: RequestHandler, rate: RateConfig } } = {}
	local eventHandlers: { [string]: { fn: EventHandler, rate: RateConfig } } = {}

	-- Token buckets keyed by player then route.
	local buckets: { [Player]: { [string]: { tokens: number, updated: number } } } = {}

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)

	local function consumeToken(player: Player, route: string, cfg: RateConfig): boolean
		local perPlayer = buckets[player]
		if not perPlayer then
			perPlayer = {}
			buckets[player] = perPlayer
		end
		local bucket = perPlayer[route]
		local now = os.clock()
		if not bucket then
			bucket = { tokens = cfg.rate, updated = now }
			perPlayer[route] = bucket
		end
		-- Refill proportionally to elapsed time, capped at capacity.
		local elapsed = now - bucket.updated
		bucket.updated = now
		bucket.tokens = math.min(cfg.rate, bucket.tokens + elapsed * (cfg.rate / cfg.per))
		if bucket.tokens &gt;= 1 then
			bucket.tokens -= 1
			return true
		end
		return false
	end

	-- Reject anything that could be a memory-abuse vector before dispatch.
	local function payloadIsSane(payload: any): boolean
		local t = typeof(payload)
		if t == "nil" or t == "number" or t == "boolean" or t == "string" then
			return t ~= "string" or #payload &lt;= 4096
		end
		if t == "table" then
			return true -- handlers do the deep validation
		end
		return false
	end

	-- Create the remotes before wiring any handler onto them.
	buildRemotes()

	requestRemote.OnServerInvoke = function(player: Player, route: any, payload: any): NetResult
		if typeof(route) ~= "string" then
			return { ok = false, error = "bad_route" }
		end
		local entry = requestHandlers[route]
		if not entry then
			log:Warn(("unknown request route %q from %s"):format(route, player.Name))
			return { ok = false, error = "unknown_route" }
		end
		if not payloadIsSane(payload) then
			return { ok = false, error = "bad_payload" }
		end
		if not consumeToken(player, route, entry.rate) then
			return { ok = false, error = "rate_limited" }
		end

		local ok, result = pcall(entry.fn, player, payload)
		if not ok then
			log:Warn(("handler %q errored: %s"):format(route, tostring(result)))
			return { ok = false, error = "internal" }
		end
		return { ok = true, data = result }
	end

	pushRemote.OnServerEvent:Connect(function(player: Player, route: any, payload: any)
		if typeof(route) ~= "string" then
			return
		end
		local entry = eventHandlers[route]
		if not entry then
			return
		end
		if not payloadIsSane(payload) then
			return
		end
		if not consumeToken(player, route, entry.rate) then
			return
		end
		local ok, err = pcall(entry.fn, player, payload)
		if not ok then
			log:Warn(("event %q errored: %s"):format(route, tostring(err)))
		end
	end)

	--- Register a round-trip handler. `handler(player, payload)` returns the
	--- data to send back; throwing yields `{ ok = false, error = "internal" }`.
	function Net.handleRequest(route: string, handler: RequestHandler, rate: RateConfig?)
		assert(not requestHandlers[route], "duplicate request route: " .. route)
		requestHandlers[route] = { fn = handler, rate = rate or DEFAULT_RATE }
	end

	--- Register a fire-and-forget client -&gt; server handler.
	function Net.onEvent(route: string, handler: EventHandler, rate: RateConfig?)
		assert(not eventHandlers[route], "duplicate event route: " .. route)
		eventHandlers[route] = { fn = handler, rate = rate or DEFAULT_RATE }
	end

	function Net.fireClient(player: Player, route: string, payload: any)
		pushRemote:FireClient(player, route, payload)
	end

	function Net.fireAllClients(route: string, payload: any)
		pushRemote:FireAllClients(route, payload)
	end

	log:Info("server gateway ready")
else
	-- -----------------------------------------------------------------------
	-- Client implementation
	-- -----------------------------------------------------------------------

	local listeners: { [string]: { (payload: any) -&gt; () } } = {}

	findRemotes()

	pushRemote.OnClientEvent:Connect(function(route: any, payload: any)
		if typeof(route) ~= "string" then
			return
		end
		local bucket = listeners[route]
		if not bucket then
			return
		end
		for _, fn in bucket do
			local ok, err = pcall(fn, payload)
			if not ok then
				log:Warn(("client listener %q errored: %s"):format(route, tostring(err)))
			end
		end
	end)

	--- Round-trip request to the server. Always resolves to a NetResult; network
	--- failures are converted into `{ ok = false, error = "network" }`.
	function Net.request(route: string, payload: any?): NetResult
		local ok, result = pcall(function()
			return requestRemote:InvokeServer(route, payload)
		end)
		if not ok then
			log:Warn(("request %q failed: %s"):format(route, tostring(result)))
			return { ok = false, error = "network" }
		end
		if typeof(result) ~= "table" then
			return { ok = false, error = "malformed_response" }
		end
		return result :: NetResult
	end

	function Net.fireServer(route: string, payload: any?)
		pushRemote:FireServer(route, payload)
	end

	--- Subscribe to a server push. Returns an unsubscribe function.
	function Net.onEvent(route: string, handler: (payload: any) -&gt; ()): () -&gt; ()
		local bucket = listeners[route]
		if not bucket then
			bucket = {}
			listeners[route] = bucket
		end
		table.insert(bucket, handler)
		return function()
			local i = table.find(bucket, handler)
			if i then
				table.remove(bucket, i)
			end
		end
	end

	log:Info("client gateway ready")
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">NetRoutes</string><ProtectedString name="Source">--!strict
--[[
	NetRoutes.luau
	The canonical list of network route names. Both sides import these constants
	instead of typing string literals, so a renamed route is a compile-time find,
	not a silent runtime mismatch.
]]

local NetRoutes = {
	-- Client -&gt; server requests (round-trip, return a NetResult).
	PLACE_BUILDING = "city/place",
	UPGRADE_BUILDING = "city/upgrade",
	DEMOLISH_BUILDING = "city/demolish",
	REPAIR_BUILDING = "city/repair",
	SET_TAX_RATE = "politics/setTax",
	SET_GOVERNMENT = "politics/setGovernment",
	TOGGLE_LAW = "politics/toggleLaw",
	START_RESEARCH = "research/start",
	RENAME_NATION = "nation/rename",

	-- Diplomacy.
	PROPOSE_TRADE = "diplomacy/propose",
	RESPOND_TRADE = "diplomacy/respond",
	CANCEL_TRADE = "diplomacy/cancel",
	PROPOSE_ALLIANCE = "diplomacy/ally",
	BREAK_ALLIANCE = "diplomacy/breakAlly",

	-- Territory.
	CLAIM_REGION = "territory/claim",

	-- Military.
	RECRUIT_UNITS = "military/recruit",
	DISBAND_UNITS = "military/disband",

	-- Market.
	MARKET_BUY = "market/buy",
	MARKET_SELL = "market/sell",

	-- Server -&gt; client pushes.
	STATE_SYNC = "state/sync",
	NOTIFY = "state/notify",
	TRADE_INBOX = "diplomacy/inbox",
	WORLD_SYNC = "world/sync",
	TERRITORY_SYNC = "territory/sync",
	MARKET_SYNC = "market/sync",
}

return NetRoutes
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">ResourceMath</string><ProtectedString name="Source">--!strict
--[[
	ResourceMath.luau
	Pure helpers for combining ResourceBags. The server uses these to mutate the
	authoritative treasury; the client uses the read-only ones (canAfford) to
	grey out unaffordable options. Keeping the affordability rule in one place
	guarantees the UI and the server never disagree about what a player can buy.
]]

local Types = require(script.Parent.Types)

type ResourceBag = Types.ResourceBag

local ResourceMath = {}

--- A fresh zeroed bag over every known resource.
function ResourceMath.zero(): ResourceBag
	return {
		money = 0,
		materials = 0,
		energy = 0,
		food = 0,
		research = 0,
		influence = 0,
	}
end

--- Non-mutating a + b.
function ResourceMath.add(a: ResourceBag, b: ResourceBag): ResourceBag
	local out = table.clone(a)
	for resource, amount in b do
		out[resource :: any] = (out[resource :: any] or 0) + amount
	end
	return out
end

--- Non-mutating a * scalar.
function ResourceMath.scale(a: ResourceBag, scalar: number): ResourceBag
	local out: ResourceBag = {}
	for resource, amount in a do
		out[resource :: any] = amount * scalar
	end
	return out
end

--- True when `wallet` covers every positive cost in `cost`.
function ResourceMath.canAfford(wallet: ResourceBag, cost: ResourceBag): boolean
	for resource, amount in cost do
		if amount &gt; 0 and (wallet[resource :: any] or 0) &lt; amount then
			return false
		end
	end
	return true
end

--- Mutating: subtract `cost` from `wallet` in place. Callers must have already
--- checked canAfford; this does not guard against going negative.
function ResourceMath.spend(wallet: ResourceBag, cost: ResourceBag)
	for resource, amount in cost do
		wallet[resource :: any] = (wallet[resource :: any] or 0) - amount
	end
end

--- Mutating: add `gain` to `wallet` in place.
function ResourceMath.grant(wallet: ResourceBag, gain: ResourceBag)
	for resource, amount in gain do
		wallet[resource :: any] = (wallet[resource :: any] or 0) + amount
	end
end

return ResourceMath
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Signal</string><ProtectedString name="Source">--!strict
--[[
	Signal.luau
	A minimal, original event/observer primitive.

	Roblox's BindableEvents copy arguments and cannot pass some types across the
	boundary; a plain-table signal is faster and lossless for in-VM messaging.
	Handlers fire synchronously in subscription order under a pcall so one bad
	listener cannot break the rest.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = {
	Disconnect: (self: Connection) -&gt; (),
	Connected: boolean,
}

export type Signal&lt;T...&gt; = {
	Connect: (self: Signal&lt;T...&gt;, fn: (T...) -&gt; ()) -&gt; Connection,
	Once: (self: Signal&lt;T...&gt;, fn: (T...) -&gt; ()) -&gt; Connection,
	Fire: (self: Signal&lt;T...&gt;, T...) -&gt; (),
	DisconnectAll: (self: Signal&lt;T...&gt;) -&gt; (),
	Destroy: (self: Signal&lt;T...&gt;) -&gt; (),
}

type Handler = {
	fn: (...any) -&gt; (),
	connected: boolean,
	once: boolean,
}

function Signal.new&lt;T...&gt;(): Signal&lt;T...&gt;
	local self = setmetatable({
		_handlers = {} :: { Handler },
	}, Signal)
	return (self :: any) :: Signal&lt;T...&gt;
end

function Signal:Connect(fn: (...any) -&gt; ()): Connection
	local handler: Handler = { fn = fn, connected = true, once = false }
	table.insert(self._handlers, handler)

	local connection = {}
	connection.Connected = true
	function connection:Disconnect()
		self.Connected = false
		handler.connected = false
	end
	return connection :: any
end

function Signal:Once(fn: (...any) -&gt; ()): Connection
	local handler: Handler = { fn = fn, connected = true, once = true }
	table.insert(self._handlers, handler)

	local connection = {}
	connection.Connected = true
	function connection:Disconnect()
		self.Connected = false
		handler.connected = false
	end
	return connection :: any
end

function Signal:Fire(...: any)
	-- Iterate over a snapshot so handlers may connect/disconnect during firing.
	local snapshot = table.clone(self._handlers)
	for _, handler in snapshot do
		if not handler.connected then
			continue
		end
		if handler.once then
			handler.connected = false
		end
		local ok, err = pcall(handler.fn, ...)
		if not ok then
			warn(("[Signal] handler error: %s"):format(tostring(err)))
		end
	end

	-- Compact out dead handlers so the list does not grow unbounded.
	for i = #self._handlers, 1, -1 do
		if not self._handlers[i].connected then
			table.remove(self._handlers, i)
		end
	end
end

function Signal:DisconnectAll()
	for _, handler in self._handlers do
		handler.connected = false
	end
	table.clear(self._handlers)
end

function Signal:Destroy()
	self:DisconnectAll()
end

return Signal
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">TableUtil</string><ProtectedString name="Source">--!strict
--[[
	TableUtil.luau
	Small, dependency-free helpers used by the data and simulation layers.
]]

local TableUtil = {}

-- Recursive value copy. Used before mutating persisted state and before
-- replicating a snapshot to clients (so the client can never hold a live
-- reference into server-authoritative tables).
function TableUtil.deepCopy&lt;T&gt;(value: T): T
	if typeof(value) ~= "table" then
		return value
	end
	local result = {}
	for k, v in value :: any do
		result[k] = TableUtil.deepCopy(v)
	end
	return (result :: any) :: T
end

-- Fill any missing keys in `target` from `template` without overwriting existing
-- values. This is how DataService reconciles an older save against the current
-- schema: new fields appear with their defaults, existing player data is kept.
function TableUtil.reconcile&lt;T&gt;(target: { [any]: any }, template: T): T
	if typeof(template) ~= "table" then
		return target :: any
	end
	for key, templateValue in template :: any do
		if target[key] == nil then
			target[key] = TableUtil.deepCopy(templateValue)
		elseif typeof(templateValue) == "table" and typeof(target[key]) == "table" then
			TableUtil.reconcile(target[key], templateValue)
		end
	end
	return target :: any
end

function TableUtil.count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- Sum a numeric field across a dictionary of records.
function TableUtil.sumBy&lt;T&gt;(records: { [any]: T }, selector: (T) -&gt; number): number
	local total = 0
	for _, record in records do
		total += selector(record)
	end
	return total
end

function TableUtil.shallowEqual(a: { [any]: any }, b: { [any]: any }): boolean
	for k, v in a do
		if b[k] ~= v then
			return false
		end
	end
	for k, v in b do
		if a[k] ~= v then
			return false
		end
	end
	return true
end

return TableUtil
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
--[[
	Types.luau
	Central typed-Luau definitions shared by server and client.

	Keeping every cross-boundary shape in one module means the network layer,
	the data schema, and the UI all agree on the exact structure of a nation's
	state. When a field changes here, the type checker flags every consumer.
]]

export type ResourceId = "money" | "materials" | "energy" | "food" | "research" | "influence"

-- A player's stockpile of every tradeable/consumable resource.
export type ResourceBag = { [ResourceId]: number }

-- One placed building instance owned by a nation.
export type Building = {
	id: string, -- unique per-nation building uid
	kind: string, -- key into Config.Buildings
	level: number,
	position: { x: number, z: number }, -- grid coordinates
	rotation: number, -- 0, 90, 180, 270
	condition: number, -- 0..1, degrades with age, restored by maintenance
	builtAt: number, -- os.time() when placed
	active: boolean, -- powered + staffed?
}

-- Aggregate, simulated population of a nation.
export type Population = {
	total: number,
	employed: number,
	happiness: number, -- 0..100
	education: number, -- 0..100
	health: number, -- 0..100
	unrest: number, -- 0..100
}

export type GovernmentId =
	"democracy"
	| "republic"
	| "monarchy"
	| "socialist"
	| "technocracy"
	| "military"
	| "authoritarian"

export type Politics = {
	government: GovernmentId,
	approval: number, -- 0..100
	stability: number, -- 0..100
	corruption: number, -- 0..100
	taxRate: number, -- 0..1
	activeLaws: { [string]: boolean },
	nextElection: number, -- os.time(), 0 if not applicable
}

export type Economy = {
	gdp: number,
	gdpHistory: { number }, -- rolling window for graphs
	treasury: number,
	debt: number,
	inflation: number, -- annualised %, e.g. 2.5
	interestRate: number, -- %
	lastTickIncome: number,
	lastTickExpense: number,
}

export type Research = {
	unlocked: { [string]: boolean },
	current: string?, -- tech id in progress
	progress: number, -- points accumulated toward `current`
	points: number, -- unspent research points
}

-- Standing armed forces. Unit counts; strength is derived from them + tech.
export type Military = {
	army: number,
	navy: number,
	air: number,
}

-- Foreign relations. `allies` maps another nation's id (as a string) to true.
export type Diplomacy = {
	allies: { [string]: boolean },
}

-- The full authoritative state for a single nation. This is what the server
-- simulates, saves, and (in a filtered form) replicates to the owning client.
export type Nation = {
	ownerId: number, -- Player.UserId
	name: string,
	founded: number, -- os.time()
	resources: ResourceBag,
	buildings: { [string]: Building },
	population: Population,
	politics: Politics,
	economy: Economy,
	research: Research,
	military: Military,
	diplomacy: Diplomacy,
	territory: { regions: { string } },
	flags: { [string]: boolean }, -- one-time event / tutorial markers
}

-- The persisted profile envelope. `schemaVersion` drives data migration.
export type Profile = {
	schemaVersion: number,
	createdAt: number,
	lastPlayed: number,
	playtime: number,
	nation: Nation,
}

-- Standard result envelope returned across the network boundary.
export type NetResult = {
	ok: boolean,
	error: string?,
	data: any?,
}

-- Building definition (static config, see Config/Buildings.luau).
export type BuildingDef = {
	kind: string,
	displayName: string,
	category: string,
	description: string,
	footprint: { w: number, h: number }, -- grid tiles
	requiresTech: string?,
	maxLevel: number,
	cost: { [number]: ResourceBag }, -- cost per level (1-indexed)
	upkeep: ResourceBag, -- per economic tick, at level 1
	produces: ResourceBag, -- per economic tick, at level 1
	jobs: number, -- staffing demand at level 1
	powerDraw: number, -- energy consumed while active
	powerSupply: number, -- energy produced (for plants)
	happiness: number, -- flat contribution to citizen happiness
	housing: number?, -- residents supported (housing buildings)
	education: number?, -- education service points
	health: number?, -- health service points
}

-- Technology definition (Config/Technologies.luau).
export type TechDef = {
	id: string,
	displayName: string,
	branch: string,
	description: string,
	cost: number, -- research points
	requires: { string }, -- prerequisite tech ids
	unlocksBuildings: { string },
	modifiers: { [string]: number }, -- named economy/politics multipliers
}

return {}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">WorldGrid</string><ProtectedString name="Source">--!strict
--[[
	WorldGrid.luau
	The mapping between the logical build grid (integer tiles the server stores)
	and world-space studs (what the client renders and clicks). Centralising it
	means placement previews, permanent buildings and click-picking all agree on
	exactly where a tile is.

	The grid is centred on the world origin. Tile (0,0) is the corner with the
	most negative X/Z; the ground surface sits at Y = 0.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Nexus.Constants)

local WorldGrid = {}

local STUDS = Constants.STUDS_PER_TILE
local SPAN = Constants.GRID_SIZE * STUDS
local HALF = SPAN / 2

WorldGrid.STUDS = STUDS
WorldGrid.SPAN = SPAN
WorldGrid.GROUND_Y = 0

--- World-space centre of a footprint whose corner tile is (x, z) and whose
--- oriented size is w x h tiles.
function WorldGrid.footprintCenter(x: number, z: number, w: number, h: number): Vector3
	local wx = -HALF + (x + w / 2) * STUDS
	local wz = -HALF + (z + h / 2) * STUDS
	return Vector3.new(wx, WorldGrid.GROUND_Y, wz)
end

--- Convert a world position to the tile it falls in, clamped to the grid.
function WorldGrid.worldToTile(position: Vector3): (number, number)
	local x = math.floor((position.X + HALF) / STUDS)
	local z = math.floor((position.Z + HALF) / STUDS)
	x = math.clamp(x, 0, Constants.GRID_SIZE - 1)
	z = math.clamp(z, 0, Constants.GRID_SIZE - 1)
	return x, z
end

return WorldGrid
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000071"><Properties></Properties><Item class="Script" referent="RBX00000043"><Properties><string name="Name">Nexus</string><ProtectedString name="Source">--!strict
--[[
	init.server.luau
	Server bootstrap. Requires every service, registers it with the Framework,
	then runs the two-phase Init/Start lifecycle. Order of registration does not
	matter — services reference each other lazily, and Framework guarantees all
	Inits run before any Start.

	This is the ONLY server Script; everything else is a ModuleScript, which keeps
	the execution model explicit and testable.
]]

-- Framework and Services are children of this script (Rojo turns the
-- folder-with-init into this Script), so we address them from `script`.
local Framework = require(script.Framework)
local Services = script.Services

-- Foundational services first (data, transport), then simulation, then I/O.
local ORDER = {
	"DataService",
	"ReplicationService",
	"NotificationService",
	"WorldService",
	"CityService",
	"CitizenService",
	"EconomyService",
	"ResearchService",
	"PoliticsService",
	"DiplomacyService",
	"TerritoryService",
	"MilitaryService",
	"MarketService",
	"AIService",
	"EventService",
	"OnboardingService",
}

for _, name in ORDER do
	local module = Services:FindFirstChild(name)
	assert(module, "missing service module: " .. name)
	Framework.register(require(module))
end

Framework.start()

print("[Nexus] server online — Project Nexus nation simulator")
</ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Framework</string><ProtectedString name="Source">--!strict
--[[
	Framework.luau
	A tiny service locator with a two-phase lifecycle.

	Phase 1 (Init): every service constructs its own state. Services must NOT
	touch each other here — order is undefined.
	Phase 2 (Start): the simulation begins. By now every service is registered,
	so a service may freely `Framework.get("EconomyService")`.

	Services reference one another lazily through `Framework.get`, never via a
	top-level require, which keeps the dependency graph acyclic at load time.
]]

local Logger = require(game:GetService("ReplicatedStorage").Nexus.Logger)

local log = Logger.new("Framework")

export type Service = {
	Name: string,
	Init: ((self: any) -&gt; ())?,
	Start: ((self: any) -&gt; ())?,
	[any]: any,
}

local Framework = {}
local services: { [string]: Service } = {}
local started = false

--- Register a service table. Its `Name` must be unique.
function Framework.register(service: Service): Service
	assert(not started, "cannot register after Framework.start()")
	assert(service.Name, "service is missing a Name")
	assert(not services[service.Name], "duplicate service: " .. service.Name)
	services[service.Name] = service
	return service
end

--- Retrieve a previously registered service, asserting it exists.
function Framework.get(name: string): any
	local service = services[name]
	if not service then
		error(("service %q is not registered"):format(name), 2)
	end
	return service
end

--- Run Init on every service, then Start on every service. Idempotent-guarded.
function Framework.start()
	assert(not started, "Framework already started")
	started = true

	for name, service in services do
		if service.Init then
			local ok, err = pcall(service.Init, service)
			if not ok then
				log:Error(("Init failed for %s: %s"):format(name, tostring(err)))
			end
		end
	end
	log:Info("all services initialised")

	for name, service in services do
		if service.Start then
			-- Start in its own thread so a long-running loop cannot block the
			-- rest of startup; each service owns its cadence.
			task.spawn(function()
				local ok, err = pcall(service.Start, service)
				if not ok then
					log:Error(("Start failed for %s: %s"):format(name, tostring(err)))
				end
			end)
		end
	end
	log:Info("all services started")
end

return Framework
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000039"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">AIService</string><ProtectedString name="Source">--!strict
--[[
	Services/AIService.luau
	Server-owned AI nations that share the exact same Nation shape as players, so
	the leaderboard, diplomacy and territory systems treat them uniformly (no
	special-casing anywhere else). Each AI has a strategy profile that biases how
	it grows and what it trades for.

	AI economies are simulated with a lightweight aggregate growth model rather
	than the full grid builder — enough to make them living rivals on the
	leaderboard and credible trade/alliance partners, without a second economy
	engine to maintain.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local ResourceMath = require(ReplicatedStorage.Nexus.ResourceMath)
local Types = require(ReplicatedStorage.Nexus.Types)
local Regions = require(ReplicatedStorage.Nexus.Config.Regions)
local Technologies = require(ReplicatedStorage.Nexus.Config.Technologies)

local DiplomacyService = require(script.Parent.DiplomacyService)
local TerritoryService = require(script.Parent.TerritoryService)
local WorldService = require(script.Parent.WorldService)

local REGION_IDS = {}
for regionId in Regions do
	table.insert(REGION_IDS, regionId)
end

type Nation = Types.Nation

local log = Logger.new("AIService")

local AIService = {
	Name = "AIService",
}

AIService._nations = {} :: { [number]: Nation }
AIService._profiles = {} :: { [number]: any }
AIService._age = {} :: { [number]: number }

-- Strategy archetypes bias the growth weights.
type Profile = {
	label: string,
	gov: Types.GovernmentId,
	gdp: number,
	pop: number,
	research: number,
	diplo: number,
	military: number,
}

local ARCHETYPES: { [string]: Profile } = {
	economic = { label = "economic", gov = "republic", gdp = 1.25, pop = 1.1, research = 0.9, diplo = 1.0, military = 0.6 },
	technological = { label = "technological", gov = "technocracy", gdp = 1.0, pop = 0.95, research = 1.6, diplo = 0.9, military = 0.7 },
	diplomatic = { label = "diplomatic", gov = "democracy", gdp = 1.05, pop = 1.05, research = 1.0, diplo = 1.6, military = 0.5 },
	militarist = { label = "militarist", gov = "military", gdp = 0.95, pop = 1.0, research = 0.85, diplo = 0.7, military = 1.8 },
	balanced = { label = "balanced", gov = "monarchy", gdp = 1.1, pop = 1.05, research = 1.05, diplo = 1.05, military = 1.0 },
}

local ROSTER = {
	{ name = "Veltoria", profile = "economic" },
	{ name = "Auronia", profile = "technological" },
	{ name = "Solmara Union", profile = "diplomatic" },
	{ name = "Kravok Dominion", profile = "militarist" },
	{ name = "Cindral Republic", profile = "balanced" },
}

-- ---- Construction ---------------------------------------------------------

local function makeNation(id: number, name: string, profile: Profile): Nation
	local resources = ResourceMath.zero()
	resources.money = 30000
	resources.materials = 800
	resources.food = 600
	resources.influence = 60
	return {
		ownerId = id,
		name = name,
		founded = os.time(),
		resources = resources,
		buildings = {},
		population = {
			total = 60,
			employed = 40,
			happiness = 62,
			education = 30,
			health = 45,
			unrest = 5,
		},
		politics = {
			government = profile.gov,
			approval = 60,
			stability = 65,
			corruption = 8,
			taxRate = 0.2,
			activeLaws = {},
			nextElection = 0,
		},
		economy = {
			gdp = 800,
			gdpHistory = {},
			treasury = resources.money,
			debt = 0,
			inflation = 2,
			interestRate = 4,
			lastTickIncome = 0,
			lastTickExpense = 0,
		},
		research = { unlocked = {}, current = nil, progress = 0, points = 0 },
		military = { army = 0, navy = 0, air = 0 },
		diplomacy = { allies = {} },
		territory = { regions = {} },
		flags = { ai = true },
	}
end

-- ---- Growth simulation ----------------------------------------------------

local function availableTech(nation: Nation): string?
	local candidates = {}
	for id, def in Technologies do
		if not nation.research.unlocked[id] then
			local ok = true
			for _, req in def.requires do
				if not nation.research.unlocked[req] then
					ok = false
					break
				end
			end
			if ok then
				table.insert(candidates, id)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[math.random(1, #candidates)]
end

function AIService:_grow(id: number, nation: Nation, profile: Profile)
	self._age[id] += 1
	local age = self._age[id]

	-- Population drifts toward a slowly rising cap.
	local popCap = 60 + age * 6 * profile.pop
	nation.population.total = math.floor(nation.population.total + (popCap - nation.population.total) * 0.1 + 0.5)

	-- GDP scales with population and the economic bias, with mild noise.
	local gdp = nation.population.total * 12 * profile.gdp * (0.9 + math.random() * 0.2)
	nation.economy.gdp = gdp
	local income = gdp * nation.politics.taxRate * 0.85
	nation.resources.money += income
	nation.economy.treasury = nation.resources.money
	nation.economy.lastTickIncome = income

	-- Materials and food accumulate; surplus fuels trade.
	nation.resources.materials += 12 * profile.gdp
	nation.resources.food += 6
	nation.resources.influence += 2 * profile.diplo

	-- Research: accumulate and occasionally unlock an available technology.
	nation.resources.research += nation.population.total * 0.03 * profile.research
	if math.random() &lt; 0.05 * profile.research then
		local tech = availableTech(nation)
		if tech then
			nation.research.unlocked[tech] = true
		end
	end

	-- Militarists build a standing force out of their treasury.
	if math.random() &lt; 0.15 * profile.military and nation.resources.money &gt; 8000 then
		nation.resources.money -= 4000
		local branch = ({ "army", "navy", "air" })[math.random(1, 3)]
		nation.military[branch] += 1
	end

	-- Territory bonuses from owned regions, and the occasional expansion.
	for _, regionId in nation.territory.regions do
		local region = Regions[regionId]
		if region then
			ResourceMath.grant(nation.resources, region.bonus)
		end
	end
	if math.random() &lt; 0.08 and #REGION_IDS &gt; 0 then
		TerritoryService:ClaimForNation(id, REGION_IDS[math.random(1, #REGION_IDS)])
	end

	-- Gentle political drift keeps their stats lively.
	nation.politics.approval = math.clamp(nation.politics.approval + (math.random() - 0.5) * 4, 30, 95)
	nation.politics.stability = math.clamp(nation.politics.stability + (math.random() - 0.5) * 3, 25, 95)
end

-- ---- Diplomacy behaviour --------------------------------------------------

function AIService:_maybeTrade()
	local players = Players:GetPlayers()
	if #players == 0 then
		return
	end
	-- Pick a random AI and a random human target.
	local ids = {}
	for id in self._nations do
		table.insert(ids, id)
	end
	if #ids == 0 then
		return
	end
	local aiId = ids[math.random(1, #ids)]
	local nation = self._nations[aiId]
	local profile = self._profiles[aiId]
	local target = players[math.random(1, #players)]

	if math.random() &lt; 0.15 * profile.diplo then
		-- Offer an alliance instead of a trade.
		DiplomacyService:CreateOffer(aiId, target.UserId, "alliance", {}, {})
		return
	end

	-- Give a surplus resource, ask for something the profile values.
	local give: Types.ResourceBag = {}
	local receive: Types.ResourceBag = {}
	if nation.resources.money &gt; 12000 then
		give.money = 4000
	elseif nation.resources.materials &gt; 300 then
		give.materials = 150
	else
		return
	end
	if profile.research &gt; 1.1 then
		receive.research = 60
	elseif profile.military &gt; 1.1 then
		receive.materials = 120
	else
		receive.influence = 25
	end
	DiplomacyService:CreateOffer(aiId, target.UserId, "trade", give, receive)
end

-- ---- Lifecycle ------------------------------------------------------------

function AIService:GetNation(id: number): Nation?
	return self._nations[id]
end

function AIService:Start()
	for i, spec in ROSTER do
		local id = -i
		local profile = ARCHETYPES[spec.profile]
		local nation = makeNation(id, spec.name, profile)
		self._nations[id] = nation
		self._profiles[id] = profile
		self._age[id] = 0
		WorldService:RegisterAI(id, nation)
	end
	log:Info(("spawned %d AI nations"):format(#ROSTER))

	-- Growth loop.
	task.spawn(function()
		while true do
			task.wait(6)
			for id, nation in self._nations do
				pcall(function()
					self:_grow(id, nation, self._profiles[id])
				end)
			end
		end
	end)

	-- Occasional diplomacy toward human players.
	task.spawn(function()
		while true do
			task.wait(20)
			pcall(function()
				self:_maybeTrade()
			end)
		end
	end)
end

return AIService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">CitizenService</string><ProtectedString name="Source">--!strict
--[[
	Services/CitizenService.luau
	The populace as a living system. Each tick it moves education and health
	toward what the city's services can support, derives a happiness target from
	services, taxes, jobs, food and housing, and lets happiness drive migration.
	Unhappy, hungry or crowded nations shrink; prosperous ones attract residents.

	Population is what makes the economy turn (workers) and what politics answers
	to (voters), so this service is deliberately the hinge between the two.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Types = require(ReplicatedStorage.Nexus.Types)
local Balance = require(ReplicatedStorage.Nexus.Config.Balance)

type Nation = Types.Nation

local log = Logger.new("CitizenService")

local CitizenService = {
	Name = "CitizenService",
}

local function clamp(v: number, lo: number, hi: number): number
	return math.max(lo, math.min(hi, v))
end

-- Ease a value a fraction of the way toward a target (exponential smoothing).
local function drift(current: number, target: number, rate: number): number
	return current + (target - current) * rate
end

function CitizenService:Tick(nation: Nation, frame: any)
	local C = Balance.CITIZENS
	local stats = frame.stats
	local resolved = frame.resolved
	local pop = nation.population
	local total = math.max(pop.total, 1)

	-- Service coverage: points relative to population, capped at full quality.
	local eduTarget = clamp((stats.education / total) * 200, 0, 100)
	local healthTarget = clamp((stats.health / total) * 200 + resolved.baseHealthFlat, 0, 100)
	pop.education = clamp(drift(pop.education, eduTarget, C.serviceInfluence), 0, 100)
	pop.health = clamp(drift(pop.health, healthTarget, C.serviceInfluence), 0, 100)

	-- Happiness target: sum of every push and pull on public mood.
	local happiness = C.baseHappiness
	happiness += stats.happinessFromBuildings
	happiness += resolved.happinessFlat
	happiness += (pop.education - 50) * 0.1
	happiness += (pop.health - 50) * 0.1

	-- Taxes above a comfort threshold sour the public.
	local taxOver = math.max(0, nation.politics.taxRate - 0.2)
	happiness -= taxOver * 80

	-- Unemployment beyond tolerance hurts, but is capped so an empty new nation
	-- (no jobs yet) is a recoverable slump, not an instant collapse.
	if frame.unemployment &gt; C.unemploymentTolerance then
		happiness -= math.min(20, (frame.unemployment - C.unemploymentTolerance) * 50)
	end

	-- Hunger and overcrowding.
	if frame.foodShortage &gt; 0 then
		happiness -= math.min(30, frame.foodShortage * 0.5)
	end
	local capacity = stats.housing * C.housingMultiplier
	if total &gt; capacity and capacity &gt; 0 then
		happiness -= math.min(25, (total - capacity) / capacity * 40)
	end

	happiness -= pop.unrest * 0.2
	local happinessTarget = clamp(happiness, 0, 100)
	pop.happiness = clamp(drift(pop.happiness, happinessTarget, 0.25), 0, 100)

	-- Unrest rises with misery, hunger and corruption; falls otherwise.
	local unrestTarget = clamp(
		(50 - pop.happiness) * 0.8
			+ frame.foodShortage * Balance.ECONOMY.starvationUnrest
			+ (nation.politics.corruption - 20) * 0.3,
		0,
		100
	)
	pop.unrest = clamp(drift(pop.unrest, unrestTarget, 0.2), 0, 100)

	-- Migration: happy nations with spare housing grow; miserable ones shrink.
	local growth = 0
	if pop.happiness &gt;= C.migrationHappiness and total &lt; capacity then
		growth = (capacity - total) * C.growthRate * (pop.happiness / 100)
	elseif pop.happiness &lt; C.migrationHappiness then
		growth = -(total * C.growthRate * ((C.migrationHappiness - pop.happiness) / 100))
	elseif total &gt; capacity then
		growth = -((total - capacity) * C.growthRate)
	end

	-- Starvation causes outright decline on top of migration.
	if frame.foodShortage &gt; 0 then
		growth -= frame.foodShortage * 0.2
	end

	pop.total = math.max(5, math.floor(total + growth + 0.5))
end

function CitizenService:Init()
	log:Debug("citizen simulation ready")
end

return CitizenService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">CityService</string><ProtectedString name="Source">--!strict
--[[
	Services/CityService.luau
	The authoritative city builder. Owns every building a nation places and is
	the single source of the aggregate "city stats" (production, upkeep, power,
	jobs, housing, services) that the economy and citizen simulations consume.

	Security: all four mutations (place/upgrade/demolish/repair) are validated
	end to end on the server — kind exists, tech unlocked, footprint fits and
	does not overlap, resources actually affordable — before any state changes.
	The client's request is a suggestion; this service decides.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Nexus.Constants)
local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local ResourceMath = require(ReplicatedStorage.Nexus.ResourceMath)
local Types = require(ReplicatedStorage.Nexus.Types)
local Buildings = require(ReplicatedStorage.Nexus.Config.Buildings)
local Balance = require(ReplicatedStorage.Nexus.Config.Balance)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)
local Modifiers = require(script.Parent.Parent.Util.Modifiers)
local Validation = require(script.Parent.Parent.Util.Validation)

type Nation = Types.Nation
type Building = Types.Building
type BuildingDef = Types.BuildingDef
type ResourceBag = Types.ResourceBag
type Resolved = Modifiers.Resolved

export type CityStats = {
	production: ResourceBag,
	upkeep: ResourceBag,
	powerSupply: number,
	powerDraw: number,
	powerNet: number,
	jobs: number,
	housing: number,
	education: number,
	health: number,
	happinessFromBuildings: number,
	buildingCount: number,
}

local log = Logger.new("CityService")

local CityService = {
	Name = "CityService",
}

-- ---- Level scaling --------------------------------------------------------

local function prodFactor(level: number): number
	return 1 + 0.5 * (level - 1)
end
local function upkeepFactor(level: number): number
	return 1 + 0.4 * (level - 1)
end
local function jobsFactor(level: number): number
	return 1 + 0.5 * (level - 1)
end
local function housingFactor(level: number): number
	return 1 + 0.6 * (level - 1)
end

-- ---- Footprint / grid -----------------------------------------------------

local function orientedFootprint(def: BuildingDef, rotation: number): (number, number)
	if rotation == 90 or rotation == 270 then
		return def.footprint.h, def.footprint.w
	end
	return def.footprint.w, def.footprint.h
end

-- Returns the list of "x,z" tile keys a building would occupy, or nil if it
-- would fall outside the grid.
local function footprintTiles(pos: { x: number, z: number }, w: number, h: number): ({ string })?
	if pos.x + w &gt; Constants.GRID_SIZE or pos.z + h &gt; Constants.GRID_SIZE then
		return nil
	end
	local tiles = {}
	for dx = 0, w - 1 do
		for dz = 0, h - 1 do
			table.insert(tiles, (pos.x + dx) .. "," .. (pos.z + dz))
		end
	end
	return tiles
end

-- Build the set of occupied tiles for a nation, optionally ignoring one uid
-- (used when re-checking during an upgrade in place).
local function occupancy(nation: Nation, excludeId: string?): { [string]: boolean }
	local occupied = {}
	for id, building in nation.buildings do
		if id == excludeId then
			continue
		end
		local def = Buildings[building.kind]
		if not def then
			continue
		end
		local w, h = orientedFootprint(def, building.rotation)
		local tiles = footprintTiles(building.position, w, h)
		if tiles then
			for _, key in tiles do
				occupied[key] = true
			end
		end
	end
	return occupied
end

-- ---- Cost -----------------------------------------------------------------

-- Cost of a building at a given level, with the material-cost modifier applied.
local function effectiveCost(def: BuildingDef, level: number, resolved: Resolved): ResourceBag
	local base = def.cost[level]
	if not base then
		return {}
	end
	local out = table.clone(base)
	if out.materials then
		out.materials = math.max(0, math.floor(out.materials * resolved.materialCostMult + 0.5))
	end
	return out
end

-- ---- Aggregate stats ------------------------------------------------------

--- Recompute the entire city's contribution to the simulation. Called every
--- economy tick and never trusts stored derived values.
function CityService:ComputeStats(nation: Nation, resolved: Resolved): CityStats
	local stats: CityStats = {
		production = ResourceMath.zero(),
		upkeep = ResourceMath.zero(),
		powerSupply = 0,
		powerDraw = 0,
		powerNet = 0,
		jobs = 0,
		housing = 0,
		education = 0,
		health = 0,
		happinessFromBuildings = 0,
		buildingCount = 0,
	}
	local offline = Balance.CONSTRUCTION.offlineCondition

	-- First pass: total power. A plant contributes if its condition is healthy.
	for _, b in nation.buildings do
		local def = Buildings[b.kind]
		if not def or b.condition &lt; offline then
			continue
		end
		stats.powerSupply += def.powerSupply * prodFactor(b.level) * resolved.powerSupplyMult
		stats.powerDraw += def.powerDraw * prodFactor(b.level)
	end
	stats.powerNet = stats.powerSupply - stats.powerDraw
	local powerRatio = 1.0
	if stats.powerDraw &gt; stats.powerSupply and stats.powerDraw &gt; 0 then
		powerRatio = stats.powerSupply / stats.powerDraw
	end

	-- Second pass: production, upkeep, jobs, services.
	for _, b in nation.buildings do
		local def = Buildings[b.kind]
		if not def then
			continue
		end
		stats.buildingCount += 1
		local healthy = b.condition &gt;= offline
		b.active = healthy
		if not healthy then
			-- A derelict building still bleeds a little upkeep but produces nothing.
			continue
		end
		-- Power-consuming producers are throttled by the supply ratio.
		local eff = def.powerDraw &gt; 0 and powerRatio or 1.0

		for resource, amount in def.produces do
			local value = amount * prodFactor(b.level) * eff
			if resource == "food" then
				value *= resolved.foodProductionMult
			elseif resource == "influence" then
				value *= resolved.influenceBonusMult
			end
			stats.production[resource :: any] += value
		end

		for resource, amount in def.upkeep do
			stats.upkeep[resource :: any] += amount * upkeepFactor(b.level) * resolved.upkeepMult
		end

		local jobFactor = jobsFactor(b.level)
		if def.category == "Industry" then
			jobFactor *= resolved.industryJobsMult
		end
		stats.jobs += def.jobs * jobFactor

		stats.housing += (def.housing or 0) * housingFactor(b.level)
		stats.education += (def.education or 0) * prodFactor(b.level) * eff
		stats.health += (def.health or 0) * prodFactor(b.level) * eff
		stats.happinessFromBuildings += def.happiness
	end

	return stats
end

--- Age every building. When the treasury covered maintenance, buildings slowly
--- recover; otherwise they decay and eventually go offline.
function CityService:TickCondition(nation: Nation, maintained: boolean)
	local decay = Balance.CONSTRUCTION.decayPerTick
	for _, b in nation.buildings do
		if maintained then
			b.condition = math.min(1, b.condition + decay * 0.5)
		else
			b.condition = math.max(0, b.condition - decay * 3)
		end
	end
end

-- ---- Mutations ------------------------------------------------------------

local uidCounter = 0
local function newUid(): string
	uidCounter += 1
	return ("b%d_%d"):format(os.time() % 100000, uidCounter)
end

function CityService:_place(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation then
		return { success = false, reason = "no_nation" }
	end
	if typeof(payload) ~= "table" then
		return { success = false, reason = "bad_payload" }
	end

	local def = Buildings[payload.kind]
	if not def then
		return { success = false, reason = "unknown_building" }
	end
	if def.requiresTech and not nation.research.unlocked[def.requiresTech] then
		return { success = false, reason = "tech_locked" }
	end
	local pos = Validation.readPosition(payload)
	if not pos then
		return { success = false, reason = "bad_position" }
	end
	local rotation = payload.rotation
	if not Validation.isRotation(rotation) then
		rotation = 0
	end

	local w, h = orientedFootprint(def, rotation)
	local tiles = footprintTiles(pos, w, h)
	if not tiles then
		return { success = false, reason = "out_of_bounds" }
	end
	local occupied = occupancy(nation)
	for _, key in tiles do
		if occupied[key] then
			return { success = false, reason = "overlap" }
		end
	end

	local resolved = Modifiers.resolve(nation)
	local cost = effectiveCost(def, 1, resolved)
	if not ResourceMath.canAfford(nation.resources, cost) then
		NotificationService:Send(player, "warning", "Cannot afford " .. def.displayName)
		return { success = false, reason = "insufficient_resources" }
	end

	ResourceMath.spend(nation.resources, cost)
	local id = newUid()
	nation.buildings[id] = {
		id = id,
		kind = def.kind,
		level = 1,
		position = pos,
		rotation = rotation,
		condition = 1,
		builtAt = os.time(),
		active = true,
	}

	ReplicationService:MarkDirty(player)
	NotificationService:Send(player, "success", def.displayName .. " built")
	return { success = true, id = id }
end

function CityService:_upgrade(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local building = nation.buildings[payload.id]
	if not building then
		return { success = false, reason = "not_found" }
	end
	local def = Buildings[building.kind]
	if not def then
		return { success = false, reason = "unknown_building" }
	end
	local cap = math.min(def.maxLevel, Balance.CONSTRUCTION.maxLevel)
	if building.level &gt;= cap then
		return { success = false, reason = "max_level" }
	end

	local resolved = Modifiers.resolve(nation)
	local cost = effectiveCost(def, building.level + 1, resolved)
	if not ResourceMath.canAfford(nation.resources, cost) then
		NotificationService:Send(player, "warning", "Cannot afford upgrade")
		return { success = false, reason = "insufficient_resources" }
	end

	ResourceMath.spend(nation.resources, cost)
	building.level += 1
	building.condition = 1
	ReplicationService:MarkDirty(player)
	NotificationService:Send(player, "success", def.displayName .. " upgraded to level " .. building.level)
	return { success = true, level = building.level }
end

function CityService:_demolish(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local building = nation.buildings[payload.id]
	if not building then
		return { success = false, reason = "not_found" }
	end
	local def = Buildings[building.kind]
	if def then
		local resolved = Modifiers.resolve(nation)
		local refund = ResourceMath.scale(
			effectiveCost(def, building.level, resolved),
			Balance.CONSTRUCTION.demolishRefund
		)
		ResourceMath.grant(nation.resources, refund)
	end
	nation.buildings[payload.id] = nil
	ReplicationService:MarkDirty(player)
	NotificationService:Send(player, "info", "Building demolished")
	return { success = true }
end

function CityService:_repair(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local building = nation.buildings[payload.id]
	if not building then
		return { success = false, reason = "not_found" }
	end
	local def = Buildings[building.kind]
	if not def then
		return { success = false, reason = "unknown_building" }
	end
	if building.condition &gt;= 0.99 then
		return { success = false, reason = "already_good" }
	end

	local resolved = Modifiers.resolve(nation)
	-- Repair costs a fifth of the current level's build cost, scaled by damage.
	local damage = 1 - building.condition
	local cost = ResourceMath.scale(effectiveCost(def, building.level, resolved), 0.2 * damage)
	if not ResourceMath.canAfford(nation.resources, cost) then
		return { success = false, reason = "insufficient_resources" }
	end
	ResourceMath.spend(nation.resources, cost)
	building.condition = 1
	ReplicationService:MarkDirty(player)
	return { success = true }
end

function CityService:Start()
	Net.handleRequest(NetRoutes.PLACE_BUILDING, function(player, payload)
		return self:_place(player, payload)
	end, { rate = 10, per = 1 })

	Net.handleRequest(NetRoutes.UPGRADE_BUILDING, function(player, payload)
		return self:_upgrade(player, payload)
	end, { rate = 10, per = 1 })

	Net.handleRequest(NetRoutes.DEMOLISH_BUILDING, function(player, payload)
		return self:_demolish(player, payload)
	end, { rate = 10, per = 1 })

	Net.handleRequest(NetRoutes.REPAIR_BUILDING, function(player, payload)
		return self:_repair(player, payload)
	end, { rate = 10, per = 1 })

	log:Info("construction handlers ready")
end

return CityService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">DataService</string><ProtectedString name="Source">--!strict
--[[
	Services/DataService.luau
	Original, session-safe persistence for player profiles.

	Design goals (all implemented here, no external dependency):
	  * Session locking  — one live server owns a profile at a time, so a player
	    hopping servers can never fork or roll back their own save.
	  * Reconciliation   — an old save is merged against the current default
	    template, so new fields appear without wiping player progress.
	  * Migration        — schemaVersion drives ordered upgrade steps.
	  * Retry + backoff  — every DataStore op is retried with exponential backoff.
	  * Backups          — the last-known-good record is mirrored to a second
	    store before each risky write.
	  * Autosave         — periodic saves plus a BindToClose flush on shutdown.
	  * Studio fallback   — if the DataStore API is unreachable (API access off),
	    an in-memory mock keeps the whole game playable for testing.

	Other services never call DataStores; they read and mutate `profile.nation`
	and rely on this service to persist it.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Nexus.Constants)
local Logger = require(ReplicatedStorage.Nexus.Logger)
local Signal = require(ReplicatedStorage.Nexus.Signal)
local TableUtil = require(ReplicatedStorage.Nexus.TableUtil)
local Types = require(ReplicatedStorage.Nexus.Types)
local Balance = require(ReplicatedStorage.Nexus.Config.Balance)

type Profile = Types.Profile
type Nation = Types.Nation

-- A stored record wraps the profile with an ownership lock.
type SessionLock = { jobId: string, placeId: number, time: number }
type Record = { profile: Profile?, lock: SessionLock? }

local log = Logger.new("DataService")

-- ---------------------------------------------------------------------------
-- Store abstraction: real DataStore or in-memory mock (Studio without API).
-- ---------------------------------------------------------------------------

type StoreLike = {
	UpdateAsync: (self: any, key: string, transform: (any) -&gt; any) -&gt; any,
	GetAsync: (self: any, key: string) -&gt; any,
	SetAsync: (self: any, key: string, value: any) -&gt; (),
}

local MockStore = {}
MockStore.__index = MockStore
function MockStore.new(): StoreLike
	return (setmetatable({ _data = {} }, MockStore) :: any) :: StoreLike
end
function MockStore:UpdateAsync(key: string, transform: (any) -&gt; any): any
	local current = self._data[key]
	local updated = transform(current)
	if updated ~= nil then
		self._data[key] = TableUtil.deepCopy(updated)
	end
	return updated
end
function MockStore:GetAsync(key: string): any
	return TableUtil.deepCopy(self._data[key])
end
function MockStore:SetAsync(key: string, value: any)
	self._data[key] = TableUtil.deepCopy(value)
end

-- ---------------------------------------------------------------------------
-- Service
-- ---------------------------------------------------------------------------

local DataService = {
	Name = "DataService",
	Loaded = Signal.new() :: any, -- fires (player, profile)
	Released = Signal.new() :: any, -- fires (player)
}

DataService._profiles = {} :: { [number]: Profile }
DataService._loading = {} :: { [number]: boolean }
DataService._store = nil :: StoreLike?
DataService._backupStore = nil :: StoreLike?
DataService._useMock = false

-- Migration steps: index N upgrades a vN profile to v(N+1) in place.
local MIGRATIONS: { [number]: (Profile) -&gt; () } = {
	-- [1] = function(profile) ... end,  -- add when schema bumps to v2
}

-- ---- Default profile ------------------------------------------------------

local function defaultNation(player: Player): Nation
	local start = Balance.START
	return {
		ownerId = player.UserId,
		name = player.DisplayName .. "'s Nation",
		founded = os.time(),
		resources = TableUtil.deepCopy(start.resources),
		buildings = {},
		population = {
			total = start.population,
			employed = 0,
			happiness = 60,
			education = 20,
			health = 40,
			unrest = 0,
		},
		politics = {
			government = "democracy",
			approval = 60,
			stability = 60,
			corruption = 5,
			taxRate = start.taxRate,
			activeLaws = {},
			nextElection = 0,
		},
		economy = {
			gdp = 0,
			gdpHistory = {},
			treasury = start.treasury,
			debt = 0,
			inflation = 2.0,
			interestRate = 4.0,
			lastTickIncome = 0,
			lastTickExpense = 0,
		},
		research = {
			unlocked = {},
			current = nil,
			progress = 0,
			points = 0,
		},
		military = { army = 0, navy = 0, air = 0 },
		diplomacy = { allies = {} },
		territory = { regions = { "capital" } },
		flags = {},
	}
end

local function defaultProfile(player: Player): Profile
	return {
		schemaVersion = Constants.PROFILE_SCHEMA_VERSION,
		createdAt = os.time(),
		lastPlayed = os.time(),
		playtime = 0,
		nation = defaultNation(player),
	}
end

-- ---- DataStore helpers with retry + backoff -------------------------------

local function keyFor(userId: number): string
	return "player_" .. userId
end

local function sameSession(lock: SessionLock?): boolean
	return lock ~= nil and lock.jobId == game.JobId and lock.placeId == game.PlaceId
end

local function lockIsStale(lock: SessionLock): boolean
	return (os.time() - lock.time) &gt; Constants.SESSION_LOCK_STALE_AFTER
end

-- Retry any DataStore call with exponential backoff. Returns ok, result.
local function retry&lt;T&gt;(label: string, fn: () -&gt; T): (boolean, T?)
	local delayTime = 1
	for attempt = 1, Constants.DATASTORE_MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		log:Warn(("%s attempt %d failed: %s"):format(label, attempt, tostring(result)))
		if attempt &lt; Constants.DATASTORE_MAX_RETRIES then
			task.wait(delayTime)
			delayTime = math.min(delayTime * 2, 16)
		end
	end
	return false, nil
end

function DataService:Init()
	if RunService:IsStudio() then
		-- Probe the DataStore API; fall back to an in-memory mock if it is off.
		local probe = DataStoreService:GetDataStore(Constants.DATASTORE_NAME)
		local ok = pcall(function()
			-- Returning nil cancels the write, so this only exercises the API.
			probe:UpdateAsync("__probe__", function()
				return nil
			end)
		end)
		if not ok then
			self._useMock = true
			log:Warn("DataStore API unavailable — using in-memory mock (Studio only)")
		end
	end

	if self._useMock then
		self._store = MockStore.new()
		self._backupStore = MockStore.new()
	else
		self._store = DataStoreService:GetDataStore(Constants.DATASTORE_NAME)
		self._backupStore = DataStoreService:GetDataStore(Constants.DATASTORE_BACKUP_NAME)
	end
end

-- ---- Load -----------------------------------------------------------------

function DataService:_migrate(profile: Profile)
	while profile.schemaVersion &lt; Constants.PROFILE_SCHEMA_VERSION do
		local step = MIGRATIONS[profile.schemaVersion]
		if step then
			step(profile)
		end
		profile.schemaVersion += 1
	end
end

function DataService:_loadAsync(player: Player): Profile?
	local key = keyFor(player.UserId)
	local store = assert(self._store, "store not initialised")

	-- Acquire the session lock. If another live session holds a fresh lock, we
	-- back off and retry; a stale lock is reclaimed.
	local acquired: Record? = nil
	for attempt = 1, Constants.DATASTORE_MAX_RETRIES do
		local ok, record = retry("load:" .. key, function(): Record
			return store:UpdateAsync(key, function(old: Record?): Record?
				local rec: Record = old or { profile = nil, lock = nil }
				local lock = rec.lock
				if lock and not sameSession(lock) and not lockIsStale(lock) then
					-- Owned elsewhere and fresh: abort this write, retry later.
					return nil
				end
				rec.lock = { jobId = game.JobId, placeId = game.PlaceId, time = os.time() }
				return rec
			end)
		end)

		if ok and record and sameSession(record.lock) then
			acquired = record
			break
		end
		log:Warn(("profile %s locked elsewhere, retry %d"):format(key, attempt))
		task.wait(2 ^ attempt)
	end

	if not acquired then
		return nil
	end

	local profile = acquired.profile
	if not profile then
		profile = defaultProfile(player)
	else
		-- Bring an older save up to the current shape and schema.
		self:_migrate(profile)
		TableUtil.reconcile(profile, defaultProfile(player))
		-- Reconcile the nested nation too, so new nation fields get defaults.
		TableUtil.reconcile(profile.nation, defaultNation(player))
	end
	profile.lastPlayed = os.time()
	return profile
end

function DataService:LoadPlayer(player: Player)
	if self._loading[player.UserId] or self._profiles[player.UserId] then
		return
	end
	self._loading[player.UserId] = true

	local profile = self:_loadAsync(player)
	self._loading[player.UserId] = nil

	if not player.Parent then
		-- Player left mid-load; release the lock we may have taken.
		if profile then
			self:_saveAsync(player.UserId, profile, true)
		end
		return
	end

	if not profile then
		log:Error(("could not load profile for %s; kicking to protect data"):format(player.Name))
		player:Kick("Your save is in use on another server. Please rejoin in a moment.")
		return
	end

	self._profiles[player.UserId] = profile
	log:Info(("loaded profile for %s (v%d)"):format(player.Name, profile.schemaVersion))
	self.Loaded:Fire(player, profile)
end

-- ---- Save -----------------------------------------------------------------

function DataService:_saveAsync(userId: number, profile: Profile, releaseLock: boolean): boolean
	local key = keyFor(userId)
	local store = assert(self._store, "store not initialised")

	-- Snapshot the profile so a concurrent simulation tick cannot mutate the
	-- table while the DataStore is serialising it.
	local snapshot = TableUtil.deepCopy(profile)

	-- Mirror the last-good profile to the backup store first (best effort).
	retry("backup:" .. key, function()
		(assert(self._backupStore) :: any):SetAsync(key, { profile = snapshot, savedAt = os.time() })
	end)

	local ok = retry("save:" .. key, function()
		store:UpdateAsync(key, function(old: Record?): Record?
			local rec: Record = old or {}
			local lock = rec.lock
			-- Refuse to clobber a save owned by a different, still-live session.
			if lock and not sameSession(lock) and not lockIsStale(lock) then
				return nil
			end
			rec.profile = snapshot
			if releaseLock then
				rec.lock = nil
			else
				rec.lock = { jobId = game.JobId, placeId = game.PlaceId, time = os.time() }
			end
			return rec
		end)
	end)
	return ok == true
end

function DataService:SaveNow(player: Player): boolean
	local profile = self._profiles[player.UserId]
	if not profile then
		return false
	end
	return self:_saveAsync(player.UserId, profile, false)
end

function DataService:ReleasePlayer(player: Player)
	local profile = self._profiles[player.UserId]
	if not profile then
		return
	end
	self._profiles[player.UserId] = nil
	self:_saveAsync(player.UserId, profile, true)
	log:Info(("released profile for %s"):format(player.Name))
	self.Released:Fire(player)
end

-- ---- Accessors ------------------------------------------------------------

function DataService:GetProfile(player: Player): Profile?
	return self._profiles[player.UserId]
end

function DataService:GetNation(player: Player): Nation?
	local profile = self._profiles[player.UserId]
	return profile and profile.nation or nil
end

--- Iterate every loaded (player, nation) pair. Used by simulation ticks.
function DataService:ForEachNation(fn: (player: Player, nation: Nation) -&gt; ())
	for _, player in Players:GetPlayers() do
		local nation = self:GetNation(player)
		if nation then
			fn(player, nation)
		end
	end
end

-- ---- Lifecycle ------------------------------------------------------------

function DataService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:LoadPlayer(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			self:LoadPlayer(player)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		self:ReleasePlayer(player)
	end)

	-- Autosave loop.
	task.spawn(function()
		while true do
			task.wait(Constants.AUTOSAVE_INTERVAL)
			for userId, profile in self._profiles do
				profile.playtime += Constants.AUTOSAVE_INTERVAL
				self:_saveAsync(userId, profile, false)
			end
		end
	end)

	-- Flush everything on shutdown.
	game:BindToClose(function()
		if self._useMock then
			return
		end
		for userId, profile in self._profiles do
			task.spawn(function()
				self:_saveAsync(userId, profile, true)
			end)
		end
		task.wait(3)
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">DiplomacyService</string><ProtectedString name="Source">--!strict
--[[
	Services/DiplomacyService.luau
	Player-to-player (and player-to-AI) diplomacy: escrowed resource trades and
	alliances.

	Trades are safe by construction: the moment an offer is made, the proposer's
	`give` is withdrawn into escrow, so it cannot be double-spent or duplicated. A
	trade only completes if the recipient can actually afford `receive`; declines,
	cancels and expiries refund the escrow. Alliances are mutual and lift both
	sides' influence generation (see Util/Modifiers).

	AI-targeted offers are auto-resolved here on a timer using a simple resource
	valuation, so AIService stays focused on running its economies.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Nexus.Constants)
local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local ResourceMath = require(ReplicatedStorage.Nexus.ResourceMath)
local Types = require(ReplicatedStorage.Nexus.Types)

local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)
local WorldService = require(script.Parent.WorldService)

type Nation = Types.Nation
type ResourceBag = Types.ResourceBag

type Offer = {
	id: string,
	kind: string, -- "trade" | "alliance"
	fromId: number,
	toId: number,
	give: ResourceBag, -- escrowed from proposer (trade only)
	receive: ResourceBag, -- demanded from recipient (trade only)
	createdAt: number,
	expiresAt: number,
}

local log = Logger.new("DiplomacyService")

-- Rough barter values used only for AI trade judgement.
local RESOURCE_VALUE: { [string]: number } = {
	money = 1,
	materials = 8,
	energy = 4,
	food = 3,
	research = 15,
	influence = 12,
}

local OFFER_TTL = 120
local MAX_TRADE_AMOUNT = 10_000_000

local DiplomacyService = {
	Name = "DiplomacyService",
}

DiplomacyService._offers = {} :: { [string]: Offer }
DiplomacyService._counter = 0

-- ---- Helpers --------------------------------------------------------------

local VALID_RESOURCE: { [string]: boolean } = {}
for _, id in Constants.RESOURCE_ORDER do
	VALID_RESOURCE[id] = true
end

-- Sanitise a client-supplied resource bag: valid ids, non-negative integers,
-- capped. Returns the cleaned bag and whether it held anything.
local function sanitizeBag(payload: any): (ResourceBag, boolean)
	local out: ResourceBag = {}
	local any = false
	if typeof(payload) == "table" then
		for key, value in payload do
			if VALID_RESOURCE[key] and typeof(value) == "number" and value == value then
				local amount = math.floor(math.clamp(value, 0, MAX_TRADE_AMOUNT))
				if amount &gt; 0 then
					out[key :: any] = amount
					any = true
				end
			end
		end
	end
	return out, any
end

local function valueOf(bag: ResourceBag): number
	local total = 0
	for resource, amount in bag do
		total += amount * (RESOURCE_VALUE[resource] or 1)
	end
	return total
end

local function nextId(self): string
	self._counter += 1
	return "offer_" .. self._counter
end

local function markDirty(player: Player?)
	if player then
		ReplicationService:MarkDirty(player)
	end
end

-- ---- Inbox replication ----------------------------------------------------

local function serialize(offer: Offer): any
	local fromNation = select(1, WorldService:GetNationById(offer.fromId))
	local toNation = select(1, WorldService:GetNationById(offer.toId))
	return {
		id = offer.id,
		kind = offer.kind,
		fromId = offer.fromId,
		toId = offer.toId,
		fromName = fromNation and fromNation.name or "Unknown",
		toName = toNation and toNation.name or "Unknown",
		give = offer.give,
		receive = offer.receive,
		expiresAt = offer.expiresAt,
	}
end

function DiplomacyService:_pushInbox(playerId: number)
	if playerId &lt;= 0 then
		return
	end
	local player = Players:GetPlayerByUserId(playerId)
	if not player then
		return
	end
	local incoming, outgoing = {}, {}
	for _, offer in self._offers do
		if offer.toId == playerId then
			table.insert(incoming, serialize(offer))
		elseif offer.fromId == playerId then
			table.insert(outgoing, serialize(offer))
		end
	end
	Net.fireClient(player, NetRoutes.TRADE_INBOX, { incoming = incoming, outgoing = outgoing })
end

function DiplomacyService:_pushBoth(offer: Offer)
	self:_pushInbox(offer.fromId)
	self:_pushInbox(offer.toId)
end

-- ---- Core offer lifecycle -------------------------------------------------

--- Create an offer. Escrows `give` for trades. Returns (offer?, reason?).
function DiplomacyService:CreateOffer(
	fromId: number,
	toId: number,
	kind: string,
	give: ResourceBag,
	receive: ResourceBag
): (Offer?, string?)
	if fromId == toId then
		return nil, "self"
	end
	local fromNation, fromPlayer = WorldService:GetNationById(fromId)
	local toNation = WorldService:GetNationById(toId)
	if not fromNation or not toNation then
		return nil, "no_nation"
	end

	if kind == "alliance" then
		if fromNation.diplomacy.allies[tostring(toId)] then
			return nil, "already_allied"
		end
	else
		if not ResourceMath.canAfford(fromNation.resources, give) then
			return nil, "cannot_afford"
		end
		-- Escrow the offered resources immediately.
		ResourceMath.spend(fromNation.resources, give)
		markDirty(fromPlayer)
	end

	local offer: Offer = {
		id = nextId(self),
		kind = kind,
		fromId = fromId,
		toId = toId,
		give = give,
		receive = receive,
		createdAt = os.time(),
		expiresAt = os.time() + OFFER_TTL,
	}
	self._offers[offer.id] = offer
	self:_pushBoth(offer)
	return offer, nil
end

function DiplomacyService:_refund(offer: Offer)
	if offer.kind == "trade" then
		local fromNation, fromPlayer = WorldService:GetNationById(offer.fromId)
		if fromNation then
			ResourceMath.grant(fromNation.resources, offer.give)
			markDirty(fromPlayer)
		end
	end
end

function DiplomacyService:_settle(offer: Offer): boolean
	local fromNation, fromPlayer = WorldService:GetNationById(offer.fromId)
	local toNation, toPlayer = WorldService:GetNationById(offer.toId)
	if not fromNation or not toNation then
		self:_refund(offer)
		return false
	end

	if offer.kind == "alliance" then
		fromNation.diplomacy.allies[tostring(offer.toId)] = true
		toNation.diplomacy.allies[tostring(offer.fromId)] = true
		if fromPlayer then
			NotificationService:Send(fromPlayer, "success", "Alliance formed", "You are now allied with " .. toNation.name)
		end
		if toPlayer then
			NotificationService:Send(toPlayer, "success", "Alliance formed", "You are now allied with " .. fromNation.name)
		end
	else
		-- Recipient must afford the demanded resources.
		if not ResourceMath.canAfford(toNation.resources, offer.receive) then
			self:_refund(offer)
			if fromPlayer then
				NotificationService:Send(fromPlayer, "warning", "Trade fell through", toNation.name .. " could not pay.")
			end
			return false
		end
		ResourceMath.spend(toNation.resources, offer.receive)
		ResourceMath.grant(toNation.resources, offer.give) -- escrowed goods delivered
		ResourceMath.grant(fromNation.resources, offer.receive)
		if fromPlayer then
			NotificationService:Send(fromPlayer, "success", "Trade accepted", toNation.name .. " accepted your offer.")
		end
		if toPlayer then
			NotificationService:Send(toPlayer, "success", "Trade complete", "Traded with " .. fromNation.name)
		end
	end

	markDirty(fromPlayer)
	markDirty(toPlayer)
	return true
end

function DiplomacyService:_remove(offer: Offer)
	self._offers[offer.id] = nil
	self:_pushBoth(offer)
end

-- ---- Player request handlers ----------------------------------------------

function DiplomacyService:_onPropose(player: Player, payload: any): any
	if typeof(payload) ~= "table" or typeof(payload.toId) ~= "number" then
		return { success = false, reason = "bad_request" }
	end
	local give, giveAny = sanitizeBag(payload.give)
	local receive = select(1, sanitizeBag(payload.receive))
	if not giveAny then
		return { success = false, reason = "empty_offer" }
	end
	local offer, reason = self:CreateOffer(player.UserId, payload.toId, "trade", give, receive)
	if not offer then
		return { success = false, reason = reason }
	end
	NotificationService:Send(player, "info", "Trade offer sent")
	return { success = true, id = offer.id }
end

function DiplomacyService:_onRespond(player: Player, payload: any): any
	if typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local offer = self._offers[payload.id]
	if not offer then
		return { success = false, reason = "not_found" }
	end
	if offer.toId ~= player.UserId then
		return { success = false, reason = "not_yours" }
	end
	if payload.accept then
		self:_settle(offer)
	else
		self:_refund(offer)
		local _, fromPlayer = WorldService:GetNationById(offer.fromId)
		if fromPlayer then
			NotificationService:Send(fromPlayer, "info", "Offer declined")
		end
	end
	self:_remove(offer)
	return { success = true }
end

function DiplomacyService:_onCancel(player: Player, payload: any): any
	if typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local offer = self._offers[payload.id]
	if not offer or offer.fromId ~= player.UserId then
		return { success = false, reason = "not_found" }
	end
	self:_refund(offer)
	self:_remove(offer)
	return { success = true }
end

function DiplomacyService:_onAlliance(player: Player, payload: any): any
	if typeof(payload) ~= "table" or typeof(payload.toId) ~= "number" then
		return { success = false, reason = "bad_request" }
	end
	local offer, reason = self:CreateOffer(player.UserId, payload.toId, "alliance", {}, {})
	if not offer then
		return { success = false, reason = reason }
	end
	NotificationService:Send(player, "info", "Alliance proposed")
	return { success = true, id = offer.id }
end

function DiplomacyService:_onBreakAlliance(player: Player, payload: any): any
	local nation = select(1, WorldService:GetNationById(player.UserId))
	if not nation or typeof(payload) ~= "table" or typeof(payload.otherId) ~= "number" then
		return { success = false, reason = "bad_request" }
	end
	nation.diplomacy.allies[tostring(payload.otherId)] = nil
	local otherNation, otherPlayer = WorldService:GetNationById(payload.otherId)
	if otherNation then
		otherNation.diplomacy.allies[tostring(player.UserId)] = nil
		markDirty(otherPlayer)
	end
	markDirty(player)
	return { success = true }
end

-- ---- AI + housekeeping ----------------------------------------------------

-- Decide an AI's response to an offer targeting it.
function DiplomacyService:_resolveAIOffer(offer: Offer)
	local nation = select(1, WorldService:GetNationById(offer.toId))
	if not nation then
		self:_refund(offer)
		self:_remove(offer)
		return
	end
	local accept = false
	if offer.kind == "alliance" then
		local allies = 0
		for _, a in nation.diplomacy.allies do
			if a then
				allies += 1
			end
		end
		accept = allies &lt; 3 and math.random() &lt; 0.6
	else
		local receivedValue = valueOf(offer.give)
		local givenValue = valueOf(offer.receive)
		accept = ResourceMath.canAfford(nation.resources, offer.receive)
			and receivedValue &gt;= givenValue * 0.9
	end
	if accept then
		self:_settle(offer)
	else
		self:_refund(offer)
	end
	self:_remove(offer)
end

function DiplomacyService:Start()
	Net.handleRequest(NetRoutes.PROPOSE_TRADE, function(player, payload)
		return self:_onPropose(player, payload)
	end, { rate = 5, per = 1 })
	Net.handleRequest(NetRoutes.RESPOND_TRADE, function(player, payload)
		return self:_onRespond(player, payload)
	end, { rate = 10, per = 1 })
	Net.handleRequest(NetRoutes.CANCEL_TRADE, function(player, payload)
		return self:_onCancel(player, payload)
	end, { rate = 10, per = 1 })
	Net.handleRequest(NetRoutes.PROPOSE_ALLIANCE, function(player, payload)
		return self:_onAlliance(player, payload)
	end, { rate = 5, per = 1 })
	Net.handleRequest(NetRoutes.BREAK_ALLIANCE, function(player, payload)
		return self:_onBreakAlliance(player, payload)
	end, { rate = 5, per = 1 })

	DataService.Loaded:Connect(function(player: Player)
		self:_pushInbox(player.UserId)
	end)

	-- Housekeeping: expire stale offers and auto-resolve AI-targeted ones.
	task.spawn(function()
		while true do
			task.wait(3)
			local now = os.time()
			for _, offer in table.clone(self._offers) do
				if not self._offers[offer.id] then
					continue
				end
				if offer.toId &lt; 0 then
					self:_resolveAIOffer(offer)
				elseif now &gt;= offer.expiresAt then
					self:_refund(offer)
					self:_remove(offer)
				end
			end
		end
	end)

	log:Info("diplomacy handlers ready")
end

return DiplomacyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">--!strict
--[[
	Services/EconomyService.luau
	The master simulation tick. Every ECONOMY_TICK it walks each live nation and,
	in a fixed order, resolves modifiers, aggregates the city, computes finance,
	moves resources, and hands a shared "frame" of derived numbers to the citizen
	and research simulations. Politics runs on its own slower cadence.

	All money is authoritative here. `nation.resources.money` is the single
	treasury; deficits become debt (money never goes negative), surpluses slowly
	repay debt. Everything the HUD shows as a flow is packaged into `frame` and
	handed to ReplicationService.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Nexus.Constants)
local Logger = require(ReplicatedStorage.Nexus.Logger)
local ResourceMath = require(ReplicatedStorage.Nexus.ResourceMath)
local Types = require(ReplicatedStorage.Nexus.Types)
local Balance = require(ReplicatedStorage.Nexus.Config.Balance)
local Regions = require(ReplicatedStorage.Nexus.Config.Regions)
local MilitaryUnits = require(ReplicatedStorage.Nexus.Config.MilitaryUnits)

local CityService = require(script.Parent.CityService)
local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)
local Modifiers = require(script.Parent.Parent.Util.Modifiers)

type Nation = Types.Nation

local log = Logger.new("EconomyService")

local EconomyService = {
	Name = "EconomyService",
}

local function clamp(v: number, lo: number, hi: number): number
	return math.max(lo, math.min(hi, v))
end

-- Corruption erodes tax efficiency, but never below half.
local function corruptionFactor(corruption: number): number
	return clamp(1 - corruption / 200, 0.5, 1)
end

--- Run one economic tick for a single nation. Returns the derived `frame` so
--- other simulations (and replication) can reuse the same numbers.
function EconomyService:Tick(nation: Nation): any
	local eco = Balance.ECONOMY
	local resolved = Modifiers.resolve(nation)
	local stats = CityService:ComputeStats(nation, resolved)

	-- Employment: a fraction of the population is working-age.
	local workforce = math.floor(nation.population.total * Balance.CITIZENS.participation)
	local employed = math.min(math.floor(stats.jobs), workforce)
	nation.population.employed = employed
	local unemployment = workforce &gt; 0 and (workforce - employed) / workforce or 0

	-- GDP and taxation. Labour income is taxed; state enterprises pay directly.
	local laborGdp = employed * eco.gdpPerWorker
	local enterpriseIncome = stats.production.money
	local gdp = laborGdp + enterpriseIncome
	local taxRevenue = laborGdp
		* nation.politics.taxRate
		* resolved.taxEfficiencyMult
		* eco.taxEfficiency
		* corruptionFactor(nation.politics.corruption)
	local income = taxRevenue + enterpriseIncome

	-- Materials: mines add, factories consume. A shortfall means we could not
	-- fully maintain the city this tick.
	local materialsFlow = stats.production.materials - stats.upkeep.materials
	local res = nation.resources
	local maintainedMaterials = true
	res.materials += materialsFlow
	if res.materials &lt; 0 then
		maintainedMaterials = false
		res.materials = 0
	end

	-- Debt interest and money-denominated upkeep.
	local interest = nation.economy.debt &gt; 0
			and nation.economy.debt * (nation.economy.interestRate / 100) / eco.ticksPerYear
		or 0

	-- Standing forces draw money upkeep every tick.
	local milUpkeep = 0
	for branch, def in MilitaryUnits do
		milUpkeep += (nation.military[branch] or 0) * def.upkeep
	end

	local expense = stats.upkeep.money + interest + milUpkeep

	res.money += income
	res.money -= expense
	local maintainedMoney = true
	if res.money &lt; 0 then
		-- Deficit is financed by borrowing.
		maintainedMoney = false
		nation.economy.debt += -res.money
		res.money = 0
	elseif nation.economy.debt &gt; 0 then
		-- Repay a slice of the debt out of any surplus.
		local paydown = math.min(res.money * eco.debtRepayFraction, nation.economy.debt)
		res.money -= paydown
		nation.economy.debt -= paydown
	end

	-- Food: production feeds the population; a shortfall is reported for unrest.
	local consumption = nation.population.total * eco.foodPerCapita
	res.food += stats.production.food - consumption
	local foodShortage = 0
	if res.food &lt; 0 then
		foodShortage = -res.food
		res.food = 0
	end

	-- Research and influence accumulate as resources; energy shows the net flow.
	res.research += stats.production.research
	res.influence += stats.production.influence
	res.energy = stats.powerNet

	-- Territory bonuses from every owned map region.
	for _, regionId in nation.territory.regions do
		local region = Regions[regionId]
		if region then
			ResourceMath.grant(res, region.bonus)
		end
	end

	-- Inflation drifts toward target under money-supply pressure.
	local pressure = (income - expense) / math.max(gdp, 1)
	nation.economy.inflation += (eco.inflationTarget - nation.economy.inflation) * eco.inflationDrift
		+ pressure * eco.inflationDrift
	nation.economy.inflation = clamp(nation.economy.inflation, -5, 30)

	-- Update the economy mirror + rolling GDP history for graphs.
	nation.economy.gdp = gdp
	nation.economy.treasury = res.money
	nation.economy.lastTickIncome = income
	nation.economy.lastTickExpense = expense
	nation.economy.interestRate = eco.baseInterestRate + nation.economy.inflation * 0.5
	local history = nation.economy.gdpHistory
	table.insert(history, gdp)
	while #history &gt; Constants.GDP_HISTORY_LENGTH do
		table.remove(history, 1)
	end

	local maintained = maintainedMoney and maintainedMaterials

	return {
		stats = stats,
		resolved = resolved,
		gdp = gdp,
		income = income,
		expense = expense,
		net = income - expense,
		taxRevenue = taxRevenue,
		enterpriseIncome = enterpriseIncome,
		employed = employed,
		workforce = workforce,
		unemployment = unemployment,
		foodShortage = foodShortage,
		maintained = maintained,
		debt = nation.economy.debt,
		inflation = nation.economy.inflation,
	}
end

function EconomyService:Start()
	local CitizenService = require(script.Parent.CitizenService)
	local ResearchService = require(script.Parent.ResearchService)

	task.spawn(function()
		while true do
			task.wait(Constants.ECONOMY_TICK)
			DataService:ForEachNation(function(player, nation)
				local ok, frame = pcall(function()
					return self:Tick(nation)
				end)
				if not ok then
					log:Error(("economy tick failed for %s: %s"):format(player.Name, tostring(frame)))
					return
				end

				-- Downstream simulations reuse this tick's derived numbers.
				pcall(function()
					CitizenService:Tick(nation, frame)
				end)
				pcall(function()
					ResearchService:Tick(player, nation, frame)
				end)
				CityService:TickCondition(nation, frame.maintained)

				if frame.foodShortage &gt; 5 then
					NotificationService:Send(player, "warning", "Food shortage", "Citizens are going hungry.")
				end
				if frame.stats.powerNet &lt; 0 then
					NotificationService:Send(player, "warning", "Power shortage", "Build more power plants.")
				end

				-- Package HUD-facing derived stats and schedule a snapshot.
				ReplicationService:SetStats(player, {
					gdp = frame.gdp,
					income = frame.income,
					expense = frame.expense,
					net = frame.net,
					employed = frame.employed,
					workforce = frame.workforce,
					unemployment = frame.unemployment,
					powerNet = frame.stats.powerNet,
					powerSupply = frame.stats.powerSupply,
					powerDraw = frame.stats.powerDraw,
					jobs = frame.stats.jobs,
					housing = frame.stats.housing,
					buildingCount = frame.stats.buildingCount,
					debt = frame.debt,
					inflation = frame.inflation,
				})
				ReplicationService:MarkDirty(player)
			end)
		end
	end)

	log:Info("economy simulation running")
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">EventService</string><ProtectedString name="Source">--!strict
--[[
	Services/EventService.luau
	Keeps the world unpredictable: periodic national events hit a random nation,
	and rarer global events touch everyone at once. Every effect flows through the
	same authoritative nation state and fires a HUD notification, so events feel
	consequential without a separate rules engine.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Types = require(ReplicatedStorage.Nexus.Types)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)

type Nation = Types.Nation

local log = Logger.new("EventService")

local EventService = {
	Name = "EventService",
}

local function clamp(v: number, lo: number, hi: number): number
	return math.max(lo, math.min(hi, v))
end

-- Each national event returns (severity, title, body) after mutating the nation.
type Event = { weight: number, apply: (Nation) -&gt; (string, string, string) }

local NATIONAL: { Event } = {
	{
		weight = 3,
		apply = function(n)
			local gain = math.max(2000, n.economy.gdp * 2)
			n.resources.money += gain
			return "success", "Economic boom", ("Exports surge — treasury +%d."):format(math.floor(gain))
		end,
	},
	{
		weight = 2,
		apply = function(n)
			local loss = math.min(n.resources.money * 0.15, math.max(1500, n.economy.gdp))
			n.resources.money = math.max(0, n.resources.money - loss)
			return "warning", "Recession", ("A downturn costs the treasury %d."):format(math.floor(loss))
		end,
	},
	{
		weight = 2,
		apply = function(n)
			n.resources.research += 40
			return "success", "Research breakthrough", "Your scientists gift +40 research."
		end,
	},
	{
		weight = 2,
		apply = function(n)
			n.resources.materials += 200
			return "success", "Resource windfall", "A rich seam yields +200 materials."
		end,
	},
	{
		weight = 2,
		apply = function(n)
			local damaged = 0
			for _, b in n.buildings do
				if math.random() &lt; 0.4 then
					b.condition = clamp(b.condition - 0.3, 0, 1)
					damaged += 1
				end
			end
			n.population.total = math.max(5, math.floor(n.population.total * 0.96))
			return "error", "Natural disaster", ("A storm damages %d buildings."):format(damaged)
		end,
	},
	{
		weight = 2,
		apply = function(n)
			n.population.unrest = clamp(n.population.unrest + 15, 0, 100)
			return "warning", "Civil unrest", "Protests erupt — unrest is climbing."
		end,
	},
	{
		weight = 2,
		apply = function(n)
			n.population.total = math.floor(n.population.total * 1.08) + 3
			return "info", "Migration wave", "New arrivals swell your population."
		end,
	},
}

local GLOBAL = {
	{
		title = "Global market surge",
		body = "Materials flow freely worldwide — everyone gains materials.",
		severity = "success",
		apply = function(n: Nation)
			n.resources.materials += 120
		end,
	},
	{
		title = "World research summit",
		body = "Shared breakthroughs boost every nation's research.",
		severity = "success",
		apply = function(n: Nation)
			n.resources.research += 25
		end,
	},
	{
		title = "Energy crisis",
		body = "Fuel shortages strain every treasury.",
		severity = "warning",
		apply = function(n: Nation)
			n.resources.money = math.max(0, n.resources.money - 2500)
		end,
	},
}

local function pickNational(): Event
	local total = 0
	for _, e in NATIONAL do
		total += e.weight
	end
	local roll = math.random() * total
	for _, e in NATIONAL do
		roll -= e.weight
		if roll &lt;= 0 then
			return e
		end
	end
	return NATIONAL[1]
end

function EventService:_fireNational()
	local players = Players:GetPlayers()
	if #players == 0 then
		return
	end
	local player = players[math.random(1, #players)]
	local nation = DataService:GetNation(player)
	if not nation then
		return
	end
	local event = pickNational()
	local severity, title, body = event.apply(nation)
	ReplicationService:MarkDirty(player)
	NotificationService:Send(player, severity, title, body)
end

function EventService:_fireGlobal()
	local event = GLOBAL[math.random(1, #GLOBAL)]
	DataService:ForEachNation(function(player, nation)
		event.apply(nation)
		ReplicationService:MarkDirty(player)
	end)
	NotificationService:Broadcast(event.severity, event.title, event.body)
end

function EventService:Start()
	task.spawn(function()
		while true do
			task.wait(45 + math.random() * 30)
			pcall(function()
				self:_fireNational()
			end)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120 + math.random() * 60)
			pcall(function()
				self:_fireGlobal()
			end)
		end
	end)
	log:Info("event service ready")
end

return EventService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">MarketService</string><ProtectedString name="Source">--!strict
--[[
	Services/MarketService.luau
	A living global commodity market. Prices update every market tick from
	mean-reversion, volatility and net player demand, then broadcast to all
	clients. Players buy resources with money (pushing the price up) or sell them
	for money (pushing it down). A spread separates buy/sell prices so instant
	round-trips lose value.

	Authoritative and exploit-safe: amounts are validated and bounded, buys check
	money, sells check the actual stockpile, and money never goes negative.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Types = require(ReplicatedStorage.Nexus.Types)
local Market = require(ReplicatedStorage.Nexus.Config.Market)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)

type Nation = Types.Nation

local MAX_AMOUNT = 100000

local log = Logger.new("MarketService")

local MarketService = {
	Name = "MarketService",
}

MarketService._price = {} :: { [string]: number }
MarketService._prev = {} :: { [string]: number }
MarketService._demand = {} :: { [string]: number }

local function clamp(v: number, lo: number, hi: number): number
	return math.max(lo, math.min(hi, v))
end

-- ---- Price simulation -----------------------------------------------------

function MarketService:_tickPrices()
	for res, def in Market.resources do
		local price = self._price[res]
		local base = def.base
		local noise = (math.random() * 2 - 1) * def.volatility * base
		local demandDelta = self._demand[res] * base * Market.impact
		local next = price + (base - price) * Market.meanReversion + noise + demandDelta
		next = clamp(next, base * Market.floorFactor, base * Market.ceilFactor)

		self._prev[res] = price
		self._price[res] = next
		self._demand[res] *= Market.demandDecay
	end
end

function MarketService:Broadcast()
	local rows = {}
	for _, res in Market.order do
		table.insert(rows, {
			id = res,
			price = self._price[res],
			prev = self._prev[res],
			base = Market.resources[res].base,
		})
	end
	Net.fireAllClients(NetRoutes.MARKET_SYNC, rows)
end

--- Current mid price for a resource (used by other systems/AI).
function MarketService:PriceOf(res: string): number?
	return self._price[res]
end

-- ---- Trading --------------------------------------------------------------

function MarketService:_buy(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local res = payload.resource
	if not Market.resources[res] then
		return { success = false, reason = "not_traded" }
	end
	local amount = payload.amount
	if typeof(amount) ~= "number" or amount ~= amount or amount &lt; 1 then
		return { success = false, reason = "bad_amount" }
	end
	amount = math.min(math.floor(amount), MAX_AMOUNT)

	local unit = self._price[res] * (1 + Market.spread)
	local cost = math.ceil(amount * unit)
	if (nation.resources.money or 0) &lt; cost then
		NotificationService:Send(player, "warning", "Cannot afford purchase")
		return { success = false, reason = "insufficient_money" }
	end
	nation.resources.money -= cost
	nation.resources[res] = (nation.resources[res] or 0) + amount
	self._demand[res] += amount
	ReplicationService:MarkDirty(player)
	return { success = true, spent = cost }
end

function MarketService:_sell(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local res = payload.resource
	if not Market.resources[res] then
		return { success = false, reason = "not_traded" }
	end
	local amount = payload.amount
	if typeof(amount) ~= "number" or amount ~= amount or amount &lt; 1 then
		return { success = false, reason = "bad_amount" }
	end
	amount = math.min(math.floor(amount), MAX_AMOUNT)
	if (nation.resources[res] or 0) &lt; amount then
		return { success = false, reason = "insufficient_stock" }
	end

	local unit = self._price[res] * (1 - Market.spread)
	local revenue = math.floor(amount * unit)
	nation.resources[res] -= amount
	nation.resources.money += revenue
	self._demand[res] -= amount
	ReplicationService:MarkDirty(player)
	return { success = true, earned = revenue }
end

-- ---- Lifecycle ------------------------------------------------------------

function MarketService:Start()
	for res, def in Market.resources do
		self._price[res] = def.base
		self._prev[res] = def.base
		self._demand[res] = 0
	end

	Net.handleRequest(NetRoutes.MARKET_BUY, function(player, payload)
		return self:_buy(player, payload)
	end, { rate = 8, per = 1 })
	Net.handleRequest(NetRoutes.MARKET_SELL, function(player, payload)
		return self:_sell(player, payload)
	end, { rate = 8, per = 1 })

	DataService.Loaded:Connect(function()
		self:Broadcast()
	end)

	task.spawn(function()
		while true do
			task.wait(Market.tick)
			self:_tickPrices()
			self:Broadcast()
		end
	end)

	log:Info("market service ready")
end

return MarketService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">MilitaryService</string><ProtectedString name="Source">--!strict
--[[
	Services/MilitaryService.luau
	The optional military layer: recruit and disband units. Gated behind
	ServerSettings.militaryEnabled so peaceful servers never see it. Units cost
	resources up front and money upkeep every tick (charged by EconomyService);
	their strength feeds power ranking and forceful expansion against AI regions
	(handled in TerritoryService). This service owns recruitment; combat is
	deliberately logistics-first and never targets other players.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local ResourceMath = require(ReplicatedStorage.Nexus.ResourceMath)
local MilitaryUnits = require(ReplicatedStorage.Nexus.Config.MilitaryUnits)
local ServerSettings = require(ReplicatedStorage.Nexus.Config.ServerSettings)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)

local MAX_BATCH = 100

local log = Logger.new("MilitaryService")

local MilitaryService = {
	Name = "MilitaryService",
}

function MilitaryService:_recruit(player: Player, payload: any): any
	if not ServerSettings.militaryEnabled then
		return { success = false, reason = "disabled" }
	end
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local def = MilitaryUnits[payload.branch]
	if not def then
		return { success = false, reason = "unknown_unit" }
	end
	local count = payload.count
	if typeof(count) ~= "number" or count ~= count or count &lt; 1 then
		return { success = false, reason = "bad_count" }
	end
	count = math.min(math.floor(count), MAX_BATCH)

	if def.requiresTech and not nation.research.unlocked[def.requiresTech] then
		return { success = false, reason = "tech_locked" }
	end

	local cost = ResourceMath.scale(def.cost, count)
	if not ResourceMath.canAfford(nation.resources, cost) then
		NotificationService:Send(player, "warning", "Cannot afford recruitment")
		return { success = false, reason = "insufficient_resources" }
	end
	ResourceMath.spend(nation.resources, cost)
	nation.military[def.branch] += count
	ReplicationService:MarkDirty(player)
	NotificationService:Send(player, "success", ("Recruited %d %s"):format(count, def.displayName))
	return { success = true }
end

function MilitaryService:_disband(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local def = MilitaryUnits[payload.branch]
	if not def then
		return { success = false, reason = "unknown_unit" }
	end
	local count = math.min(math.floor(tonumber(payload.count) or 0), nation.military[def.branch])
	if count &lt; 1 then
		return { success = false, reason = "none_to_disband" }
	end
	nation.military[def.branch] -= count
	-- Partial refund for disbanding.
	ResourceMath.grant(nation.resources, ResourceMath.scale(def.cost, count * 0.3))
	ReplicationService:MarkDirty(player)
	return { success = true }
end

--- Total combat strength of a nation (also used by WorldService/TerritoryService).
function MilitaryService.strengthOf(nation): number
	local total = 0
	for branch, def in MilitaryUnits do
		total += (nation.military[branch] or 0) * def.strength
	end
	return total
end

function MilitaryService:Start()
	if not ServerSettings.militaryEnabled then
		log:Info("military disabled by server settings")
		return
	end
	Net.handleRequest(NetRoutes.RECRUIT_UNITS, function(player, payload)
		return self:_recruit(player, payload)
	end, { rate = 5, per = 1 })
	Net.handleRequest(NetRoutes.DISBAND_UNITS, function(player, payload)
		return self:_disband(player, payload)
	end, { rate = 5, per = 1 })
	log:Info("military service ready")
end

return MilitaryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">NotificationService</string><ProtectedString name="Source">--!strict
--[[
	Services/NotificationService.luau
	Server-authored, transient messages to a player's HUD: "Not enough
	materials", "Election won", "Power shortage". Purely presentational — no
	state lives here — but centralising it keeps a consistent shape and severity
	vocabulary across every service.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)

export type Severity = "info" | "success" | "warning" | "error"

local NotificationService = {
	Name = "NotificationService",
}

function NotificationService:Send(player: Player, severity: Severity, title: string, body: string?)
	Net.fireClient(player, NetRoutes.NOTIFY, {
		severity = severity,
		title = title,
		body = body,
		at = os.time(),
	})
end

function NotificationService:Broadcast(severity: Severity, title: string, body: string?)
	Net.fireAllClients(NetRoutes.NOTIFY, {
		severity = severity,
		title = title,
		body = body,
		at = os.time(),
	})
end

return NotificationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">OnboardingService</string><ProtectedString name="Source">--!strict
--[[
	Services/OnboardingService.luau
	Gently teaches a brand-new nation the ropes with a short, staggered sequence
	of HUD tips on first join. Guarded by a persisted flag so returning players
	are never nagged, and by ServerSettings.showStartingHints so an owner can
	switch it off.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local ServerSettings = require(ReplicatedStorage.Nexus.Config.ServerSettings)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)

local log = Logger.new("OnboardingService")

local OnboardingService = {
	Name = "OnboardingService",
}

-- `delay` is the gap before each tip (waited sequentially).
local TIPS = {
	{ delay = 3, sev = "info", title = "Welcome to Nexus!", body = "Grow your settlement into a superpower. Let's begin." },
	{ delay = 6, sev = "info", title = "Power the city", body = "Open 🏗 Build and place a Coal Plant, then a Farm and Housing." },
	{ delay = 8, sev = "info", title = "Govern wisely", body = "Set taxes, laws and government type in 🏛 Politics." },
	{ delay = 8, sev = "info", title = "Advance", body = "Unlock buildings and bonuses in 🔬 Research." },
	{ delay = 8, sev = "info", title = "Go global", body = "Trade in 🤝 Diplomacy, expand in 🗺 Territory, climb 🏆 Ranks." },
}

function OnboardingService:Start()
	if not ServerSettings.showStartingHints then
		return
	end
	DataService.Loaded:Connect(function(player, profile)
		local nation = profile.nation
		if nation.flags.onboarded then
			return
		end
		-- Mark done up front so a mid-sequence disconnect never repeats it.
		nation.flags.onboarded = true
		ReplicationService:MarkDirty(player)

		task.spawn(function()
			for _, tip in TIPS do
				task.wait(tip.delay)
				if not player.Parent then
					return
				end
				NotificationService:Send(player, tip.sev, tip.title, tip.body)
			end
		end)
	end)
	log:Info("onboarding ready")
end

return OnboardingService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">PoliticsService</string><ProtectedString name="Source">--!strict
--[[
	Services/PoliticsService.luau
	Government, laws and the public's verdict on your rule. Players set the tax
	rate, switch government type (a strategic pivot that costs influence), and
	enact/repeal laws. On its own slower cadence the service settles approval,
	stability and corruption from the state of the nation, and — for elective
	governments — holds elections you can lose.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Types = require(ReplicatedStorage.Nexus.Types)
local Balance = require(ReplicatedStorage.Nexus.Config.Balance)
local Governments = require(ReplicatedStorage.Nexus.Config.Governments)
local Laws = require(ReplicatedStorage.Nexus.Config.Laws)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)
local Modifiers = require(script.Parent.Parent.Util.Modifiers)

type Nation = Types.Nation

local GOVERNMENT_SWITCH_COST = 100 -- influence

local log = Logger.new("PoliticsService")

local PoliticsService = {
	Name = "PoliticsService",
}

local function clamp(v: number, lo: number, hi: number): number
	return math.max(lo, math.min(hi, v))
end

local function drift(current: number, target: number, rate: number): number
	return current + (target - current) * rate
end

-- ---- Handlers -------------------------------------------------------------

function PoliticsService:_setTax(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" or typeof(payload.rate) ~= "number" then
		return { success = false, reason = "bad_request" }
	end
	local gov = Governments[nation.politics.government]
	local ceiling = gov and gov.modifiers.taxCeiling or 0.5
	if payload.rate ~= payload.rate then -- NaN guard
		return { success = false, reason = "bad_request" }
	end
	nation.politics.taxRate = clamp(payload.rate, 0, ceiling)
	ReplicationService:MarkDirty(player)
	return { success = true, rate = nation.politics.taxRate }
end

function PoliticsService:_setGovernment(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local target = Governments[payload.government]
	if not target then
		return { success = false, reason = "unknown_government" }
	end
	if nation.politics.government == target.id then
		return { success = false, reason = "no_change" }
	end
	if (nation.resources.influence or 0) &lt; GOVERNMENT_SWITCH_COST then
		NotificationService:Send(player, "warning", "Need influence to change government")
		return { success = false, reason = "insufficient_influence" }
	end

	nation.resources.influence -= GOVERNMENT_SWITCH_COST
	nation.politics.government = target.id

	-- Repeal any laws the new government forbids.
	for lawId, active in nation.politics.activeLaws do
		if active then
			local law = Laws[lawId]
			if law and table.find(law.forbiddenGovernments, target.id) then
				nation.politics.activeLaws[lawId] = nil
			end
		end
	end

	-- Reset the election clock for the new regime.
	if target.holdsElections then
		nation.politics.nextElection = os.time() + Balance.POLITICS.electionTermSeconds
	else
		nation.politics.nextElection = 0
	end

	ReplicationService:MarkDirty(player)
	NotificationService:Send(player, "success", "Government is now " .. target.displayName)
	return { success = true }
end

function PoliticsService:_toggleLaw(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local law = Laws[payload.id]
	if not law then
		return { success = false, reason = "unknown_law" }
	end
	local isActive = nation.politics.activeLaws[payload.id] == true
	if not isActive then
		-- Enacting: check requirements.
		if law.requiresTech and not nation.research.unlocked[law.requiresTech] then
			return { success = false, reason = "tech_locked" }
		end
		if table.find(law.forbiddenGovernments, nation.politics.government) then
			return { success = false, reason = "forbidden_government" }
		end
		nation.politics.activeLaws[payload.id] = true
		NotificationService:Send(player, "success", law.displayName .. " enacted")
	else
		nation.politics.activeLaws[payload.id] = nil
		NotificationService:Send(player, "info", law.displayName .. " repealed")
	end
	ReplicationService:MarkDirty(player)
	return { success = true, active = nation.politics.activeLaws[payload.id] == true }
end

function PoliticsService:_rename(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" or typeof(payload.name) ~= "string" then
		return { success = false, reason = "bad_request" }
	end
	-- Strip control characters and clamp length. (A shipped build should also
	-- route this through TextService:FilterStringAsync before display.)
	local cleaned = (payload.name:gsub("[%c]", "")):sub(1, 24)
	cleaned = cleaned:match("^%s*(.-)%s*$") or cleaned
	if #cleaned &lt; 1 then
		return { success = false, reason = "empty_name" }
	end
	nation.name = cleaned
	ReplicationService:MarkDirty(player)
	return { success = true, name = cleaned }
end

-- ---- Slow political tick --------------------------------------------------

function PoliticsService:Tick(player: Player, nation: Nation)
	local resolved = Modifiers.resolve(nation)
	local pol = nation.politics
	local pop = nation.population

	-- Corruption creeps upward; strong institutions and laws hold it back.
	pol.corruption += Balance.POLITICS.corruptionCreep * resolved.corruptionCreepMult
	pol.corruption += resolved.corruptionFlat * 0.05
	pol.corruption = clamp(pol.corruption, 0, 100)

	-- Approval follows public happiness, the budget balance and unrest.
	local net = nation.economy.lastTickIncome - nation.economy.lastTickExpense
	local approvalTarget = clamp(
		pop.happiness * 0.6 + (net &gt;= 0 and 10 or -12) + 20 - pop.unrest * 0.3,
		0,
		100
	)
	pol.approval = clamp(drift(pol.approval, approvalTarget, Balance.POLITICS.approvalDrift), 0, 100)

	-- Stability blends approval, unrest, corruption and government backbone.
	local stabilityTarget = clamp(
		50 + resolved.stabilityFlat + (pol.approval - 50) * 0.5 - pop.unrest * 0.5 - pol.corruption * 0.2,
		0,
		100
	)
	pol.stability = clamp(drift(pol.stability, stabilityTarget, 0.2), 0, 100)

	if pol.stability &lt; Balance.POLITICS.crisisStabilityThreshold then
		NotificationService:Send(player, "error", "Government unstable", "Address unrest before it boils over.")
	end

	-- Elections.
	local gov = Governments[pol.government]
	if gov and gov.holdsElections then
		if pol.nextElection == 0 then
			pol.nextElection = os.time() + Balance.POLITICS.electionTermSeconds
		elseif os.time() &gt;= pol.nextElection then
			if pol.approval &gt;= 50 then
				NotificationService:Send(player, "success", "Election won", "The people return you to power.")
				pol.stability = clamp(pol.stability + 5, 0, 100)
			else
				NotificationService:Send(player, "warning", "Election lost", "A rocky term ahead — approval reset.")
				pol.approval = clamp(pol.approval + 15, 0, 100)
				pol.stability = clamp(pol.stability - 10, 0, 100)
			end
			pol.nextElection = os.time() + Balance.POLITICS.electionTermSeconds
		end
	end

	ReplicationService:MarkDirty(player)
end

function PoliticsService:Start()
	local Constants = require(ReplicatedStorage.Nexus.Constants)

	Net.handleRequest(NetRoutes.SET_TAX_RATE, function(player, payload)
		return self:_setTax(player, payload)
	end, { rate = 5, per = 1 })
	Net.handleRequest(NetRoutes.SET_GOVERNMENT, function(player, payload)
		return self:_setGovernment(player, payload)
	end, { rate = 2, per = 1 })
	Net.handleRequest(NetRoutes.TOGGLE_LAW, function(player, payload)
		return self:_toggleLaw(player, payload)
	end, { rate = 5, per = 1 })
	Net.handleRequest(NetRoutes.RENAME_NATION, function(player, payload)
		return self:_rename(player, payload)
	end, { rate = 2, per = 1 })

	task.spawn(function()
		while true do
			task.wait(Constants.POLITICS_TICK)
			DataService:ForEachNation(function(player, nation)
				local ok, err = pcall(function()
					self:Tick(player, nation)
				end)
				if not ok then
					log:Error(("politics tick failed for %s: %s"):format(player.Name, tostring(err)))
				end
			end)
		end
	end)

	log:Info("politics handlers + tick ready")
end

return PoliticsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">ReplicationService</string><ProtectedString name="Source">--!strict
--[[
	Services/ReplicationService.luau
	The only place server state reaches a client. Services never call Net
	directly for state; they mutate the authoritative nation and call
	`MarkDirty(player)`. This service batches dirty players and pushes a filtered,
	deep-copied snapshot at a fixed cadence, so a burst of building placements
	replicates once, not ten times.

	The client receives a read-only copy — it can never hold a live reference to
	server tables, and it is free to render the snapshot however it likes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local TableUtil = require(ReplicatedStorage.Nexus.TableUtil)
local Types = require(ReplicatedStorage.Nexus.Types)

type Nation = Types.Nation

local log = Logger.new("ReplicationService")

local ReplicationService = {
	Name = "ReplicationService",
}

ReplicationService._dirty = {} :: { [Player]: boolean }
-- Latest per-tick derived stats (flows the raw nation state does not store).
ReplicationService._stats = {} :: { [Player]: any }

local FLUSH_INTERVAL = 0.5

--- Mark a player's state as changed; it will be pushed on the next flush.
function ReplicationService:MarkDirty(player: Player)
	self._dirty[player] = true
end

--- Attach derived, per-tick statistics to a player's next snapshot.
function ReplicationService:SetStats(player: Player, stats: any)
	self._stats[player] = stats
end

function ReplicationService:_push(player: Player, nation: Nation)
	local snapshot = {
		nation = TableUtil.deepCopy(nation),
		stats = self._stats[player] or {},
		serverTime = os.time(),
	}
	Net.fireClient(player, NetRoutes.STATE_SYNC, snapshot)
end

--- Force an immediate push (used right after a profile loads).
function ReplicationService:PushNow(player: Player)
	local DataService = require(script.Parent.DataService)
	local nation = DataService:GetNation(player)
	if nation then
		self:_push(player, nation)
	end
	self._dirty[player] = nil
end

function ReplicationService:Start()
	local DataService = require(script.Parent.DataService)

	-- Send an immediate snapshot the moment a nation is ready.
	DataService.Loaded:Connect(function(player: Player)
		self:PushNow(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		self._dirty[player] = nil
		self._stats[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(FLUSH_INTERVAL)
			for player in self._dirty do
				local nation = DataService:GetNation(player)
				if nation then
					self:_push(player, nation)
				end
				self._dirty[player] = nil
			end
		end
	end)

	log:Info("replication loop started")
end

return ReplicationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">ResearchService</string><ProtectedString name="Source">--!strict
--[[
	Services/ResearchService.luau
	Drives the technology tree. Research accumulates as the `research` resource
	pool (from labs plus passive output of an educated populace) and is spent into
	whichever technology the player has selected. Completing a tech flips a flag
	the modifier resolver reads, so the effect is applied everywhere at once.

	The prerequisite DAG is enforced here: a client can never start a tech whose
	requirements are not already unlocked, no matter what it sends.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Types = require(ReplicatedStorage.Nexus.Types)
local Balance = require(ReplicatedStorage.Nexus.Config.Balance)
local Technologies = require(ReplicatedStorage.Nexus.Config.Technologies)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)

type Nation = Types.Nation

local log = Logger.new("ResearchService")

local ResearchService = {
	Name = "ResearchService",
}

--- Are every prerequisite of `techId` already unlocked?
local function prereqsMet(nation: Nation, def: Types.TechDef): boolean
	for _, requirement in def.requires do
		if not nation.research.unlocked[requirement] then
			return false
		end
	end
	return true
end

function ResearchService:Tick(player: Player, nation: Nation, _frame: any)
	local r = nation.research

	-- Passive research from an educated population.
	local passive = nation.population.education * Balance.RESEARCH.passivePerEducation
	nation.resources.research += passive * Balance.RESEARCH.pointConversion

	if not r.current then
		return
	end
	local def = Technologies[r.current]
	if not def then
		r.current = nil
		return
	end

	-- Spend from the research pool into the active tech's progress.
	local need = def.cost - r.progress
	local spend = math.min(nation.resources.research, need)
	if spend &gt; 0 then
		r.progress += spend
		nation.resources.research -= spend
	end

	if r.progress &gt;= def.cost then
		r.unlocked[r.current] = true
		local completed = def.displayName
		r.current = nil
		r.progress = 0
		NotificationService:Send(player, "success", "Research complete", completed .. " unlocked.")
		ReplicationService:MarkDirty(player)
	end
end

function ResearchService:_start(player: Player, payload: any): any
	local nation = DataService:GetNation(player)
	if not nation or typeof(payload) ~= "table" then
		return { success = false, reason = "bad_request" }
	end
	local id = payload.id
	local def = Technologies[id]
	if not def then
		return { success = false, reason = "unknown_tech" }
	end
	if nation.research.unlocked[id] then
		return { success = false, reason = "already_unlocked" }
	end
	if not prereqsMet(nation, def) then
		return { success = false, reason = "prereqs_unmet" }
	end

	-- Switching target forfeits progress on the previous one.
	if nation.research.current ~= id then
		nation.research.current = id
		nation.research.progress = 0
	end
	ReplicationService:MarkDirty(player)
	NotificationService:Send(player, "info", "Researching " .. def.displayName)
	return { success = true }
end

function ResearchService:Start()
	Net.handleRequest(NetRoutes.START_RESEARCH, function(player, payload)
		return self:_start(player, payload)
	end, { rate = 5, per = 1 })
	log:Info("research handlers ready")
end

return ResearchService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">TerritoryService</string><ProtectedString name="Source">--!strict
--[[
	Services/TerritoryService.luau
	Authoritative ownership of the shared world map. Nations spend influence to
	claim regions; a region must be adjacent to one you already hold (your first
	claim is free of that rule). Owned regions grant their per-tick bonus (applied
	by the economy loops from the Regions config) and add to national power.

	`_owner` is the live source of truth for the map; each nation's persisted
	`territory.regions` mirrors it and is reconciled on load — regions taken by
	someone else while you were away are dropped ("use it or lose it").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Types = require(ReplicatedStorage.Nexus.Types)
local Regions = require(ReplicatedStorage.Nexus.Config.Regions)
local MilitaryUnits = require(ReplicatedStorage.Nexus.Config.MilitaryUnits)
local ServerSettings = require(ReplicatedStorage.Nexus.Config.ServerSettings)

local DataService = require(script.Parent.DataService)
local NotificationService = require(script.Parent.NotificationService)
local ReplicationService = require(script.Parent.ReplicationService)
local WorldService = require(script.Parent.WorldService)

type Nation = Types.Nation

local log = Logger.new("TerritoryService")

local TerritoryService = {
	Name = "TerritoryService",
}

TerritoryService._owner = {} :: { [string]: number }

-- ---- Helpers --------------------------------------------------------------

local function areAdjacent(a: string, b: string): boolean
	local ra, rb = Regions[a], Regions[b]
	if not ra or not rb then
		return false
	end
	return math.abs(ra.col - rb.col) + math.abs(ra.row - rb.row) == 1
end

function TerritoryService:_ownedByNation(nationId: number): { string }
	local owned = {}
	for regionId, owner in self._owner do
		if owner == nationId then
			table.insert(owned, regionId)
		end
	end
	return owned
end

local function listHas(list: { string }, value: string): boolean
	return table.find(list, value) ~= nil
end

local function removeFromList(list: { string }, value: string)
	local i = table.find(list, value)
	if i then
		table.remove(list, i)
	end
end

local function strengthOf(nation: Nation): number
	local total = 0
	for branch, def in MilitaryUnits do
		total += (nation.military[branch] or 0) * def.strength
	end
	return total
end

-- A successful annexation costs the attacker some of its forces.
local function applyLosses(nation: Nation)
	local best, bestBranch = 0, nil
	for branch in MilitaryUnits do
		local count = nation.military[branch] or 0
		if count &gt; best then
			best, bestBranch = count, branch
		end
	end
	if bestBranch then
		nation.military[bestBranch] = math.max(0, best - (math.floor(best * 0.2) + 1))
	end
end

-- ---- Claiming -------------------------------------------------------------

--- Claim (or annex) a region for a nation. An unowned region is claimed with
--- influence; an AI-held adjacent region can be annexed by force when military
--- is enabled. Player-held regions are never takeable. Returns { success, ... }.
function TerritoryService:ClaimForNation(nationId: number, regionId: any): any
	local def = Regions[regionId]
	if not def then
		return { success = false, reason = "unknown_region" }
	end
	local nation, player = WorldService:GetNationById(nationId)
	if not nation then
		return { success = false, reason = "no_nation" }
	end

	local currentOwner = self._owner[regionId]
	if currentOwner == nationId then
		return { success = false, reason = "already_owned" }
	end

	local owned = self:_ownedByNation(nationId)
	local adjacent = #owned == 0
	for _, ownedId in owned do
		if areAdjacent(ownedId, regionId) then
			adjacent = true
			break
		end
	end

	local function grant(cost: number, annexed: boolean)
		nation.resources.influence -= cost
		if not listHas(nation.territory.regions, regionId) then
			table.insert(nation.territory.regions, regionId)
		end
		self._owner[regionId] = nationId
		if player then
			ReplicationService:MarkDirty(player)
			NotificationService:Send(
				player,
				"success",
				annexed and "Region annexed" or "Region claimed",
				def.displayName .. " is yours."
			)
		end
		self:Broadcast()
	end

	if currentOwner then
		-- Occupied. Only AI-held, adjacent regions can be taken, and only by force.
		if currentOwner &gt;= 0 or not ServerSettings.militaryEnabled then
			return { success = false, reason = "occupied" }
		end
		if #owned == 0 or not adjacent then
			return { success = false, reason = "not_adjacent" }
		end
		local required = math.floor(10 + def.value * 8)
		if strengthOf(nation) &lt; required then
			if player then
				NotificationService:Send(player, "warning", "Insufficient military", ("Need strength %d"):format(required))
			end
			return { success = false, reason = "need_military", required = required }
		end
		local cost = math.floor(def.cost * 1.5 + 0.5)
		if (nation.resources.influence or 0) &lt; cost then
			return { success = false, reason = "insufficient_influence", cost = cost }
		end
		-- Take it: pay influence, lose some forces, strip it from the AI owner.
		local aiNation = select(1, WorldService:GetNationById(currentOwner))
		if aiNation then
			removeFromList(aiNation.territory.regions, regionId)
		end
		applyLosses(nation)
		grant(cost, true)
		return { success = true, cost = cost, annexed = true }
	end

	-- Unowned: a normal influence claim (first claim ignores adjacency).
	if #owned &gt; 0 and not adjacent then
		return { success = false, reason = "not_adjacent" }
	end
	local cost = math.floor(def.cost * (1 + #owned * 0.4) + 0.5)
	if (nation.resources.influence or 0) &lt; cost then
		if player then
			NotificationService:Send(player, "warning", "Not enough influence", ("Need %d influence"):format(cost))
		end
		return { success = false, reason = "insufficient_influence", cost = cost }
	end
	grant(cost, false)
	return { success = true, cost = cost }
end

-- ---- Replication ----------------------------------------------------------

function TerritoryService:Broadcast()
	local map = {}
	for regionId in Regions do
		local ownerId = self._owner[regionId]
		local ownerName = nil
		if ownerId then
			local nation = select(1, WorldService:GetNationById(ownerId))
			ownerName = nation and nation.name or nil
		end
		table.insert(map, { id = regionId, ownerId = ownerId, ownerName = ownerName })
	end
	Net.fireAllClients(NetRoutes.TERRITORY_SYNC, map)
end

-- ---- Persistence reconciliation -------------------------------------------

function TerritoryService:_onLoaded(player: Player, nation: Nation)
	local kept = {}
	for _, regionId in nation.territory.regions do
		if not Regions[regionId] then
			table.insert(kept, regionId) -- non-map markers like "capital"
		elseif self._owner[regionId] == nil then
			self._owner[regionId] = player.UserId
			table.insert(kept, regionId)
		elseif self._owner[regionId] == player.UserId then
			table.insert(kept, regionId)
		end
		-- else: taken by another nation while away -&gt; dropped
	end
	nation.territory.regions = kept
	self:Broadcast()
end

function TerritoryService:_onLeaving(userId: number)
	local changed = false
	for regionId, owner in self._owner do
		if owner == userId then
			self._owner[regionId] = nil
			changed = true
		end
	end
	if changed then
		self:Broadcast()
	end
end

-- ---- Lifecycle ------------------------------------------------------------

function TerritoryService:Start()
	Net.handleRequest(NetRoutes.CLAIM_REGION, function(player, payload)
		if typeof(payload) ~= "table" then
			return { success = false, reason = "bad_request" }
		end
		return self:ClaimForNation(player.UserId, payload.regionId)
	end, { rate = 5, per = 1 })

	DataService.Loaded:Connect(function(player, profile)
		self:_onLoaded(player, profile.nation)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_onLeaving(player.UserId)
	end)

	task.spawn(function()
		while true do
			task.wait(6)
			pcall(function()
				self:Broadcast()
			end)
		end
	end)

	log:Info("territory service ready")
end

return TerritoryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">WorldService</string><ProtectedString name="Source">--!strict
--[[
	Services/WorldService.luau
	The registry that ties every nation — human or AI — into one world. It resolves
	a nation by id, ranks them into a leaderboard, and broadcasts a compact world
	directory that powers the diplomacy target list, the leaderboard panel and the
	territory ownership display.

	Id scheme: player nations use their positive Player.UserId; AI nations use
	negative ids and register themselves here (AIService calls RegisterAI), so this
	low-level service never has to depend on AIService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Types = require(ReplicatedStorage.Nexus.Types)

local DataService = require(script.Parent.DataService)

type Nation = Types.Nation

export type Entry = { id: number, nation: Nation, isAI: boolean, player: Player? }

local log = Logger.new("WorldService")

local WorldService = {
	Name = "WorldService",
}

WorldService._ai = {} :: { [number]: Nation }

-- Composite "power" used for ranking and AI decision-making.
function WorldService.powerScore(nation: Nation): number
	local techCount = 0
	for _, unlocked in nation.research.unlocked do
		if unlocked then
			techCount += 1
		end
	end
	local regionCount = #nation.territory.regions
	local mil = nation.military
	local strength = mil.army * 3 + mil.navy * 4 + mil.air * 5
	local allies = 0
	for _, a in nation.diplomacy.allies do
		if a then
			allies += 1
		end
	end
	return nation.economy.gdp * 0.4
		+ nation.population.total * 3
		+ nation.economy.treasury * 0.02
		+ techCount * 40
		+ regionCount * 80
		+ strength * 4
		+ allies * 30
end

--- AIService registers/updates its nations here.
function WorldService:RegisterAI(id: number, nation: Nation)
	self._ai[id] = nation
end

function WorldService:GetAINations(): { [number]: Nation }
	return self._ai
end

--- Resolve a nation by id. Returns (nation?, player?, isAI).
function WorldService:GetNationById(id: number): (Nation?, Player?, boolean)
	if id &gt; 0 then
		local player = Players:GetPlayerByUserId(id)
		if player then
			return DataService:GetNation(player), player, false
		end
		return nil, nil, false
	end
	return self._ai[id], nil, true
end

--- Every live nation as an Entry list.
function WorldService:GetAllEntries(): { Entry }
	local entries: { Entry } = {}
	for _, player in Players:GetPlayers() do
		local nation = DataService:GetNation(player)
		if nation then
			table.insert(entries, { id = player.UserId, nation = nation, isAI = false, player = player })
		end
	end
	for id, nation in self._ai do
		table.insert(entries, { id = id, nation = nation, isAI = true, player = nil })
	end
	return entries
end

--- Compact, replication-safe directory sorted by power (the leaderboard order).
function WorldService:BuildDirectory(): { any }
	local dir = {}
	for _, entry in self:GetAllEntries() do
		local n = entry.nation
		table.insert(dir, {
			id = entry.id,
			name = n.name,
			isAI = entry.isAI,
			government = n.politics.government,
			power = math.floor(WorldService.powerScore(n)),
			gdp = math.floor(n.economy.gdp),
			population = n.population.total,
			treasury = math.floor(n.economy.treasury),
			regions = #n.territory.regions,
			strength = n.military.army * 3 + n.military.navy * 4 + n.military.air * 5,
		})
	end
	table.sort(dir, function(a, b)
		return a.power &gt; b.power
	end)
	for rank, row in dir do
		row.rank = rank
	end
	return dir
end

function WorldService:Broadcast()
	Net.fireAllClients(NetRoutes.WORLD_SYNC, self:BuildDirectory())
end

function WorldService:Start()
	task.spawn(function()
		while true do
			task.wait(4)
			local ok, err = pcall(function()
				self:Broadcast()
			end)
			if not ok then
				log:Warn("world broadcast failed: " .. tostring(err))
			end
		end
	end)
	log:Info("world registry online")
end

return WorldService
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000042"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source">--!strict
--[[
	Util/Modifiers.luau
	Resolves a nation's active government, unlocked technologies, and enacted
	laws into a single normalised modifier table. Every service reads from this
	one resolver so the stacking rules live in exactly one place.

	Convention:
	  * `*Mult` fields are multipliers applied to a base value (1.0 = neutral).
	  * `*Flat` fields are added directly to a base value.
	  Government multipliers are the anchor; tech and law contributions stack on
	  top as additive fractions, e.g. taxEfficiencyMult = govTaxEff + Σ fractions.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Governments = require(ReplicatedStorage.Nexus.Config.Governments)
local Laws = require(ReplicatedStorage.Nexus.Config.Laws)
local Technologies = require(ReplicatedStorage.Nexus.Config.Technologies)
local Types = require(ReplicatedStorage.Nexus.Types)

type Nation = Types.Nation

export type Resolved = {
	taxCeiling: number,
	taxEfficiencyMult: number,
	upkeepMult: number,
	happinessFlat: number,
	stabilityFlat: number,
	corruptionFlat: number,
	corruptionCreepMult: number,
	researchBonusMult: number,
	foodProductionMult: number,
	powerSupplyMult: number,
	materialCostMult: number,
	industryJobsMult: number,
	influenceBonusMult: number,
	baseHealthFlat: number,
}

local Modifiers = {}

function Modifiers.resolve(nation: Nation): Resolved
	local gov = Governments[nation.politics.government] or Governments.democracy
	local g = gov.modifiers

	local r: Resolved = {
		taxCeiling = g.taxCeiling,
		taxEfficiencyMult = g.taxEfficiency,
		upkeepMult = 1.0,
		happinessFlat = g.happiness,
		stabilityFlat = g.stability,
		corruptionFlat = 0,
		corruptionCreepMult = g.corruptionCreep,
		researchBonusMult = g.researchBonus,
		foodProductionMult = 1.0,
		powerSupplyMult = 1.0,
		materialCostMult = 1.0,
		industryJobsMult = 1.0,
		influenceBonusMult = g.influenceBonus,
		baseHealthFlat = 0,
	}

	-- Accumulate additive fractions from technologies.
	local techCreep = 0
	local techResearch = 0
	local techFood = 0
	local techInfluence = 0
	for techId in nation.research.unlocked do
		local def = Technologies[techId]
		if not def then
			continue
		end
		local m = def.modifiers
		r.taxEfficiencyMult += m.taxEfficiency or 0
		r.materialCostMult += m.materialCost or 0
		r.powerSupplyMult += m.powerSupply or 0
		r.industryJobsMult += m.industryJobs or 0
		r.baseHealthFlat += m.baseHealth or 0
		techCreep += m.corruptionCreep or 0
		techFood += m.foodProduction or 0
		techInfluence += m.influenceBonus or 0
	end

	-- Accumulate law contributions.
	local lawResearch = 0
	local lawFood = 0
	local lawUpkeep = 0
	for lawId, active in nation.politics.activeLaws do
		if not active then
			continue
		end
		local def = Laws[lawId]
		if not def then
			continue
		end
		local m = def.modifiers
		r.happinessFlat += m.happiness or 0
		r.stabilityFlat += m.stability or 0
		r.corruptionFlat += m.corruption or 0
		r.taxEfficiencyMult += m.taxEfficiency or 0
		lawResearch += m.researchBonus or 0
		lawFood += m.foodProduction or 0
		lawUpkeep += m.upkeep or 0
	end

	-- Each ally lifts influence generation; alliances are a diplomatic engine.
	local allyCount = 0
	if nation.diplomacy and nation.diplomacy.allies then
		for _, active in nation.diplomacy.allies do
			if active then
				allyCount += 1
			end
		end
	end

	r.corruptionCreepMult *= (1 + techCreep)
	r.researchBonusMult *= (1 + techResearch + lawResearch)
	r.foodProductionMult += techFood + lawFood
	r.influenceBonusMult *= (1 + techInfluence + allyCount * 0.05)
	r.upkeepMult += lawUpkeep

	return r
end

return Modifiers
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">Validation</string><ProtectedString name="Source">--!strict
--[[
	Util/Validation.luau
	Server-side guards for untrusted client payloads. Every request handler runs
	its arguments through these before touching authoritative state. The rule:
	assume the payload was crafted by an exploiter, and prove each field valid.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Nexus.Constants)

local Validation = {}

function Validation.isTable(v: any): boolean
	return typeof(v) == "table"
end

function Validation.isString(v: any, maxLen: number?): boolean
	return typeof(v) == "string" and #v &lt;= (maxLen or 256)
end

function Validation.isInteger(v: any): boolean
	return typeof(v) == "number" and v == v and v % 1 == 0 and v ~= math.huge and v ~= -math.huge
end

--- A grid coordinate must be an integer inside [0, GRID_SIZE).
function Validation.isGridCoord(v: any): boolean
	return Validation.isInteger(v) and v &gt;= 0 and v &lt; Constants.GRID_SIZE
end

--- Rotation is restricted to the four cardinal orientations.
function Validation.isRotation(v: any): boolean
	return v == 0 or v == 90 or v == 180 or v == 270
end

--- Validate a `{ x, z }` position payload; returns cleaned ints or nil.
function Validation.readPosition(payload: any): ({ x: number, z: number })?
	if not Validation.isTable(payload) then
		return nil
	end
	local x, z = payload.x, payload.z
	if Validation.isGridCoord(x) and Validation.isGridCoord(z) then
		return { x = x, z = z }
	end
	return nil
end

return Validation
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000073"><Properties></Properties><Item class="StarterPlayerScripts" referent="RBX00000072"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000069"><Properties><string name="Name">Nexus</string><ProtectedString name="Source">--!strict
--[[
	init.client.luau
	Client bootstrap. Registers every controller with the ClientFramework, then
	runs the shared Init/Start lifecycle. Init order is chosen so the HUD's
	chrome exists before the panels that attach buttons to it; Framework still
	guarantees all Inits precede all Starts.

	This is the ONLY LocalScript — every other client file is a ModuleScript, and
	they are children of this script (Rojo turns the folder-with-init into this
	LocalScript), so we address them from `script`.
]]

local Players = game:GetService("Players")

local ClientFramework = require(script.ClientFramework)
local Controllers = script.Controllers

local ORDER = {
	"StateController",
	"WorldStateController",
	"AmbianceController",
	"NotificationController",
	"HudController",
	"WorldController",
	"BuildController",
	"PoliticsController",
	"ResearchController",
	"EconomyController",
	"DiplomacyController",
	"TerritoryController",
	"MilitaryController",
	"MarketController",
	"LeaderboardController",
}

for _, name in ORDER do
	local module = Controllers:FindFirstChild(name)
	assert(module, "missing controller module: " .. name)
	ClientFramework.register(require(module))
end

ClientFramework.start()

print("[Nexus] client online for " .. Players.LocalPlayer.Name)
</ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">ClientFramework</string><ProtectedString name="Source">--!strict
--[[
	ClientFramework.luau
	The client mirror of the server Framework: a controller registry with the
	same two-phase Init/Start lifecycle, so UI controllers can reference each
	other lazily without load-order headaches.
]]

local Logger = require(game:GetService("ReplicatedStorage").Nexus.Logger)

local log = Logger.new("ClientFramework")

export type Controller = {
	Name: string,
	Init: ((self: any) -&gt; ())?,
	Start: ((self: any) -&gt; ())?,
	[any]: any,
}

local ClientFramework = {}
local controllers: { [string]: Controller } = {}
local started = false

function ClientFramework.register(controller: Controller): Controller
	assert(not started, "cannot register after start")
	assert(controller.Name, "controller missing Name")
	assert(not controllers[controller.Name], "duplicate controller: " .. controller.Name)
	controllers[controller.Name] = controller
	return controller
end

function ClientFramework.get(name: string): any
	local controller = controllers[name]
	if not controller then
		error(("controller %q not registered"):format(name), 2)
	end
	return controller
end

function ClientFramework.start()
	assert(not started, "already started")
	started = true

	for name, controller in controllers do
		if controller.Init then
			local ok, err = pcall(controller.Init, controller)
			if not ok then
				log:Error(("Init failed for %s: %s"):format(name, tostring(err)))
			end
		end
	end
	for name, controller in controllers do
		if controller.Start then
			task.spawn(function()
				local ok, err = pcall(controller.Start, controller)
				if not ok then
					log:Error(("Start failed for %s: %s"):format(name, tostring(err)))
				end
			end)
		end
	end
	log:Info("controllers started")
end

return ClientFramework
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000060"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">AmbianceController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/AmbianceController.luau
	Sets the mood: cinematic lighting, atmospheric depth and post-processing.
	Configured at runtime on the client (lighting is client-rendered anyway), so
	the look ships identically whether the game is opened from the place file or
	synced with Rojo — no hand-authored Lighting in the tree required.

	The target is a clean, warm late-afternoon over a stylized city: soft shadows,
	a little haze for distance, gentle bloom on the neon accents, and a touch of
	colour grading for contrast and life.
]]

local Lighting = game:GetService("Lighting")

local AmbianceController = {
	Name = "AmbianceController",
}

-- Fetch-or-create a single instance of `className` under `parent`.
local function ensure(parent: Instance, className: string, name: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

function AmbianceController:Init()
	-- Core lighting: Future technology for the best shadows and light bounce.
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	Lighting.ClockTime = 15.2
	Lighting.GeographicLatitude = 24
	Lighting.Brightness = 2.6
	Lighting.ExposureCompensation = 0.15
	Lighting.Ambient = Color3.fromRGB(64, 72, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(126, 136, 158)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 236, 205)
	Lighting.ColorShift_Bottom = Color3.fromRGB(120, 140, 170)
	Lighting.ShadowSoftness = 0.5
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000 -- distance handled by Atmosphere, not legacy fog

	-- Atmosphere: haze that fades distant tiles for a sense of scale.
	local atmosphere = ensure(Lighting, "Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(202, 212, 227)
	atmosphere.Decay = Color3.fromRGB(104, 112, 128)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 1.6

	-- Bloom: makes the neon building accents glow.
	local bloom = ensure(Lighting, "BloomEffect", "NexusBloom") :: BloomEffect
	bloom.Intensity = 0.65
	bloom.Size = 24
	bloom.Threshold = 1.05

	-- Sun rays for a hint of golden-hour warmth.
	local sun = ensure(Lighting, "SunRaysEffect", "NexusSunRays") :: SunRaysEffect
	sun.Intensity = 0.09
	sun.Spread = 0.9

	-- Colour grading: gentle contrast, saturation and a warm tint.
	local grade = ensure(Lighting, "ColorCorrectionEffect", "NexusGrade") :: ColorCorrectionEffect
	grade.Brightness = 0.0
	grade.Contrast = 0.1
	grade.Saturation = 0.14
	grade.TintColor = Color3.fromRGB(255, 248, 240)
end

return AmbianceController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">BuildController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/BuildController.luau
	Everything the player touches to shape their city:
	  * a categorised build menu (locked entries reveal as tech unlocks),
	  * grid placement with a live ghost that turns red when a spot is invalid,
	    rotates with R and cancels with Escape,
	  * click-to-select an existing building for upgrade / repair / demolish.

	Client-side validity (bounds, overlap, affordability) only drives the ghost
	colour and button states — every action is re-validated by the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Constants = require(ReplicatedStorage.Nexus.Constants)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local ResourceMath = require(ReplicatedStorage.Nexus.ResourceMath)
local WorldGrid = require(ReplicatedStorage.Nexus.WorldGrid)
local Buildings = require(ReplicatedStorage.Nexus.Config.Buildings)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Format = require(script.Parent.Parent.UI.Format)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local BuildController = {
	Name = "BuildController",
}

BuildController._panel = nil :: Frame?
BuildController._selectionPanel = nil :: Frame?
BuildController._selectedId = nil :: string?
BuildController._placingKind = nil :: string?
BuildController._placingRotation = 0
BuildController._ghost = nil :: BasePart?
BuildController._buttons = {} :: { { button: TextButton, kind: string } }
BuildController._highlight = nil :: Highlight?
BuildController._placeBar = nil :: Frame?
BuildController._reticle = nil :: Frame?

-- ---- Helpers --------------------------------------------------------------

-- True when the player is driving with a mouse/keyboard (ghost follows the
-- cursor); false on touch/gamepad, where the ghost follows a centre reticle.
local function pointerMode(): boolean
	local t = UserInputService:GetLastInputType()
	return t == Enum.UserInputType.MouseMovement
		or t == Enum.UserInputType.MouseButton1
		or t == Enum.UserInputType.MouseButton2
		or t == Enum.UserInputType.MouseWheel
		or t == Enum.UserInputType.Keyboard
end

local function orientedFootprint(kind: string, rotation: number): (number, number)
	local def = Buildings[kind]
	local w, h = def.footprint.w, def.footprint.h
	if rotation == 90 or rotation == 270 then
		return h, w
	end
	return w, h
end

local function occupancy(nation: any, excludeId: string?): { [string]: boolean }
	local occ = {}
	for id, b in nation.buildings do
		if id == excludeId then
			continue
		end
		local def = Buildings[b.kind]
		if not def then
			continue
		end
		local w, h = orientedFootprint(b.kind, b.rotation)
		for dx = 0, w - 1 do
			for dz = 0, h - 1 do
				occ[(b.position.x + dx) .. "," .. (b.position.z + dz)] = true
			end
		end
	end
	return occ
end

local function costSummary(kind: string, level: number): string
	local cost = Buildings[kind].cost[level] or {}
	local parts = {}
	if cost.money then
		table.insert(parts, "$" .. Format.abbrev(cost.money))
	end
	if cost.materials then
		table.insert(parts, "▣" .. Format.abbrev(cost.materials))
	end
	return table.concat(parts, "  ")
end

local function fireAction(route: string, payload: any)
	task.spawn(function()
		Net.request(route, payload)
	end)
end

-- ---- Build menu -----------------------------------------------------------

function BuildController:_buildMenu()
	local StateController = require(script.Parent.StateController)
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local panel = Create("Frame", {
		Name = "BuildMenu",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(260, 420),
		BackgroundColor3 = Theme.color.panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "Construction",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("ScrollingFrame", {
				Name = "List",
				Position = UDim2.fromOffset(8, 40),
				Size = UDim2.new(1, -16, 1, -48),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				[Create.Children] = {
					Create("UIListLayout", {
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					}),
				},
			}),
		},
	}) :: Frame

	local list = panel:FindFirstChild("List") :: ScrollingFrame

	-- Stable order: by category then display name.
	local order = {}
	for kind in Buildings do
		table.insert(order, kind)
	end
	table.sort(order, function(a, b)
		local da, db = Buildings[a], Buildings[b]
		if da.category ~= db.category then
			return da.category &lt; db.category
		end
		return da.displayName &lt; db.displayName
	end)

	for i, kind in order do
		local def = Buildings[kind]
		local button = Create("TextButton", {
			LayoutOrder = i,
			BackgroundColor3 = Theme.color.panelLight,
			Size = UDim2.new(1, 0, 0, 52),
			AutoButtonColor = true,
			Text = "",
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 6),
					Size = UDim2.new(1, -16, 0, 18),
					Font = Theme.font.bold,
					Text = def.displayName,
					TextColor3 = Theme.color.text,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
				Create("TextLabel", {
					Name = "Sub",
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 26),
					Size = UDim2.new(1, -16, 0, 18),
					Font = Theme.font.regular,
					Text = def.category .. "   " .. costSummary(kind, 1),
					TextColor3 = Theme.color.textDim,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
			},
			[Create.Event] = {
				Activated = function()
					self:_onPickBuilding(kind)
				end,
			},
		}) :: TextButton
		button.Parent = list
		table.insert(self._buttons, { button = button, kind = kind })
	end

	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel

	-- Refresh lock state as tech changes.
	StateController.Changed:Connect(function()
		self:_refreshLocks()
	end)
	self:_refreshLocks()
end

function BuildController:_refreshLocks()
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	if not nation then
		return
	end
	for _, entry in self._buttons do
		local def = Buildings[entry.kind]
		local locked = def.requiresTech ~= nil and not nation.research.unlocked[def.requiresTech]
		local sub = entry.button:FindFirstChild("Sub") :: TextLabel?
		if locked then
			entry.button.BackgroundColor3 = Theme.color.bg
			if sub then
				sub.Text = "🔒 Requires research"
				sub.TextColor3 = Theme.color.bad
			end
		else
			entry.button.BackgroundColor3 = Theme.color.panelLight
			if sub then
				sub.Text = def.category .. "   " .. costSummary(entry.kind, 1)
				sub.TextColor3 = Theme.color.textDim
			end
		end
	end
end

function BuildController:_onPickBuilding(kind: string)
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	local def = Buildings[kind]
	if nation and def.requiresTech and not nation.research.unlocked[def.requiresTech] then
		local Notif = require(script.Parent.NotificationController)
		Notif:Show("warning", "Locked", "Research required to build " .. def.displayName)
		return
	end
	self:_beginPlacement(kind)
end

-- ---- Placement ------------------------------------------------------------

-- Bottom-centre Place / Rotate / Cancel controls (essential on touch &amp; console;
-- handy everywhere) plus a centre reticle shown when aiming without a cursor.
function BuildController:_buildPlaceControls()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local function btn(text: string, color: Color3, width: number, onClick: () -&gt; ()): TextButton
		return Create("TextButton", {
			BackgroundColor3 = color,
			Size = UDim2.fromOffset(width, 46),
			Font = Theme.font.bold,
			Text = text,
			TextColor3 = Theme.color.text,
			TextSize = 16,
			AutoButtonColor = true,
			[Create.Children] = {
				Create("UICorner", { CornerRadius = Theme.corner }),
				Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			},
			[Create.Event] = { Activated = onClick },
		}) :: TextButton
	end

	local bar = Create("Frame", {
		Name = "PlaceControls",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -72),
		Size = UDim2.fromOffset(320, 46),
		BackgroundTransparency = 1,
		Visible = false,
		[Create.Children] = {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
			btn("⟳ Rotate", Theme.color.panelLight, 96, function()
				self._placingRotation = (self._placingRotation + 90) % 360
			end),
			btn("✓ Place", Theme.color.good, 116, function()
				self:_confirmPlacement()
			end),
			btn("✕ Cancel", Color3.fromRGB(120, 50, 50), 96, function()
				self:_cancelPlacement()
			end),
		},
	}) :: Frame
	bar.Parent = gui
	self._placeBar = bar

	local reticle = Create("Frame", {
		Name = "Reticle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(46, 46),
		BackgroundTransparency = 1,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			Create("UIStroke", { Color = Theme.color.accent, Thickness = 2, Transparency = 0.2 }),
			Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(6, 6),
				BackgroundColor3 = Theme.color.accent,
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) },
			}),
		},
	}) :: Frame
	reticle.Parent = gui
	self._reticle = reticle
end

function BuildController:_beginPlacement(kind: string)
	self:_clearSelection()
	self._placingKind = kind
	self._placingRotation = 0
	if not self._ghost then
		local ghost = Instance.new("Part")
		ghost.Anchored = true
		ghost.CanCollide = false
		ghost.CanQuery = false
		ghost.Transparency = 0.4
		ghost.Material = Enum.Material.ForceField
		ghost.Parent = Workspace
		self._ghost = ghost
	end
	if self._panel then
		self._panel.Visible = false
	end
	if self._placeBar then
		self._placeBar.Visible = true
	end
end

function BuildController:_cancelPlacement()
	self._placingKind = nil
	if self._ghost then
		self._ghost:Destroy()
		self._ghost = nil
	end
	if self._placeBar then
		self._placeBar.Visible = false
	end
	if self._reticle then
		self._reticle.Visible = false
	end
end

-- The screen point the ghost/selection tracks: the mouse on desktop, the centre
-- of the viewport on touch/gamepad (you aim by panning the camera).
function BuildController:_targetPoint(): Vector2
	if pointerMode() then
		return UserInputService:GetMouseLocation()
	end
	local vp = Workspace.CurrentCamera.ViewportSize
	return Vector2.new(vp.X / 2, vp.Y / 2)
end

-- Raycast the target point against the baseplate; returns the corner tile for
-- the current footprint (centred on the point), or nil if it is off-map.
function BuildController:_cursorTile(): ({ x: number, z: number })?
	local WorldController = require(script.Parent.WorldController)
	local camera = Workspace.CurrentCamera
	local pt = self:_targetPoint()
	local ray = camera:ViewportPointToRay(pt.X, pt.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { WorldController:GetBaseplate() }
	local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not result then
		return nil
	end

	local w, h = orientedFootprint(self._placingKind :: string, self._placingRotation)
	local tx, tz = WorldGrid.worldToTile(result.Position)
	local cornerX = math.clamp(tx - math.floor(w / 2), 0, Constants.GRID_SIZE - w)
	local cornerZ = math.clamp(tz - math.floor(h / 2), 0, Constants.GRID_SIZE - h)
	return { x = cornerX, z = cornerZ }
end

function BuildController:_isValid(corner: { x: number, z: number }): boolean
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	if not nation then
		return false
	end
	local kind = self._placingKind :: string
	local w, h = orientedFootprint(kind, self._placingRotation)
	if corner.x + w &gt; Constants.GRID_SIZE or corner.z + h &gt; Constants.GRID_SIZE then
		return false
	end
	local occ = occupancy(nation)
	for dx = 0, w - 1 do
		for dz = 0, h - 1 do
			if occ[(corner.x + dx) .. "," .. (corner.z + dz)] then
				return false
			end
		end
	end
	local cost = Buildings[kind].cost[1] or {}
	return ResourceMath.canAfford(nation.resources, cost)
end

function BuildController:_updateGhost()
	if not self._placingKind or not self._ghost then
		return
	end
	local corner = self:_cursorTile()
	local ghost = self._ghost
	if not corner then
		ghost.Transparency = 1
		return
	end
	local kind = self._placingKind
	local w, h = orientedFootprint(kind, self._placingRotation)
	local height = 6
	local center = WorldGrid.footprintCenter(corner.x, corner.z, w, h)
	ghost.Size = Vector3.new(w * WorldGrid.STUDS * 0.9, height, h * WorldGrid.STUDS * 0.9)
	ghost.Position = center + Vector3.new(0, height / 2, 0)
	local valid = self:_isValid(corner)
	ghost.Transparency = 0.4
	ghost.Color = valid and Theme.color.good or Theme.color.bad
end

function BuildController:_confirmPlacement()
	local corner = self:_cursorTile()
	if not corner or not self._placingKind then
		return
	end
	if not self:_isValid(corner) then
		local Notif = require(script.Parent.NotificationController)
		Notif:Show("warning", "Can't build here")
		return
	end
	fireAction(NetRoutes.PLACE_BUILDING, {
		kind = self._placingKind,
		x = corner.x,
		z = corner.z,
		rotation = self._placingRotation,
	})
	-- Stay in placement mode for rapid building; Escape exits.
end

-- ---- Selection + context actions ------------------------------------------

function BuildController:_pickBuildingAt(screenPt: Vector2?): string?
	local WorldController = require(script.Parent.WorldController)
	local camera = Workspace.CurrentCamera
	local pt = screenPt or self:_targetPoint()
	local ray = camera:ViewportPointToRay(pt.X, pt.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { WorldController:GetCityFolder() }
	local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if result and result.Instance then
		-- Walk up in case the ray hit a decorative child rather than the body.
		local inst: Instance? = result.Instance
		while inst and inst ~= Workspace do
			local id = inst:GetAttribute("buildingId")
			if id then
				return id :: string
			end
			inst = inst.Parent
		end
	end
	return nil
end

function BuildController:_clearSelection()
	self._selectedId = nil
	if self._highlight then
		self._highlight.Adornee = nil
	end
	if self._selectionPanel and self._selectionPanel.Visible then
		Motion.hide(self._selectionPanel)
	end
end

function BuildController:_select(id: string)
	local WorldController = require(script.Parent.WorldController)
	self._selectedId = id

	-- Outline the selected building in the world.
	if not self._highlight then
		local hl = Instance.new("Highlight")
		hl.Name = "NexusSelection"
		hl.FillColor = Theme.color.accent
		hl.FillTransparency = 0.75
		hl.OutlineColor = Theme.color.accent
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = Workspace
		self._highlight = hl
	end
	self._highlight.Adornee = WorldController:GetModel(id)

	self:_refreshSelectionPanel()
	if self._selectionPanel and not self._selectionPanel.Visible then
		Motion.show(self._selectionPanel)
	end
end

function BuildController:_refreshSelectionPanel()
	local panel = self._selectionPanel
	local id = self._selectedId
	if not panel or not id then
		return
	end
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	local building = nation and nation.buildings[id]
	if not building then
		self:_clearSelection()
		return
	end
	local def = Buildings[building.kind]
	local title = panel:FindFirstChild("Title") :: TextLabel
	local info = panel:FindFirstChild("Info") :: TextLabel
	title.Text = def.displayName .. "  (Lv " .. building.level .. ")"
	info.Text = ("Condition %d%%   %s"):format(
		math.floor(building.condition * 100 + 0.5),
		building.active and "Active" or "Offline"
	)
end

function BuildController:_buildSelectionPanel()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local function actionButton(text: string, color: Color3, onClick: () -&gt; ()): TextButton
		return Create("TextButton", {
			BackgroundColor3 = color,
			Size = UDim2.new(0, 96, 1, 0),
			Font = Theme.font.bold,
			Text = text,
			TextColor3 = Theme.color.text,
			TextSize = 14,
			AutoButtonColor = true,
			[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 8) }) },
			[Create.Event] = { Activated = onClick },
		}) :: TextButton
	end

	local panel = Create("Frame", {
		Name = "Selection",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.fromOffset(340, 96),
		BackgroundColor3 = Theme.color.panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				Name = "Title",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 8),
				Size = UDim2.new(1, -28, 0, 20),
				Font = Theme.font.bold,
				Text = "",
				TextColor3 = Theme.color.text,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextLabel", {
				Name = "Info",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 30),
				Size = UDim2.new(1, -28, 0, 18),
				Font = Theme.font.regular,
				Text = "",
				TextColor3 = Theme.color.textDim,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 54),
				Size = UDim2.new(1, -28, 0, 34),
				[Create.Children] = {
					Create("UIListLayout", {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 8),
						SortOrder = Enum.SortOrder.LayoutOrder,
					}),
					actionButton("Upgrade", Theme.color.accentDim, function()
						if self._selectedId then
							fireAction(NetRoutes.UPGRADE_BUILDING, { id = self._selectedId })
						end
					end),
					actionButton("Repair", Theme.color.panelLight, function()
						if self._selectedId then
							fireAction(NetRoutes.REPAIR_BUILDING, { id = self._selectedId })
						end
					end),
					actionButton("Demolish", Color3.fromRGB(120, 50, 50), function()
						if self._selectedId then
							fireAction(NetRoutes.DEMOLISH_BUILDING, { id = self._selectedId })
							self:_clearSelection()
						end
					end),
				},
			}),
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._selectionPanel = panel
end

-- ---- Input ----------------------------------------------------------------

function BuildController:_tapSelect(screenPt: Vector2?)
	local id = self:_pickBuildingAt(screenPt)
	if id then
		self:_select(id)
	else
		self:_clearSelection()
	end
end

function BuildController:_bindInput()
	local touchStart: Vector2? = nil

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		-- Rotate: R key or gamepad R1.
		if (input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonR1) and self._placingKind then
			self._placingRotation = (self._placingRotation + 90) % 360
			return
		end
		-- Cancel: Escape or gamepad B.
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			self:_cancelPlacement()
			self:_clearSelection()
			return
		end

		-- Remember a touch start so InputEnded can tell a tap from a drag.
		if input.UserInputType == Enum.UserInputType.Touch then
			touchStart = Vector2.new(input.Position.X, input.Position.Y)
			return -- never place/select on touch-begin; that's for tap/buttons
		end

		if gameProcessed then
			return
		end
		-- Desktop click, or gamepad A (aims via the reticle).
		local isConfirm = (input.UserInputType == Enum.UserInputType.MouseButton1 and pointerMode())
			or input.KeyCode == Enum.KeyCode.ButtonA
		if isConfirm then
			if self._placingKind then
				self:_confirmPlacement()
			else
				self:_tapSelect(nil)
			end
		end
	end)

	-- Touch: a short tap (not a drag) selects a building; placement uses the
	-- on-screen Place button, so panning never accidentally builds.
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch or not touchStart then
			return
		end
		local endPt = Vector2.new(input.Position.X, input.Position.Y)
		local moved = (endPt - touchStart).Magnitude
		touchStart = nil
		if moved &lt; 14 and not self._placingKind then
			self:_tapSelect(endPt)
		end
	end)

	RunService.RenderStepped:Connect(function()
		if self._placingKind then
			self:_updateGhost()
			if self._reticle then
				self._reticle.Visible = not pointerMode()
			end
		end
	end)
end

-- ---- Lifecycle ------------------------------------------------------------

function BuildController:Start()
	local HudController = require(script.Parent.HudController)
	local StateController = require(script.Parent.StateController)

	self:_buildMenu()
	self:_buildSelectionPanel()
	self:_buildPlaceControls()
	self:_bindInput()

	HudController:AddButton("🏗 Build", function()
		if self._placingKind then
			self:_cancelPlacement()
			return
		end
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)

	StateController.Changed:Connect(function()
		self:_refreshSelectionPanel()
	end)
end

return BuildController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">DiplomacyController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/DiplomacyController.luau
	The diplomacy screen: pick another nation, compose a resource-for-resource
	trade (or propose an alliance), and act on incoming offers. Reads the world
	directory and trade inbox from WorldStateController; every action is a
	validated server request.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Nexus.Constants)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Resources = require(ReplicatedStorage.Nexus.Config.Resources)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Format = require(script.Parent.Parent.UI.Format)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local ORDER = Constants.RESOURCE_ORDER

local DiplomacyController = {
	Name = "DiplomacyController",
}

DiplomacyController._panel = nil :: Frame?
DiplomacyController._targetId = nil :: number?
DiplomacyController._targetName = "—"
DiplomacyController._give = { idx = 1, amt = 1000 }
DiplomacyController._recv = { idx = 2, amt = 100 }
DiplomacyController._refs = {} :: any

local function request(route: string, payload: any)
	task.spawn(function()
		Net.request(route, payload)
	end)
end

local function stepFor(resource: string): number
	if resource == "money" then
		return 1000
	elseif resource == "materials" or resource == "food" then
		return 50
	end
	return 20
end

local function bagSummary(bag: any): string
	local parts = {}
	for _, id in ORDER do
		local amt = bag and bag[id]
		if amt and amt &gt; 0 then
			table.insert(parts, (Resources[id].symbol) .. Format.abbrev(amt))
		end
	end
	return #parts &gt; 0 and table.concat(parts, " ") or "—"
end

-- ---- Resource+amount stepper -----------------------------------------------

function DiplomacyController:_stepper(label: string, state: any, order: number): Frame
	local resLabel: TextLabel
	local amtLabel: TextLabel

	local function refresh()
		local res = ORDER[state.idx]
		resLabel.Text = Resources[res].symbol .. " " .. Resources[res].displayName
		amtLabel.Text = Format.abbrev(state.amt)
	end

	local frame = Create("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = Theme.color.panelLight,
		Size = UDim2.new(1, 0, 0, 56),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 4),
				Size = UDim2.new(1, -20, 0, 14),
				Font = Theme.font.regular,
				Text = label,
				TextColor3 = Theme.color.textDim,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextButton", {
				Name = "Res",
				BackgroundColor3 = Theme.color.bg,
				Position = UDim2.fromOffset(10, 20),
				Size = UDim2.fromOffset(150, 28),
				Font = Theme.font.bold,
				Text = "",
				TextColor3 = Theme.color.text,
				TextSize = 12,
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) },
				[Create.Event] = { Activated = function()
					state.idx = (state.idx % #ORDER) + 1
					state.amt = stepFor(ORDER[state.idx])
					refresh()
				end },
			}),
			Create("TextButton", {
				BackgroundColor3 = Theme.color.accentDim,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -84, 0, 20),
				Size = UDim2.fromOffset(28, 28),
				Font = Theme.font.bold,
				Text = "−",
				TextColor3 = Theme.color.text,
				TextSize = 18,
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) },
				[Create.Event] = { Activated = function()
					state.amt = math.max(0, state.amt - stepFor(ORDER[state.idx]))
					refresh()
				end },
			}),
			Create("TextLabel", {
				Name = "Amt",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -46, 0, 20),
				Size = UDim2.fromOffset(40, 28),
				Font = Theme.font.bold,
				Text = "0",
				TextColor3 = Theme.color.text,
				TextSize = 13,
			}),
			Create("TextButton", {
				BackgroundColor3 = Theme.color.accentDim,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 20),
				Size = UDim2.fromOffset(28, 28),
				Font = Theme.font.bold,
				Text = "+",
				TextColor3 = Theme.color.text,
				TextSize = 18,
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) },
				[Create.Event] = { Activated = function()
					state.amt += stepFor(ORDER[state.idx])
					refresh()
				end },
			}),
		},
	}) :: Frame
	resLabel = frame:FindFirstChild("Res") :: TextLabel
	amtLabel = frame:FindFirstChild("Amt") :: TextLabel
	refresh()
	return frame
end

-- ---- Panel -----------------------------------------------------------------

function DiplomacyController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local targetList = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(10, 40),
		Size = UDim2.new(1, -20, 0, 130),
		BackgroundColor3 = Theme.color.bg,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
			Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }),
		},
	}) :: ScrollingFrame

	local targetLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 176),
		Size = UDim2.new(1, -20, 0, 18),
		Font = Theme.font.bold,
		Text = "Select a nation above",
		TextColor3 = Theme.color.accent,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel

	local composer = Create("Frame", {
		Position = UDim2.fromOffset(10, 198),
		Size = UDim2.new(1, -20, 0, 128),
		BackgroundTransparency = 1,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	})
	self:_stepper("You give", self._give, 1).Parent = composer
	self:_stepper("You receive", self._recv, 2).Parent = composer

	local buttons = Create("Frame", {
		Position = UDim2.fromOffset(10, 332),
		Size = UDim2.new(1, -20, 0, 34),
		BackgroundTransparency = 1,
		[Create.Children] = {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
			Create("TextButton", {
				BackgroundColor3 = Theme.color.accentDim,
				Size = UDim2.fromOffset(150, 34),
				Font = Theme.font.bold,
				Text = "Send Trade",
				TextColor3 = Theme.color.text,
				TextSize = 14,
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 8) }) },
				[Create.Event] = { Activated = function()
					self:_sendTrade()
				end },
			}),
			Create("TextButton", {
				BackgroundColor3 = Theme.color.panelLight,
				Size = UDim2.fromOffset(150, 34),
				Font = Theme.font.bold,
				Text = "Propose Alliance",
				TextColor3 = Theme.color.text,
				TextSize = 14,
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 8) }) },
				[Create.Event] = { Activated = function()
					if self._targetId then
						request(NetRoutes.PROPOSE_ALLIANCE, { toId = self._targetId })
					end
				end },
			}),
		},
	})

	local inbox = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(10, 396),
		Size = UDim2.new(1, -20, 1, -406),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	}) :: ScrollingFrame

	local panel = Create("Frame", {
		Name = "DiplomacyPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(380, 560),
		BackgroundColor3 = Theme.color.panel,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "🤝 Diplomacy",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 374),
				Size = UDim2.new(1, -28, 0, 18),
				Font = Theme.font.bold,
				Text = "Incoming offers",
				TextColor3 = Theme.color.accent2,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			targetList,
			targetLabel,
			composer,
			buttons,
			inbox,
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
	self._refs = { targetList = targetList, targetLabel = targetLabel, inbox = inbox }
end

function DiplomacyController:_sendTrade()
	if not self._targetId then
		return
	end
	local giveRes = ORDER[self._give.idx]
	local recvRes = ORDER[self._recv.idx]
	local give = self._give.amt &gt; 0 and { [giveRes] = self._give.amt } or {}
	local receive = self._recv.amt &gt; 0 and { [recvRes] = self._recv.amt } or {}
	request(NetRoutes.PROPOSE_TRADE, { toId = self._targetId, give = give, receive = receive })
end

function DiplomacyController:_selectTarget(id: number, name: string)
	self._targetId = id
	self._targetName = name
	if self._refs.targetLabel then
		self._refs.targetLabel.Text = "Trading with: " .. name
	end
	self:_refreshTargets(nil)
end

function DiplomacyController:_refreshTargets(directory: { any }?)
	local WorldStateController = require(script.Parent.WorldStateController)
	directory = directory or WorldStateController:GetDirectory()
	local list = self._refs.targetList
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	local myId = Players.LocalPlayer.UserId
	for _, row in directory :: { any } do
		if row.id == myId then
			continue
		end
		local selected = row.id == self._targetId
		local btn = Create("TextButton", {
			LayoutOrder = row.rank,
			BackgroundColor3 = selected and Theme.color.accentDim or Theme.color.panelLight,
			Size = UDim2.new(1, 0, 0, 30),
			Font = Theme.font.medium,
			Text = "",
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(8, 0),
					Size = UDim2.new(1, -80, 1, 0),
					Font = Theme.font.medium,
					Text = row.name .. (row.isAI and "  🤖" or ""),
					TextColor3 = Theme.color.text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -8, 0.5, 0),
					Size = UDim2.fromOffset(64, 30),
					Font = Theme.font.bold,
					Text = "⚙" .. Format.abbrev(row.power),
					TextColor3 = Theme.color.accent,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Right,
				}),
			},
			[Create.Event] = { Activated = function()
				self:_selectTarget(row.id, row.name)
			end },
		})
		btn.Parent = list
	end
end

function DiplomacyController:_refreshInbox(inbox: any)
	local list = self._refs.inbox
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for i, offer in inbox.incoming do
		local isAlliance = offer.kind == "alliance"
		local desc = isAlliance and "Proposes an alliance"
			or ("Gives " .. bagSummary(offer.give) .. "  for  " .. bagSummary(offer.receive))
		local card = Create("Frame", {
			LayoutOrder = i,
			BackgroundColor3 = Theme.color.panelLight,
			Size = UDim2.new(1, 0, 0, 58),
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 5),
					Size = UDim2.new(1, -20, 0, 16),
					Font = Theme.font.bold,
					Text = offer.fromName,
					TextColor3 = Theme.color.text,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 22),
					Size = UDim2.new(1, -20, 0, 14),
					Font = Theme.font.regular,
					Text = desc,
					TextColor3 = Theme.color.textDim,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}),
				Create("TextButton", {
					BackgroundColor3 = Theme.color.good,
					Position = UDim2.fromOffset(10, 38),
					Size = UDim2.fromOffset(70, 16),
					Font = Theme.font.bold,
					Text = "Accept",
					TextColor3 = Theme.color.bg,
					TextSize = 11,
					[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 5) }) },
					[Create.Event] = { Activated = function()
						request(NetRoutes.RESPOND_TRADE, { id = offer.id, accept = true })
					end },
				}),
				Create("TextButton", {
					BackgroundColor3 = Theme.color.bad,
					Position = UDim2.fromOffset(88, 38),
					Size = UDim2.fromOffset(70, 16),
					Font = Theme.font.bold,
					Text = "Decline",
					TextColor3 = Theme.color.bg,
					TextSize = 11,
					[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 5) }) },
					[Create.Event] = { Activated = function()
						request(NetRoutes.RESPOND_TRADE, { id = offer.id, accept = false })
					end },
				}),
			},
		})
		card.Parent = list
	end
end

function DiplomacyController:Start()
	local HudController = require(script.Parent.HudController)
	local WorldStateController = require(script.Parent.WorldStateController)

	self:_build()
	HudController:AddButton("🤝 Diplomacy", function()
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)

	WorldStateController.DirectoryChanged:Connect(function(dir)
		self:_refreshTargets(dir)
	end)
	WorldStateController.InboxChanged:Connect(function(inbox)
		self:_refreshInbox(inbox)
	end)
	self:_refreshTargets(nil)
	self:_refreshInbox(WorldStateController:GetInbox())
end

return DiplomacyController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">EconomyController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/EconomyController.luau
	A statistics dashboard: a live GDP graph (from the replicated gdpHistory), a
	compact financial breakdown, and a contextual advisor that reads the current
	snapshot and surfaces the most useful next moves. Everything is derived on the
	client from data it already has — no extra network traffic.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Format = require(script.Parent.Parent.UI.Format)
local Graph = require(script.Parent.Parent.UI.Graph)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local EconomyController = {
	Name = "EconomyController",
}

EconomyController._panel = nil :: Frame?
EconomyController._update = nil :: ((values: { number }, color: Color3?) -&gt; ())?
EconomyController._caption = nil :: TextLabel?
EconomyController._cells = {} :: { [string]: TextLabel }
EconomyController._advisor = nil :: ScrollingFrame?

-- ---- Advisor rules ---------------------------------------------------------

local function advise(nation: any, stats: any): { { text: string, color: Color3 } }
	local tips = {}
	local function add(color: Color3, text: string)
		table.insert(tips, { text = text, color = color })
	end

	if (stats.powerNet or 0) &lt; 0 then
		add(Theme.color.bad, "⚡ Power deficit — build a Power Plant; buildings are throttled.")
	end
	if (nation.resources.food or 0) &lt; 120 then
		add(Theme.color.warn, "❖ Food is low — build Farms before your people go hungry.")
	end
	if nation.politics.taxRate &gt; 0.4 then
		add(Theme.color.warn, "💸 Taxes are very high — happiness and approval will slide.")
	end
	if nation.population.happiness &lt; 45 then
		add(Theme.color.warn, "🙁 Citizens are unhappy — add Parks/Services or cut taxes.")
	end
	if (stats.unemployment or 0) &gt; 0.2 then
		add(Theme.color.warn, "🧑‍🏭 High unemployment — build Markets or Factories for jobs.")
	end
	if nation.economy.debt &gt; 0 then
		add(Theme.color.warn, ("🏦 In debt (%s) — interest accrues each tick."):format(Format.abbrev(nation.economy.debt)))
	end
	if nation.politics.stability &lt; 40 then
		add(Theme.color.bad, "⚖ Government unstable — raise approval and cut unrest.")
	end
	if not nation.research.current then
		add(Theme.color.accent, "🔬 No active research — pick a technology to advance.")
	end
	if #nation.territory.regions &lt;= 1 and (nation.resources.influence or 0) &gt;= 40 then
		add(Theme.color.accent, "🗺 Spend influence in Territory to claim a region for income.")
	end

	if #tips == 0 then
		add(Theme.color.good, "✅ Your nation is thriving — expand, ally, or climb the ranks.")
	end
	return tips
end

-- ---- Panel -----------------------------------------------------------------

function EconomyController:_cell(key: string, label: string): Frame
	local value = Create("TextLabel", {
		Name = "Value",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 0),
		Size = UDim2.new(0.55, 0, 1, 0),
		Font = Theme.font.bold,
		Text = "-",
		TextColor3 = Theme.color.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
	}) :: TextLabel
	self._cells[key] = value

	return Create("Frame", {
		BackgroundColor3 = Theme.color.panelLight,
		Size = UDim2.new(0.5, -4, 0, 26),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(0.5, 0, 1, 0),
				Font = Theme.font.regular,
				Text = label,
				TextColor3 = Theme.color.textDim,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			value,
		},
	}) :: Frame
end

function EconomyController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local graph, update = Graph.new(UDim2.new(1, -24, 0, 130))
	graph.Position = UDim2.fromOffset(12, 60)
	self._update = update

	local caption = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.new(1, -28, 0, 18),
		Font = Theme.font.medium,
		Text = "GDP over time",
		TextColor3 = Theme.color.textDim,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel
	self._caption = caption

	local grid = Create("Frame", {
		Position = UDim2.fromOffset(12, 200),
		Size = UDim2.new(1, -24, 0, 108),
		BackgroundTransparency = 1,
		[Create.Children] = {
			Create("UIGridLayout", {
				CellSize = UDim2.new(0.5, -4, 0, 26),
				CellPadding = UDim2.fromOffset(8, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		},
	})
	for _, spec in
		{
			{ "income", "Income" },
			{ "expense", "Expense" },
			{ "net", "Net / tick" },
			{ "treasury", "Treasury" },
			{ "debt", "Debt" },
			{ "inflation", "Inflation" },
			{ "unemployment", "Jobless" },
			{ "power", "Power" },
		}
	do
		self:_cell(spec[1], spec[2]).Parent = grid
	end

	local advisor = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 340),
		Size = UDim2.new(1, -24, 1, -350),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	}) :: ScrollingFrame
	self._advisor = advisor

	local panel = Create("Frame", {
		Name = "EconomyPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(380, 500),
		BackgroundColor3 = Theme.color.panel,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "📊 Economy &amp; Advisor",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 318),
				Size = UDim2.new(1, -28, 0, 18),
				Font = Theme.font.bold,
				Text = "Advisor",
				TextColor3 = Theme.color.accent2,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			caption,
			graph,
			grid,
			advisor,
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
end

function EconomyController:_refresh(snapshot: any)
	if not self._panel or not self._panel.Visible then
		return -- only recompute while the panel is open
	end
	if not snapshot or not snapshot.nation then
		return
	end
	local nation = snapshot.nation
	local stats = snapshot.stats or {}

	local history = nation.economy.gdpHistory or {}
	if self._update then
		self._update(history, Theme.color.accent)
	end
	if self._caption then
		local peak = 0
		for _, v in history do
			peak = math.max(peak, v)
		end
		self._caption.Text = ("GDP — now %s · peak %s"):format(
			Format.abbrev(nation.economy.gdp),
			Format.abbrev(peak)
		)
	end

	local set = function(key: string, text: string, color: Color3?)
		local label = self._cells[key]
		if label then
			label.Text = text
			label.TextColor3 = color or Theme.color.text
		end
	end
	local net = stats.net or (nation.economy.lastTickIncome - nation.economy.lastTickExpense)
	set("income", Format.abbrev(stats.income or nation.economy.lastTickIncome), Theme.color.good)
	set("expense", Format.abbrev(stats.expense or nation.economy.lastTickExpense), Theme.color.warn)
	set("net", Format.signed(net), net &gt;= 0 and Theme.color.good or Theme.color.bad)
	set("treasury", Format.abbrev(nation.resources.money))
	set("debt", Format.abbrev(nation.economy.debt), nation.economy.debt &gt; 0 and Theme.color.warn or Theme.color.text)
	set("inflation", ("%.1f%%"):format(nation.economy.inflation))
	set("unemployment", Format.percent(stats.unemployment or 0))
	set("power", Format.signed(stats.powerNet or nation.resources.energy or 0),
		(stats.powerNet or 0) &gt;= 0 and Theme.color.good or Theme.color.bad)

	local advisor = self._advisor
	if advisor then
		for _, child in advisor:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for i, tip in advise(nation, stats) do
			Create("Frame", {
				LayoutOrder = i,
				BackgroundColor3 = Theme.color.panelLight,
				Size = UDim2.new(1, 0, 0, 34),
				AutomaticSize = Enum.AutomaticSize.Y,
				[Create.Children] = {
					Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
					Create("Frame", {
						BackgroundColor3 = tip.color,
						Size = UDim2.new(0, 3, 1, -8),
						Position = UDim2.fromOffset(6, 4),
						[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 2) }) },
					}),
					Create("TextLabel", {
						BackgroundTransparency = 1,
						Position = UDim2.fromOffset(16, 4),
						Size = UDim2.new(1, -22, 1, -8),
						Font = Theme.font.medium,
						Text = tip.text,
						TextColor3 = Theme.color.text,
						TextSize = 12,
						TextWrapped = true,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						AutomaticSize = Enum.AutomaticSize.Y,
					}),
				},
			}).Parent = advisor
		end
	end
end

function EconomyController:Start()
	local HudController = require(script.Parent.HudController)
	local StateController = require(script.Parent.StateController)

	self:_build()
	HudController:AddButton("📊 Economy", function()
		if self._panel then
			Motion.toggle(self._panel)
			self:_refresh(StateController:GetSnapshot() or { nation = StateController:GetNation() })
		end
	end)

	StateController.Changed:Connect(function(snapshot)
		self:_refresh(snapshot)
	end)
end

return EconomyController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">HudController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/HudController.luau
	The persistent HUD: a top resource bar, a compact national-stats panel, and a
	bottom action bar that other controllers hang their panel-toggle buttons on.

	HudController owns the root ScreenGui and exposes it (GetGui) plus AddButton so
	the Build/Politics/Research controllers can attach to a consistent chrome
	without HudController needing to know they exist.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Nexus.Constants)
local Resources = require(ReplicatedStorage.Nexus.Config.Resources)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Format = require(script.Parent.Parent.UI.Format)
local Theme = require(script.Parent.Parent.UI.Theme)

local HudController = {
	Name = "HudController",
}

HudController._gui = nil :: ScreenGui?
HudController._chips = {} :: { [string]: TextLabel }
HudController._stats = {} :: { [string]: TextLabel }
HudController._nameLabel = nil :: TextLabel?
HudController._buttonBar = nil :: ScrollingFrame?

-- ---- Builders -------------------------------------------------------------

local function resourceChip(resourceId: string): (Frame, TextLabel)
	local meta = Resources[resourceId]
	local color = Color3.new(meta.color[1], meta.color[2], meta.color[3])

	local valueLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.fromOffset(28, 0),
		Font = Theme.font.bold,
		Text = "0",
		TextColor3 = Theme.color.text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel

	local chip = Create("Frame", {
		BackgroundColor3 = Theme.color.panelLight,
		Size = UDim2.fromOffset(108, 34),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(24, 34),
				Position = UDim2.fromOffset(6, 0),
				Font = Theme.font.bold,
				Text = meta.symbol,
				TextColor3 = color,
				TextSize = 16,
			}),
			valueLabel,
		},
	}) :: Frame
	Decor.gradient(chip, Theme.gradient.chip)

	return chip, valueLabel
end

local function statRow(label: string): (Frame, TextLabel)
	local valueLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		Font = Theme.font.bold,
		Text = "-",
		TextColor3 = Theme.color.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
	}) :: TextLabel

	local row = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		[Create.Children] = {
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(0.5, 0, 1, 0),
				Font = Theme.font.regular,
				Text = label,
				TextColor3 = Theme.color.textDim,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			valueLabel,
		},
	}) :: Frame

	return row, valueLabel
end

-- ---- Public API -----------------------------------------------------------

function HudController:GetGui(): ScreenGui
	return assert(self._gui, "HUD gui not built yet")
end

--- Add a toggle button to the bottom action bar. Returns the button.
function HudController:AddButton(text: string, onClick: () -&gt; ()): TextButton
	local bar = assert(self._buttonBar, "button bar not built")
	local button = Create("TextButton", {
		AutoButtonColor = true,
		BackgroundColor3 = Theme.color.panelLight,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 44),
		Font = Theme.font.bold,
		Text = text,
		TextColor3 = Theme.color.text,
		TextSize = 15,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }),
			Create("UISizeConstraint", { MinSize = Vector2.new(96, 44) }),
		},
		[Create.Event] = { Activated = onClick },
	}) :: TextButton
	Decor.gradient(button, Theme.gradient.chip)
	button.Parent = bar
	return button
end

-- ---- Lifecycle ------------------------------------------------------------

function HudController:Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = Create("ScreenGui", {
		Name = "NexusHUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
	}) :: ScreenGui

	-- Top resource bar.
	local chipRow = Create("Frame", {
		BackgroundColor3 = Theme.color.bg,
		BackgroundTransparency = 0.15,
		Size = UDim2.new(1, 0, 0, 50),
		[Create.Children] = {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
			Create("UIPadding", { PaddingLeft = UDim.new(0, 96), PaddingRight = UDim.new(0, 8) }),
		},
	})
	Decor.gradient(chipRow, Theme.gradient.topbar)
	Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1, Transparency = 0.4 }).Parent = chipRow
	chipRow.Parent = gui

	-- Wordmark in the top-left corner.
	Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.fromOffset(90, 50),
		Font = Theme.font.black,
		Text = "◆ NEXUS",
		TextColor3 = Theme.color.accent,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
	}).Parent = gui

	for _, resourceId in Constants.RESOURCE_ORDER do
		local chip, label = resourceChip(resourceId)
		chip.Parent = chipRow
		self._chips[resourceId] = label
	end

	-- Left stats panel.
	local statsPanel = Create("Frame", {
		BackgroundColor3 = Theme.color.panel,
		BackgroundTransparency = 0.1,
		Position = UDim2.fromOffset(16, 66),
		Size = UDim2.fromOffset(224, 252),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("UIPadding", {
				PaddingTop = UDim.new(0, 10),
				PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 12),
			}),
			Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	})
	Decor.gradient(statsPanel, Theme.gradient.panel)

	self._nameLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24),
		Font = Theme.font.bold,
		Text = "My Nation",
		TextColor3 = Theme.color.accent,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel
	self._nameLabel.Parent = statsPanel

	local statOrder = {
		{ key = "population", label = "Population" },
		{ key = "happiness", label = "Happiness" },
		{ key = "approval", label = "Approval" },
		{ key = "stability", label = "Stability" },
		{ key = "gdp", label = "GDP / tick" },
		{ key = "net", label = "Budget / tick" },
		{ key = "debt", label = "Debt" },
		{ key = "power", label = "Power" },
	}
	for _, entry in statOrder do
		local row, value = statRow(entry.label)
		row.Parent = statsPanel
		self._stats[entry.key] = value
	end
	statsPanel.Parent = gui

	-- Bottom action bar — a horizontal scroller so any number of buttons fits,
	-- even on narrow mobile screens.
	self._buttonBar = Create("ScrollingFrame", {
		Name = "ActionBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, -32, 0, 48),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		[Create.Children] = {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		},
	}) :: ScrollingFrame
	self._buttonBar.Parent = gui

	gui.Parent = playerGui
	self._gui = gui
end

function HudController:_refresh(snapshot: any)
	local nation = snapshot.nation
	local stats = snapshot.stats or {}
	local res = nation.resources

	for resourceId, label in self._chips do
		local value = res[resourceId] or 0
		if resourceId == "energy" then
			label.Text = Format.signed(value)
			label.TextColor3 = value &gt;= 0 and Theme.color.good or Theme.color.bad
		else
			label.Text = Format.abbrev(value)
		end
	end

	if self._nameLabel then
		self._nameLabel.Text = nation.name
	end

	local set = function(key: string, text: string, color: Color3?)
		local label = self._stats[key]
		if label then
			label.Text = text
			if color then
				label.TextColor3 = color
			end
		end
	end

	set("population", Format.abbrev(nation.population.total))
	set(
		"happiness",
		Format.round(nation.population.happiness) .. "%",
		nation.population.happiness &gt;= 50 and Theme.color.good or Theme.color.warn
	)
	set("approval", Format.round(nation.politics.approval) .. "%")
	set("stability", Format.round(nation.politics.stability) .. "%",
		nation.politics.stability &gt;= 40 and Theme.color.text or Theme.color.bad)
	set("gdp", Format.abbrev(stats.gdp or nation.economy.gdp))
	set(
		"net",
		Format.signed(stats.net or 0),
		(stats.net or 0) &gt;= 0 and Theme.color.good or Theme.color.bad
	)
	set("debt", Format.abbrev(nation.economy.debt), nation.economy.debt &gt; 0 and Theme.color.warn or Theme.color.text)
	set(
		"power",
		Format.signed(stats.powerNet or res.energy or 0),
		(stats.powerNet or 0) &gt;= 0 and Theme.color.good or Theme.color.bad
	)
end

function HudController:Start()
	local StateController = require(script.Parent.StateController)
	StateController.Changed:Connect(function(snapshot)
		self:_refresh(snapshot)
	end)
	if StateController:IsReady() then
		self:_refresh(StateController:GetSnapshot())
	end
end

return HudController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000050"><Properties><string name="Name">LeaderboardController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/LeaderboardController.luau
	A ranked table of every nation in the world (players and AI) by power score.
	Rebuilds from the WORLD_SYNC directory; the local player's row is highlighted.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(script.Parent.Parent.UI.Format)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local LeaderboardController = {
	Name = "LeaderboardController",
}

LeaderboardController._panel = nil :: Frame?
LeaderboardController._list = nil :: ScrollingFrame?

function LeaderboardController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local list = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(10, 42),
		Size = UDim2.new(1, -20, 1, -52),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	}) :: ScrollingFrame
	self._list = list

	local panel = Create("Frame", {
		Name = "LeaderboardPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 460),
		BackgroundColor3 = Theme.color.panel,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "🏆 Global Leaderboard",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			list,
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
end

function LeaderboardController:_refresh(directory: { any })
	local list = self._list
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") or child:IsA("Frame") then
			child:Destroy()
		end
	end
	local myId = Players.LocalPlayer.UserId
	for _, row in directory do
		local mine = row.id == myId
		local rowFrame = Create("Frame", {
			LayoutOrder = row.rank,
			BackgroundColor3 = mine and Theme.color.accentDim or Theme.color.panelLight,
			Size = UDim2.new(1, 0, 0, 40),
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.fromOffset(34, 40),
					Font = Theme.font.black,
					Text = "#" .. row.rank,
					TextColor3 = row.rank &lt;= 3 and Theme.color.accent2 or Theme.color.textDim,
					TextSize = 15,
				}),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(48, 4),
					Size = UDim2.new(1, -140, 0, 18),
					Font = Theme.font.bold,
					Text = row.name .. (row.isAI and "  🤖" or ""),
					TextColor3 = Theme.color.text,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(48, 22),
					Size = UDim2.new(1, -140, 0, 14),
					Font = Theme.font.regular,
					Text = ("Pop %s · GDP %s"):format(Format.abbrev(row.population), Format.abbrev(row.gdp)),
					TextColor3 = Theme.color.textDim,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12, 0.5, 0),
					Size = UDim2.fromOffset(80, 40),
					Font = Theme.font.bold,
					Text = "⚙ " .. Format.abbrev(row.power),
					TextColor3 = Theme.color.accent,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Right,
				}),
			},
		})
		rowFrame.Parent = list
	end
end

function LeaderboardController:Start()
	local HudController = require(script.Parent.HudController)
	local WorldStateController = require(script.Parent.WorldStateController)

	self:_build()
	HudController:AddButton("🏆 Ranks", function()
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)

	WorldStateController.DirectoryChanged:Connect(function(directory)
		self:_refresh(directory)
	end)
	self:_refresh(WorldStateController:GetDirectory())
end

return LeaderboardController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000051"><Properties><string name="Name">MarketController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/MarketController.luau
	The global commodity market screen: live prices with trend arrows and
	buy/sell controls at a chosen quantity. Prices arrive via MARKET_SYNC; every
	trade is a validated server request.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Market = require(ReplicatedStorage.Nexus.Config.Market)
local Resources = require(ReplicatedStorage.Nexus.Config.Resources)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local QUANTITIES = { 10, 50, 200, 1000 }

local MarketController = {
	Name = "MarketController",
}

MarketController._panel = nil :: Frame?
MarketController._rows = {} :: { [string]: any }
MarketController._qtyIndex = 2
MarketController._qtyButton = nil :: TextButton?

local function request(route: string, resource: string, amount: number)
	task.spawn(function()
		Net.request(route, { resource = resource, amount = amount })
	end)
end

function MarketController:_qty(): number
	return QUANTITIES[self._qtyIndex]
end

function MarketController:_row(res: string, order: number): Frame
	local meta = Resources[res]
	local color = Color3.new(meta.color[1], meta.color[2], meta.color[3])

	local price = Create("TextLabel", {
		Name = "Price",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(146, 0),
		Size = UDim2.fromOffset(58, 48),
		Font = Theme.font.bold,
		Text = "$-",
		TextColor3 = Theme.color.text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel

	local function tradeButton(text: string, c: Color3, x: number, route: string): TextButton
		return Create("TextButton", {
			BackgroundColor3 = c,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(54, 32),
			Font = Theme.font.bold,
			Text = text,
			TextColor3 = Theme.color.bg,
			TextSize = 13,
			[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) },
			[Create.Event] = { Activated = function()
				request(route, res, self:_qty())
			end },
		}) :: TextButton
	end

	local row = Create("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = Theme.color.panelLight,
		Size = UDim2.new(1, 0, 0, 48),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.fromOffset(24, 48),
				Font = Theme.font.bold,
				Text = meta.symbol,
				TextColor3 = color,
				TextSize = 18,
			}),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(38, 0),
				Size = UDim2.fromOffset(110, 48),
				Font = Theme.font.medium,
				Text = meta.displayName,
				TextColor3 = Theme.color.text,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			price,
			Create("TextLabel", {
				Name = "Trend",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(206, 0),
				Size = UDim2.fromOffset(26, 48),
				Font = Theme.font.bold,
				Text = "–",
				TextColor3 = Theme.color.textDim,
				TextSize = 16,
			}),
			tradeButton("Buy", Theme.color.good, -64, NetRoutes.MARKET_BUY),
			tradeButton("Sell", Theme.color.warn, -6, NetRoutes.MARKET_SELL),
		},
	}) :: Frame

	self._rows[res] = { row = row, price = price, trend = row:FindFirstChild("Trend") }
	return row
end

function MarketController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local list = Create("Frame", {
		Position = UDim2.fromOffset(12, 78),
		Size = UDim2.new(1, -24, 0, 216),
		BackgroundTransparency = 1,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	})
	for i, res in Market.order do
		self:_row(res, i).Parent = list
	end

	self._qtyButton = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 40),
		Size = UDim2.fromOffset(130, 30),
		BackgroundColor3 = Theme.color.accentDim,
		Font = Theme.font.bold,
		Text = "Qty: 50",
		TextColor3 = Theme.color.text,
		TextSize = 14,
		[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 8) }) },
		[Create.Event] = { Activated = function()
			self._qtyIndex = (self._qtyIndex % #QUANTITIES) + 1
			if self._qtyButton then
				self._qtyButton.Text = "Qty: " .. self:_qty()
			end
		end },
	}) :: TextButton

	local panel = Create("Frame", {
		Name = "MarketPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(380, 320),
		BackgroundColor3 = Theme.color.panel,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "💱 Global Market",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 44),
				Size = UDim2.fromOffset(200, 22),
				Font = Theme.font.regular,
				Text = "Prices move with supply &amp; demand",
				TextColor3 = Theme.color.textDim,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			self._qtyButton,
			list,
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
end

function MarketController:_refresh(rows: { any })
	for _, entry in rows do
		local ref = self._rows[entry.id]
		if ref then
			ref.price.Text = ("$%.1f"):format(entry.price)
			local trend = ref.trend :: TextLabel
			if entry.price &gt; entry.prev + 0.001 then
				trend.Text = "▲"
				trend.TextColor3 = Theme.color.good
			elseif entry.price &lt; entry.prev - 0.001 then
				trend.Text = "▼"
				trend.TextColor3 = Theme.color.bad
			else
				trend.Text = "–"
				trend.TextColor3 = Theme.color.textDim
			end
			-- Tint the price by how it compares to its baseline.
			ref.price.TextColor3 = entry.price &gt;= entry.base and Theme.color.text or Theme.color.good
		end
	end
end

function MarketController:Start()
	local HudController = require(script.Parent.HudController)

	self:_build()
	HudController:AddButton("💱 Market", function()
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)

	Net.onEvent(NetRoutes.MARKET_SYNC, function(rows)
		if typeof(rows) == "table" then
			self:_refresh(rows)
		end
	end)
end

return MarketController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><string name="Name">MilitaryController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/MilitaryController.luau
	The (optional) armed-forces panel: recruit and disband army, navy and air
	units, see their cost, upkeep and your total strength. Hidden entirely when
	ServerSettings.militaryEnabled is false. Higher tiers show as locked until the
	matching military technology is researched.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local MilitaryUnits = require(ReplicatedStorage.Nexus.Config.MilitaryUnits)
local Resources = require(ReplicatedStorage.Nexus.Config.Resources)
local ServerSettings = require(ReplicatedStorage.Nexus.Config.ServerSettings)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Format = require(script.Parent.Parent.UI.Format)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local ORDER = { "army", "navy", "air" }

local MilitaryController = {
	Name = "MilitaryController",
}

MilitaryController._panel = nil :: Frame?
MilitaryController._rows = {} :: { [string]: Frame }
MilitaryController._strengthLabel = nil :: TextLabel?

local function request(route: string, branch: string, count: number)
	task.spawn(function()
		Net.request(route, { branch = branch, count = count })
	end)
end

local function costText(branch: string): string
	local parts = {}
	for id, amount in MilitaryUnits[branch].cost do
		table.insert(parts, Resources[id].symbol .. Format.abbrev(amount))
	end
	return table.concat(parts, " ")
end

function MilitaryController:_row(branch: string, order: number): Frame
	local def = MilitaryUnits[branch]
	local function miniButton(text: string, x: number, color: Color3, onClick: () -&gt; ()): TextButton
		return Create("TextButton", {
			BackgroundColor3 = color,
			Position = UDim2.fromOffset(x, 44),
			Size = UDim2.fromOffset(70, 22),
			Font = Theme.font.bold,
			Text = text,
			TextColor3 = Theme.color.text,
			TextSize = 11,
			[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) },
			[Create.Event] = { Activated = onClick },
		}) :: TextButton
	end

	local row = Create("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = Theme.color.panelLight,
		Size = UDim2.new(1, 0, 0, 74),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("TextLabel", {
				Name = "Title",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 6),
				Size = UDim2.new(1, -20, 0, 18),
				Font = Theme.font.bold,
				Text = def.displayName,
				TextColor3 = Theme.color.text,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextLabel", {
				Name = "Sub",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 24),
				Size = UDim2.new(1, -20, 0, 16),
				Font = Theme.font.regular,
				Text = ("Cost %s · upkeep $%d · str %d"):format(costText(branch), def.upkeep, def.strength),
				TextColor3 = Theme.color.textDim,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextLabel", {
				Name = "Count",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 6),
				Size = UDim2.fromOffset(60, 18),
				Font = Theme.font.black,
				Text = "0",
				TextColor3 = Theme.color.accent,
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Right,
			}),
			miniButton("＋1", 10, Theme.color.accentDim, function()
				request(NetRoutes.RECRUIT_UNITS, branch, 1)
			end),
			miniButton("＋5", 86, Theme.color.accentDim, function()
				request(NetRoutes.RECRUIT_UNITS, branch, 5)
			end),
			miniButton("－1", 162, Color3.fromRGB(120, 50, 50), function()
				request(NetRoutes.DISBAND_UNITS, branch, 1)
			end),
		},
	}) :: Frame
	return row
end

function MilitaryController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local content = Create("Frame", {
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 0, 240),
		BackgroundTransparency = 1,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	})
	for i, branch in ORDER do
		local row = self:_row(branch, i)
		row.Parent = content
		self._rows[branch] = row
	end

	self._strengthLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 38),
		Size = UDim2.new(1, -28, 0, 22),
		Font = Theme.font.bold,
		Text = "Total strength: 0",
		TextColor3 = Theme.color.accent2,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel

	local panel = Create("Frame", {
		Name = "MilitaryPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 336),
		BackgroundColor3 = Theme.color.panel,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "⚔ Armed Forces",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			self._strengthLabel,
			content,
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
end

function MilitaryController:_refresh()
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	if not nation then
		return
	end
	local strength = 0
	for branch, row in self._rows do
		local def = MilitaryUnits[branch]
		local count = nation.military[branch] or 0
		strength += count * def.strength
		local countLabel = row:FindFirstChild("Count") :: TextLabel
		countLabel.Text = tostring(count)
		local sub = row:FindFirstChild("Sub") :: TextLabel
		if def.requiresTech and not nation.research.unlocked[def.requiresTech] then
			sub.Text = "🔒 Requires " .. def.requiresTech
			sub.TextColor3 = Theme.color.bad
		else
			sub.Text = ("Cost %s · upkeep $%d · str %d"):format(costText(branch), def.upkeep, def.strength)
			sub.TextColor3 = Theme.color.textDim
		end
	end
	if self._strengthLabel then
		self._strengthLabel.Text = "Total strength: " .. strength
	end
end

function MilitaryController:Start()
	if not ServerSettings.militaryEnabled then
		return -- military disabled on this server: no panel, no button
	end
	local HudController = require(script.Parent.HudController)
	local StateController = require(script.Parent.StateController)

	self:_build()
	HudController:AddButton("⚔ Military", function()
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)
	StateController.Changed:Connect(function()
		self:_refresh()
	end)
	if StateController:IsReady() then
		self:_refresh()
	end
end

return MilitaryController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000053"><Properties><string name="Name">NotificationController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/NotificationController.luau
	Renders transient server notifications as stacked toasts in the top-right.
	Each toast is colour-coded by severity, slides in, and dismisses itself.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Theme = require(script.Parent.Parent.UI.Theme)

local NotificationController = {
	Name = "NotificationController",
}

NotificationController._container = nil :: Frame?

local function buildToast(severity: string, title: string, body: string?): Frame
	local color = Theme.severityColor[severity] or Theme.color.accent

	local toast = Create("Frame", {
		BackgroundColor3 = Theme.color.panel,
		BackgroundTransparency = 0.05,
		Size = UDim2.new(1, 0, 0, body and 58 or 40),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1, Transparency = 0.3 }),
			Create("Frame", {
				BackgroundColor3 = color,
				Size = UDim2.new(0, 4, 1, -12),
				Position = UDim2.fromOffset(8, 6),
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 2) }) },
			}),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(20, 6),
				Size = UDim2.new(1, -28, 0, 18),
				Font = Theme.font.bold,
				Text = title,
				TextColor3 = Theme.color.text,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			body and Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(20, 26),
				Size = UDim2.new(1, -28, 0, 26),
				Font = Theme.font.regular,
				Text = body,
				TextColor3 = Theme.color.textDim,
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			}) or nil,
		},
	}) :: Frame
	Decor.gradient(toast, Theme.gradient.panel)

	return toast
end

function NotificationController:Show(severity: string, title: string, body: string?)
	local container = self._container
	if not container then
		return
	end
	local toast = buildToast(severity, title, body)
	toast.Position = UDim2.new(1, 20, 0, 0)
	toast.Parent = container

	TweenService:Create(toast, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
		Position = UDim2.fromOffset(0, 0),
	}):Play()

	task.delay(4, function()
		if not toast.Parent then
			return
		end
		local tween = TweenService:Create(toast, TweenInfo.new(0.3), {
			Position = UDim2.new(1, 20, 0, 0),
			BackgroundTransparency = 1,
		})
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)
end

function NotificationController:Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = Create("ScreenGui", {
		Name = "NexusNotifications",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = 50,
	})

	self._container = Create("Frame", {
		Name = "Container",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 70),
		Size = UDim2.new(0, 300, 1, -90),
		BackgroundTransparency = 1,
		[Create.Children] = {
			Create("UIListLayout", {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				VerticalAlignment = Enum.VerticalAlignment.Top,
			}),
		},
	}) :: Frame
	self._container.Parent = gui
	gui.Parent = playerGui
end

function NotificationController:Start()
	Net.onEvent(NetRoutes.NOTIFY, function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		self:Show(payload.severity or "info", tostring(payload.title or ""), payload.body)
	end)
end

return NotificationController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000054"><Properties><string name="Name">PoliticsController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/PoliticsController.luau
	The governance panel: adjust the tax rate, switch government type, and
	enact/repeal laws. Reads the live snapshot to reflect the current regime and
	which laws are active or unavailable, and sends validated requests to the
	server for every change.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Governments = require(ReplicatedStorage.Nexus.Config.Governments)
local Laws = require(ReplicatedStorage.Nexus.Config.Laws)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local PoliticsController = {
	Name = "PoliticsController",
}

PoliticsController._panel = nil :: Frame?
PoliticsController._taxLabel = nil :: TextLabel?
PoliticsController._govButtons = {} :: { [string]: TextButton }
PoliticsController._lawButtons = {} :: { [string]: TextButton }

local function request(route: string, payload: any)
	task.spawn(function()
		Net.request(route, payload)
	end)
end

local function sectionLabel(text: string, order: number): TextLabel
	return Create("TextLabel", {
		LayoutOrder = order,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22),
		Font = Theme.font.bold,
		Text = text,
		TextColor3 = Theme.color.accent,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel
end

function PoliticsController:_adjustTax(delta: number)
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	if not nation then
		return
	end
	local rate = math.clamp(nation.politics.taxRate + delta, 0, 1)
	request(NetRoutes.SET_TAX_RATE, { rate = rate })
end

function PoliticsController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local content = Create("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(10, 42),
		Size = UDim2.new(1, -20, 1, -52),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	}) :: ScrollingFrame

	-- Tax section.
	sectionLabel("Taxation", 1).Parent = content
	local taxRow = Create("Frame", {
		LayoutOrder = 2,
		BackgroundColor3 = Theme.color.panelLight,
		Size = UDim2.new(1, 0, 0, 44),
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("TextButton", {
				Text = "−",
				Font = Theme.font.bold,
				TextSize = 22,
				TextColor3 = Theme.color.text,
				BackgroundColor3 = Theme.color.accentDim,
				Size = UDim2.fromOffset(40, 32),
				Position = UDim2.fromOffset(8, 6),
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) },
				[Create.Event] = { Activated = function()
					self:_adjustTax(-0.05)
				end },
			}),
			Create("TextButton", {
				Text = "+",
				Font = Theme.font.bold,
				TextSize = 22,
				TextColor3 = Theme.color.text,
				BackgroundColor3 = Theme.color.accentDim,
				Size = UDim2.fromOffset(40, 32),
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -8, 0, 6),
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) },
				[Create.Event] = { Activated = function()
					self:_adjustTax(0.05)
				end },
			}),
			Create("TextLabel", {
				Name = "TaxValue",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -100, 1, 0),
				Position = UDim2.fromOffset(50, 0),
				Font = Theme.font.bold,
				Text = "Tax: 15%",
				TextColor3 = Theme.color.text,
				TextSize = 16,
			}),
		},
	}) :: Frame
	taxRow.Parent = content
	self._taxLabel = taxRow:FindFirstChild("TaxValue") :: TextLabel

	-- Government section.
	sectionLabel("Government", 3).Parent = content
	local govOrder = 4
	for id, def in Governments do
		local btn = Create("TextButton", {
			LayoutOrder = govOrder,
			BackgroundColor3 = Theme.color.panelLight,
			Size = UDim2.new(1, 0, 0, 40),
			Text = "",
			AutoButtonColor = true,
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -16, 1, 0),
					Font = Theme.font.medium,
					Text = def.displayName,
					TextColor3 = Theme.color.text,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
			},
			[Create.Event] = { Activated = function()
				request(NetRoutes.SET_GOVERNMENT, { government = id })
			end },
		}) :: TextButton
		btn.Parent = content
		self._govButtons[id] = btn
		govOrder += 1
	end

	-- Laws section.
	sectionLabel("Laws", 100).Parent = content
	local lawOrder = 101
	for id, def in Laws do
		local btn = Create("TextButton", {
			LayoutOrder = lawOrder,
			BackgroundColor3 = Theme.color.panelLight,
			Size = UDim2.new(1, 0, 0, 46),
			Text = "",
			AutoButtonColor = true,
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 5),
					Size = UDim2.new(1, -16, 0, 18),
					Font = Theme.font.medium,
					Text = def.displayName,
					TextColor3 = Theme.color.text,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 24),
					Size = UDim2.new(1, -16, 0, 16),
					Font = Theme.font.regular,
					Text = def.description,
					TextColor3 = Theme.color.textDim,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}),
			},
			[Create.Event] = { Activated = function()
				request(NetRoutes.TOGGLE_LAW, { id = id })
			end },
		}) :: TextButton
		btn.Parent = content
		self._lawButtons[id] = btn
		lawOrder += 1
	end

	local panel = Create("Frame", {
		Name = "PoliticsPanel",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.fromOffset(280, 460),
		BackgroundColor3 = Theme.color.panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "Government",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			content,
		},
	}) :: Frame
	-- Anchor the panel vertically centred but below the stats panel visually.
	panel.Position = UDim2.new(0, 16, 0.5, 20)
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
end

function PoliticsController:_refresh()
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	if not nation then
		return
	end
	if self._taxLabel then
		self._taxLabel.Text = ("Tax: %d%%"):format(math.floor(nation.politics.taxRate * 100 + 0.5))
	end
	for id, btn in self._govButtons do
		local current = nation.politics.government == id
		btn.BackgroundColor3 = current and Theme.color.accentDim or Theme.color.panelLight
	end
	for id, btn in self._lawButtons do
		local active = nation.politics.activeLaws[id] == true
		local def = Laws[id]
		local locked = def.requiresTech ~= nil and not nation.research.unlocked[def.requiresTech]
		local forbidden = table.find(def.forbiddenGovernments, nation.politics.government) ~= nil
		if active then
			btn.BackgroundColor3 = Theme.color.accentDim
		elseif locked or forbidden then
			btn.BackgroundColor3 = Theme.color.bg
		else
			btn.BackgroundColor3 = Theme.color.panelLight
		end
	end
end

function PoliticsController:Start()
	local HudController = require(script.Parent.HudController)
	local StateController = require(script.Parent.StateController)

	self:_build()
	HudController:AddButton("🏛 Politics", function()
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)

	StateController.Changed:Connect(function()
		self:_refresh()
	end)
	if StateController:IsReady() then
		self:_refresh()
	end
end

return PoliticsController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000055"><Properties><string name="Name">ResearchController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/ResearchController.luau
	The technology panel. Lists every tech grouped by branch with a live status —
	researched, in-progress (with a progress bar), available, or locked behind
	prerequisites — and lets the player commit research to an available tech.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Technologies = require(ReplicatedStorage.Nexus.Config.Technologies)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Format = require(script.Parent.Parent.UI.Format)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local ResearchController = {
	Name = "ResearchController",
}

ResearchController._panel = nil :: Frame?
ResearchController._rows = {} :: { [string]: Frame }

local function prereqsMet(nation: any, def: any): boolean
	for _, req in def.requires do
		if not nation.research.unlocked[req] then
			return false
		end
	end
	return true
end

function ResearchController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local content = Create("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(10, 42),
		Size = UDim2.new(1, -20, 1, -52),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Create.Children] = {
			Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	}) :: ScrollingFrame

	-- Stable order: branch then cost.
	local order = {}
	for id in Technologies do
		table.insert(order, id)
	end
	table.sort(order, function(a, b)
		local da, db = Technologies[a], Technologies[b]
		if da.branch ~= db.branch then
			return da.branch &lt; db.branch
		end
		return da.cost &lt; db.cost
	end)

	for i, id in order do
		local def = Technologies[id]
		local row = Create("TextButton", {
			LayoutOrder = i,
			BackgroundColor3 = Theme.color.panelLight,
			Size = UDim2.new(1, 0, 0, 58),
			Text = "",
			AutoButtonColor = true,
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				Create("TextLabel", {
					Name = "Name",
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 6),
					Size = UDim2.new(1, -80, 0, 18),
					Font = Theme.font.bold,
					Text = def.displayName,
					TextColor3 = Theme.color.text,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
				Create("TextLabel", {
					Name = "Desc",
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 24),
					Size = UDim2.new(1, -80, 0, 16),
					Font = Theme.font.regular,
					Text = def.description,
					TextColor3 = Theme.color.textDim,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}),
				Create("TextLabel", {
					Name = "Status",
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -10, 0, 6),
					Size = UDim2.fromOffset(70, 18),
					Font = Theme.font.bold,
					Text = "✦" .. Format.abbrev(def.cost),
					TextColor3 = Theme.color.accent,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Right,
				}),
				-- Progress bar (shown only for the active tech).
				Create("Frame", {
					Name = "Bar",
					BackgroundColor3 = Theme.color.bg,
					Position = UDim2.fromOffset(10, 46),
					Size = UDim2.new(1, -20, 0, 5),
					Visible = false,
					[Create.Children] = {
						Create("UICorner", { CornerRadius = UDim.new(0, 3) }),
						Create("Frame", {
							Name = "Fill",
							BackgroundColor3 = Theme.color.accent,
							Size = UDim2.new(0, 0, 1, 0),
							[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 3) }) },
						}),
					},
				}),
			},
			[Create.Event] = { Activated = function()
				self:_onClick(id)
			end },
		}) :: Frame
		row.Parent = content
		self._rows[id] = row
	end

	local panel = Create("Frame", {
		Name = "ResearchPanel",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 20),
		Size = UDim2.fromOffset(300, 460),
		BackgroundColor3 = Theme.color.panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -28, 0, 22),
				Font = Theme.font.bold,
				Text = "Technology",
				TextColor3 = Theme.color.text,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			content,
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
end

function ResearchController:_onClick(id: string)
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	if not nation then
		return
	end
	local def = Technologies[id]
	if nation.research.unlocked[id] then
		return
	end
	if not prereqsMet(nation, def) then
		local Notif = require(script.Parent.NotificationController)
		Notif:Show("warning", "Locked", "Complete prerequisite research first.")
		return
	end
	task.spawn(function()
		Net.request(NetRoutes.START_RESEARCH, { id = id })
	end)
end

function ResearchController:_refresh()
	local StateController = require(script.Parent.StateController)
	local nation = StateController:GetNation()
	if not nation then
		return
	end
	for id, row in self._rows do
		local def = Technologies[id]
		local status = row:FindFirstChild("Status") :: TextLabel
		local bar = row:FindFirstChild("Bar") :: Frame
		local fill = bar:FindFirstChild("Fill") :: Frame

		if nation.research.unlocked[id] then
			row.BackgroundColor3 = Color3.fromRGB(34, 54, 40)
			status.Text = "✓ Done"
			status.TextColor3 = Theme.color.good
			bar.Visible = false
		elseif nation.research.current == id then
			row.BackgroundColor3 = Theme.color.accentDim
			local pct = math.clamp(nation.research.progress / def.cost, 0, 1)
			status.Text = ("%d%%"):format(math.floor(pct * 100 + 0.5))
			status.TextColor3 = Theme.color.text
			bar.Visible = true
			fill.Size = UDim2.new(pct, 0, 1, 0)
		elseif prereqsMet(nation, def) then
			row.BackgroundColor3 = Theme.color.panelLight
			status.Text = "✦" .. Format.abbrev(def.cost)
			status.TextColor3 = Theme.color.accent
			bar.Visible = false
		else
			row.BackgroundColor3 = Theme.color.bg
			status.Text = "🔒"
			status.TextColor3 = Theme.color.textDim
			bar.Visible = false
		end
	end
end

function ResearchController:Start()
	local HudController = require(script.Parent.HudController)
	local StateController = require(script.Parent.StateController)

	self:_build()
	HudController:AddButton("🔬 Research", function()
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)

	StateController.Changed:Connect(function()
		self:_refresh()
	end)
	if StateController:IsReady() then
		self:_refresh()
	end
end

return ResearchController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000056"><Properties><string name="Name">StateController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/StateController.luau
	The client's single source of truth for replicated nation state. It listens
	for STATE_SYNC snapshots, stores the latest, and fires a Changed signal that
	every panel subscribes to. No other controller talks to the sync route
	directly, so there is exactly one place the UI's data model updates.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Logger = require(ReplicatedStorage.Nexus.Logger)
local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Signal = require(ReplicatedStorage.Nexus.Signal)
local Types = require(ReplicatedStorage.Nexus.Types)

type Nation = Types.Nation

local log = Logger.new("StateController")

local StateController = {
	Name = "StateController",
	Changed = Signal.new() :: any, -- fires (snapshot)
}

StateController._snapshot = nil :: any

function StateController:GetSnapshot(): any
	return self._snapshot
end

function StateController:GetNation(): Nation?
	return self._snapshot and self._snapshot.nation or nil
end

function StateController:GetStats(): any
	return self._snapshot and self._snapshot.stats or {}
end

--- True once the first snapshot has arrived (used to gate UI construction).
function StateController:IsReady(): boolean
	return self._snapshot ~= nil
end

function StateController:Init()
	Net.onEvent(NetRoutes.STATE_SYNC, function(snapshot)
		if typeof(snapshot) ~= "table" or typeof(snapshot.nation) ~= "table" then
			return
		end
		local first = self._snapshot == nil
		self._snapshot = snapshot
		self.Changed:Fire(snapshot)
		if first then
			log:Info("received first nation snapshot")
		end
	end)
end

return StateController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000057"><Properties><string name="Name">TerritoryController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/TerritoryController.luau
	The world map: a grid of claimable regions laid out from the Regions config
	and coloured by who holds each (you, an ally, an AI, another player, or
	unclaimed). Click a region to spend influence and claim it — the server
	enforces adjacency, cost and ownership.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Regions = require(ReplicatedStorage.Nexus.Config.Regions)
local Resources = require(ReplicatedStorage.Nexus.Config.Resources)

local Create = require(script.Parent.Parent.UI.Create)
local Decor = require(script.Parent.Parent.UI.Decor)
local Format = require(script.Parent.Parent.UI.Format)
local Motion = require(script.Parent.Parent.UI.Motion)
local Theme = require(script.Parent.Parent.UI.Theme)

local CELL = 82
local GAP = 6

local TerritoryController = {
	Name = "TerritoryController",
}

TerritoryController._panel = nil :: Frame?
TerritoryController._cells = {} :: { [string]: Frame }

local function bonusSummary(bonus: any): string
	local parts = {}
	for id, amount in bonus do
		table.insert(parts, Resources[id].symbol .. Format.abbrev(amount))
	end
	return table.concat(parts, " ")
end

function TerritoryController:_build()
	local HudController = require(script.Parent.HudController)
	local gui = HudController:GetGui()

	local board = Create("Frame", {
		Position = UDim2.fromOffset(12, 44),
		Size = UDim2.fromOffset(4 * CELL + 3 * GAP, 3 * CELL + 2 * GAP),
		BackgroundTransparency = 1,
	})

	for regionId, def in Regions do
		local cell = Create("TextButton", {
			Name = regionId,
			AutoButtonColor = true,
			BackgroundColor3 = Theme.color.panelLight,
			Position = UDim2.fromOffset(def.col * (CELL + GAP), def.row * (CELL + GAP)),
			Size = UDim2.fromOffset(CELL, CELL),
			Text = "",
			[Create.Children] = {
				Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
				Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(6, 5),
					Size = UDim2.new(1, -12, 0, 24),
					Font = Theme.font.bold,
					Text = def.displayName,
					TextColor3 = Theme.color.text,
					TextSize = 11,
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
				}),
				Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(6, 34),
					Size = UDim2.new(1, -12, 0, 14),
					Font = Theme.font.medium,
					Text = bonusSummary(def.bonus),
					TextColor3 = Theme.color.good,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
				}),
				Create("TextLabel", {
					Name = "Owner",
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 6, 1, -5),
					Size = UDim2.new(1, -12, 0, 24),
					Font = Theme.font.regular,
					Text = ("◆%d to claim"):format(def.cost),
					TextColor3 = Theme.color.textDim,
					TextSize = 10,
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Bottom,
				}),
			},
			[Create.Event] = { Activated = function()
				-- Cinematic travel to the region, then attempt to claim/expand.
				local WorldController = require(script.Parent.WorldController)
				WorldController:FlyToRegion(regionId)
				if self._panel then
					Motion.hide(self._panel)
				end
				task.spawn(function()
					Net.request(NetRoutes.CLAIM_REGION, { regionId = regionId })
				end)
			end },
		}) :: Frame
		cell.Parent = board
		self._cells[regionId] = cell
	end

	local panel = Create("Frame", {
		Name = "TerritoryPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(4 * CELL + 3 * GAP + 24, 3 * CELL + 2 * GAP + 60),
		BackgroundColor3 = Theme.color.panel,
		Visible = false,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = Theme.corner }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1 }),
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(14, 10),
				Size = UDim2.new(1, -140, 0, 24),
				Font = Theme.font.bold,
				Text = "🗺 World Map",
				TextColor3 = Theme.color.text,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Create("TextButton", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, 8),
				Size = UDim2.fromOffset(112, 28),
				BackgroundColor3 = Theme.color.accentDim,
				Font = Theme.font.bold,
				Text = "🏙 Capital",
				TextColor3 = Theme.color.text,
				TextSize = 13,
				[Create.Children] = { Create("UICorner", { CornerRadius = UDim.new(0, 8) }) },
				[Create.Event] = { Activated = function()
					local WorldController = require(script.Parent.WorldController)
					WorldController:FlyToCapital()
					if self._panel then
						Motion.hide(self._panel)
					end
				end },
			}),
			board,
		},
	}) :: Frame
	Decor.gradient(panel, Theme.gradient.panel)
	panel.Parent = gui
	self._panel = panel
end

function TerritoryController:_refresh()
	local WorldStateController = require(script.Parent.WorldStateController)
	local StateController = require(script.Parent.StateController)
	local map = WorldStateController:GetTerritory()
	local myId = Players.LocalPlayer.UserId
	local nation = StateController:GetNation()
	local allies = nation and nation.diplomacy and nation.diplomacy.allies or {}

	local ownerById: { [string]: any } = {}
	for _, entry in map do
		ownerById[entry.id] = entry
	end

	for regionId, cell in self._cells do
		local entry = ownerById[regionId]
		local ownerLabel = cell:FindFirstChild("Owner") :: TextLabel
		local def = Regions[regionId]
		if entry and entry.ownerId then
			local ownerId = entry.ownerId
			local color, tag
			if ownerId == myId then
				color, tag = Theme.color.accent, "You"
			elseif allies[tostring(ownerId)] then
				color, tag = Theme.color.good, "Ally: " .. (entry.ownerName or "?")
			elseif ownerId &lt; 0 then
				color, tag = Theme.color.warn, entry.ownerName or "AI"
			else
				color, tag = Color3.fromRGB(170, 130, 230), entry.ownerName or "Rival"
			end
			cell.BackgroundColor3 = color:Lerp(Theme.color.bg, 0.55)
			local stroke = cell:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = color
			end
			ownerLabel.Text = tag
			ownerLabel.TextColor3 = color
		else
			cell.BackgroundColor3 = Theme.color.panelLight
			local stroke = cell:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Theme.color.stroke
			end
			ownerLabel.Text = ("◆%d to claim"):format(def.cost)
			ownerLabel.TextColor3 = Theme.color.textDim
		end
	end
end

function TerritoryController:Start()
	local HudController = require(script.Parent.HudController)
	local WorldStateController = require(script.Parent.WorldStateController)
	local StateController = require(script.Parent.StateController)

	self:_build()
	HudController:AddButton("🗺 Territory", function()
		if self._panel then
			Motion.toggle(self._panel)
		end
	end)

	WorldStateController.TerritoryChanged:Connect(function()
		self:_refresh()
	end)
	StateController.Changed:Connect(function()
		self:_refresh()
	end)
	self:_refresh()
end

return TerritoryController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000058"><Properties><string name="Name">WorldController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/WorldController.luau
	Builds the 3D city view: a stylized ground with a glowing district grid,
	surrounding water, an RTS overhead camera you can pan and zoom, and a
	multi-part model per building rendered from the replicated snapshot.

	Visuals are intentionally client-side and non-authoritative — the server owns
	the data; this controller only draws it. Buildings are Models tagged with a
	`buildingId` attribute so BuildController can pick them for selection. New
	buildings fade in; power-starved ones read as faded and dim.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Players = game:GetService("Players")

local Buildings = require(ReplicatedStorage.Nexus.Config.Buildings)
local Regions = require(ReplicatedStorage.Nexus.Config.Regions)
local Resources = require(ReplicatedStorage.Nexus.Config.Resources)
local WorldGrid = require(ReplicatedStorage.Nexus.WorldGrid)

local Theme = require(script.Parent.Parent.UI.Theme)

-- How far apart region zones sit in the world, and how far the camera may roam.
local REGION_SPACING = 820
local WORLD_RADIUS = 1500

-- Per-category look: body colour/material, roof colour, and a neon accent.
type Style = { body: Color3, material: Enum.Material, roof: Color3, accent: Color3 }
local STYLE: { [string]: Style } = {
	Housing = { body = Color3.fromRGB(96, 130, 180), material = Enum.Material.Concrete, roof = Color3.fromRGB(58, 80, 116), accent = Color3.fromRGB(120, 200, 255) },
	Power = { body = Color3.fromRGB(120, 122, 130), material = Enum.Material.Metal, roof = Color3.fromRGB(78, 80, 88), accent = Color3.fromRGB(250, 205, 90) },
	Food = { body = Color3.fromRGB(110, 158, 92), material = Enum.Material.Grass, roof = Color3.fromRGB(78, 116, 64), accent = Color3.fromRGB(150, 220, 120) },
	Industry = { body = Color3.fromRGB(170, 120, 82), material = Enum.Material.Metal, roof = Color3.fromRGB(120, 82, 54), accent = Color3.fromRGB(240, 150, 70) },
	Commerce = { body = Color3.fromRGB(86, 168, 160), material = Enum.Material.Glass, roof = Color3.fromRGB(52, 108, 104), accent = Color3.fromRGB(120, 230, 215) },
	Research = { body = Color3.fromRGB(126, 108, 200), material = Enum.Material.Metal, roof = Color3.fromRGB(84, 70, 140), accent = Color3.fromRGB(170, 140, 255) },
	Services = { body = Color3.fromRGB(196, 132, 176), material = Enum.Material.SmoothPlastic, roof = Color3.fromRGB(140, 90, 124), accent = Color3.fromRGB(240, 160, 210) },
	Government = { body = Color3.fromRGB(216, 220, 230), material = Enum.Material.Marble, roof = Color3.fromRGB(150, 156, 170), accent = Color3.fromRGB(245, 205, 120) },
}
local DEFAULT_STYLE: Style =
	{ body = Color3.fromRGB(170, 176, 188), material = Enum.Material.SmoothPlastic, roof = Color3.fromRGB(120, 126, 138), accent = Color3.fromRGB(200, 210, 230) }

local WorldController = {
	Name = "WorldController",
}

WorldController._parts = {} :: { [string]: Model }
WorldController._cityFolder = nil :: Folder?
WorldController._baseplate = nil :: BasePart?
WorldController._regionPads = {} :: { [string]: any }

-- Camera state.
WorldController._focus = Vector3.new(0, 0, 0)
WorldController._distance = 190
WorldController._pitch = math.rad(56)
WorldController._flying = false
WorldController._flyToken = 0
WorldController._gamepadPan = Vector2.zero
WorldController._gamepadZoom = 0
WorldController._pinchStartDist = nil :: number?

-- World-space centre of a region zone, spread out around the central city.
local function regionWorldPos(def: any): Vector3
	return Vector3.new((def.col - 1.5) * REGION_SPACING, 0, (def.row - 1) * REGION_SPACING)
end

local function bonusText(bonus: any): string
	local parts = {}
	for id, amount in bonus do
		table.insert(parts, Resources[id].symbol .. tostring(amount))
	end
	return table.concat(parts, "  ")
end

function WorldController:GetCityFolder(): Folder
	return assert(self._cityFolder, "city folder not ready")
end

function WorldController:GetBaseplate(): BasePart
	return assert(self._baseplate, "baseplate not ready")
end

--- The rendered Model for a building id, if it currently exists.
function WorldController:GetModel(id: string): Model?
	return self._parts[id]
end

-- ---- World construction ---------------------------------------------------

local function makeAnchored(name: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

function WorldController:_buildWorld()
	-- Surrounding water for context and reflection (spans out under the regions).
	local ocean = makeAnchored("NexusOcean")
	ocean.Size = Vector3.new(WorldGrid.SPAN * 9, 4, WorldGrid.SPAN * 9)
	ocean.Position = Vector3.new(0, -3.2, 0)
	ocean.Material = Enum.Material.Water
	ocean.Color = Color3.fromRGB(30, 58, 92)
	ocean.Transparency = 0.1
	ocean.Parent = Workspace

	-- The buildable land plate.
	local base = makeAnchored("NexusGround")
	base.CanCollide = true
	base.CanQuery = true
	base.Size = Vector3.new(WorldGrid.SPAN, 2, WorldGrid.SPAN)
	base.Position = Vector3.new(0, WorldGrid.GROUND_Y - 1, 0)
	base.Color = Color3.fromRGB(48, 56, 60)
	base.Material = Enum.Material.Slate
	base.Parent = Workspace
	self._baseplate = base

	-- A glowing district grid every few tiles reads as a planned city.
	local step = 8
	local half = WorldGrid.SPAN / 2
	local gridColor = Theme.color.accentDim
	for i = 0, WorldGrid.GRID_SIZE, step do
		local offset = -half + i * WorldGrid.STUDS
		for _, axis in { "x", "z" } do
			local line = makeAnchored("Grid")
			line.Material = Enum.Material.Neon
			line.Color = gridColor
			line.Transparency = 0.62
			line.CanQuery = false
			if axis == "x" then
				line.Size = Vector3.new(0.35, 0.2, WorldGrid.SPAN)
				line.Position = Vector3.new(offset, 0.06, 0)
			else
				line.Size = Vector3.new(WorldGrid.SPAN, 0.2, 0.35)
				line.Position = Vector3.new(0, 0.06, offset)
			end
			line.Parent = base
		end
	end

	-- A brighter neon frame around the whole territory.
	for _, spec in
		{
			{ s = Vector3.new(WorldGrid.SPAN, 0.5, 0.8), p = Vector3.new(0, 0.1, -half) },
			{ s = Vector3.new(WorldGrid.SPAN, 0.5, 0.8), p = Vector3.new(0, 0.1, half) },
			{ s = Vector3.new(0.8, 0.5, WorldGrid.SPAN), p = Vector3.new(-half, 0.1, 0) },
			{ s = Vector3.new(0.8, 0.5, WorldGrid.SPAN), p = Vector3.new(half, 0.1, 0) },
		}
	do
		local edge = makeAnchored("Border")
		edge.Material = Enum.Material.Neon
		edge.Color = Theme.color.accent
		edge.Transparency = 0.25
		edge.CanQuery = false
		edge.Size = spec.s
		edge.Position = spec.p
		edge.Parent = base
	end

	local folder = Instance.new("Folder")
	folder.Name = "NexusCity"
	folder.Parent = Workspace
	self._cityFolder = folder

	self:_buildRegionZones()
end

-- Physical region zones you can travel to, arranged around the capital.
function WorldController:_buildRegionZones()
	local zones = Instance.new("Folder")
	zones.Name = "NexusRegions"
	zones.Parent = Workspace

	for regionId, def in Regions do
		local center = regionWorldPos(def)

		local pad = makeAnchored("Region_" .. regionId)
		pad.Size = Vector3.new(300, 8, 300)
		pad.Position = center + Vector3.new(0, -4, 0)
		pad.Material = Enum.Material.SmoothPlastic
		pad.Color = Theme.color.panelLight
		pad.CanQuery = false
		pad.Parent = zones

		local box = Instance.new("SelectionBox")
		box.Adornee = pad
		box.LineThickness = 0.4
		box.Color3 = Theme.color.stroke
		box.SurfaceTransparency = 0.85
		box.Parent = pad

		-- Floating label so the region reads clearly from the overhead camera.
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Label"
		billboard.Size = UDim2.fromOffset(220, 96)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 26, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 4000
		billboard.Adornee = pad
		billboard.Parent = pad

		local card = Instance.new("Frame")
		card.Size = UDim2.fromScale(1, 1)
		card.BackgroundColor3 = Theme.color.panel
		card.BackgroundTransparency = 0.1
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = card
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.color.stroke
		stroke.Thickness = 1.5
		stroke.Parent = card
		card.Parent = billboard

		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Position = UDim2.fromOffset(8, 6)
		nameLabel.Size = UDim2.new(1, -16, 0, 24)
		nameLabel.Font = Theme.font.bold
		nameLabel.Text = def.displayName
		nameLabel.TextColor3 = Theme.color.text
		nameLabel.TextScaled = true
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = card

		local bonusLabel = Instance.new("TextLabel")
		bonusLabel.BackgroundTransparency = 1
		bonusLabel.Position = UDim2.fromOffset(8, 34)
		bonusLabel.Size = UDim2.new(1, -16, 0, 22)
		bonusLabel.Font = Theme.font.medium
		bonusLabel.Text = bonusText(def.bonus)
		bonusLabel.TextColor3 = Theme.color.good
		bonusLabel.TextScaled = true
		bonusLabel.TextXAlignment = Enum.TextXAlignment.Left
		bonusLabel.Parent = card

		local ownerLabel = Instance.new("TextLabel")
		ownerLabel.Name = "Owner"
		ownerLabel.BackgroundTransparency = 1
		ownerLabel.Position = UDim2.fromOffset(8, 60)
		ownerLabel.Size = UDim2.new(1, -16, 0, 28)
		ownerLabel.Font = Theme.font.regular
		ownerLabel.Text = "Unclaimed"
		ownerLabel.TextColor3 = Theme.color.textDim
		ownerLabel.TextScaled = true
		ownerLabel.TextXAlignment = Enum.TextXAlignment.Left
		ownerLabel.Parent = card

		self._regionPads[regionId] = { pad = pad, box = box, owner = ownerLabel }
	end
end

-- ---- Camera ---------------------------------------------------------------

function WorldController:_setupCamera()
	while not Workspace.CurrentCamera do
		task.wait()
	end
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 55

	local dragging = false
	local lastPos: Vector2? = nil

	local function updateCamera()
		local dir = Vector3.new(0, math.sin(self._pitch), math.cos(self._pitch))
		local camPos = self._focus + dir * self._distance
		camera.CFrame = CFrame.lookAt(camPos, self._focus)
	end

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or self._flying then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			lastPos = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
			lastPos = nil
		end
	end)

	-- Two-finger pinch to zoom (touch).
	UserInputService.TouchPinch:Connect(function(_touchPositions, scale, _velocity, state)
		if self._flying then
			return
		end
		if state == Enum.UserInputState.Begin then
			self._pinchStartDist = self._distance
		elseif state == Enum.UserInputState.Change and self._pinchStartDist and scale &gt; 0 then
			self._distance = math.clamp(self._pinchStartDist / scale, 60, 420)
		end
	end)

	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if self._flying then
			return -- manual control is frozen during a cinematic fly
		end
		-- Gamepad: left stick pans, right stick zooms (stored, applied per frame).
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			self._gamepadPan = Vector2.new(input.Position.X, input.Position.Y)
			return
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			self._gamepadZoom = input.Position.Y
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self._distance = math.clamp(self._distance - input.Position.Z * 18, 60, 420)
		elseif dragging and lastPos and
			(input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch)
		then
			if gameProcessed and input.UserInputType == Enum.UserInputType.Touch then
				return
			end
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			local delta = pos - lastPos
			lastPos = pos
			local speed = self._distance / 600
			self._focus += Vector3.new(-delta.X * speed, 0, -delta.Y * speed)
		end
	end)

	RunService:BindToRenderStep("NexusCamera", Enum.RenderPriority.Camera.Value, function()
		if not self._flying then
			local move = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				move += Vector3.new(0, 0, -1)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				move += Vector3.new(0, 0, 1)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				move += Vector3.new(-1, 0, 0)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				move += Vector3.new(1, 0, 0)
			end
			if move.Magnitude &gt; 0 then
				self._focus += move.Unit * (self._distance * 0.02)
			end
			-- Gamepad left-stick pan (deadzone) and right-stick zoom.
			if self._gamepadPan.Magnitude &gt; 0.15 then
				self._focus += Vector3.new(self._gamepadPan.X, 0, -self._gamepadPan.Y)
					* (self._distance * 0.03)
			end
			if math.abs(self._gamepadZoom) &gt; 0.15 then
				self._distance = math.clamp(self._distance - self._gamepadZoom * 6, 60, 420)
			end
			self._focus = Vector3.new(
				math.clamp(self._focus.X, -WORLD_RADIUS, WORLD_RADIUS),
				0,
				math.clamp(self._focus.Z, -WORLD_RADIUS, WORLD_RADIUS)
			)
		end
		updateCamera()
	end)
end

-- ---- Cinematic camera -----------------------------------------------------

--- GTA-style move: zoom out, glide to the target, zoom back in. Manual control
--- is frozen for the duration. Re-calling interrupts the previous fly cleanly.
function WorldController:FlyTo(targetFocus: Vector3, targetDistance: number, duration: number?)
	duration = duration or 1.5
	local startFocus = self._focus
	local startDist = self._distance
	local travel = (targetFocus - startFocus).Magnitude
	-- Bigger journeys pull the camera further out at the midpoint.
	local arc = math.clamp(travel * 0.4, 30, 900)

	self._flyToken += 1
	local token = self._flyToken
	self._flying = true

	task.spawn(function()
		local t0 = os.clock()
		while self._flyToken == token do
			local raw = (os.clock() - t0) / (duration :: number)
			if raw &gt;= 1 then
				break
			end
			local e = raw * raw * (3 - 2 * raw) -- smoothstep ease in/out
			self._focus = startFocus:Lerp(targetFocus, e)
			self._distance = startDist + (targetDistance - startDist) * e + arc * math.sin(math.pi * raw)
			RunService.RenderStepped:Wait()
		end
		if self._flyToken == token then
			self._focus = targetFocus
			self._distance = targetDistance
			self._flying = false
		end
	end)
end

--- Fly to a region zone by id.
function WorldController:FlyToRegion(regionId: string)
	local def = Regions[regionId]
	if def then
		self:FlyTo(regionWorldPos(def), 150)
	end
end

--- Fly back to the capital city.
function WorldController:FlyToCapital()
	self:FlyTo(Vector3.new(0, 0, 0), 190)
end

-- ---- Building rendering ----------------------------------------------------

local function orientedFootprint(def: any, rotation: number): (number, number)
	local w, h = def.footprint.w, def.footprint.h
	if rotation == 90 or rotation == 270 then
		return h, w
	end
	return w, h
end

-- Construct the model for one building at its final transform.
function WorldController:_buildModel(building: any): Model
	local def = Buildings[building.kind]
	local style = STYLE[def.category] or DEFAULT_STYLE
	local w, h = orientedFootprint(def, building.rotation)
	local footW = w * WorldGrid.STUDS
	local footH = h * WorldGrid.STUDS
	local bodyHeight = 4 + building.level * 2.6
	local center = WorldGrid.footprintCenter(building.position.x, building.position.z, w, h)

	local model = Instance.new("Model")
	model.Name = "Building_" .. building.id
	model:SetAttribute("buildingId", building.id)
	model:SetAttribute("level", building.level)
	model:SetAttribute("rot", building.rotation)

	-- Body.
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.Material = style.material
	body.Color = style.body
	body.Size = Vector3.new(footW * 0.86, bodyHeight, footH * 0.86)
	body.Position = center + Vector3.new(0, bodyHeight / 2, 0)
	body:SetAttribute("buildingId", building.id)
	body.Parent = model

	-- Roof cap.
	local roof = Instance.new("Part")
	roof.Name = "Roof"
	roof.Anchored = true
	roof.CanCollide = false
	roof.TopSurface = Enum.SurfaceType.Smooth
	roof.BottomSurface = Enum.SurfaceType.Smooth
	roof.Material = Enum.Material.Concrete
	roof.Color = style.roof
	roof.Size = Vector3.new(footW * 0.92, 1.2, footH * 0.92)
	roof.Position = center + Vector3.new(0, bodyHeight + 0.6, 0)
	roof:SetAttribute("buildingId", building.id)
	roof.Parent = model

	-- Neon accent ring near the top — glows under bloom.
	local accent = Instance.new("Part")
	accent.Name = "Accent"
	accent.Anchored = true
	accent.CanCollide = false
	accent.CanQuery = false
	accent.Material = Enum.Material.Neon
	accent.Color = style.accent
	accent.Size = Vector3.new(footW * 0.9, 0.5, footH * 0.9)
	accent.Position = center + Vector3.new(0, bodyHeight - 1.2, 0)
	accent.Parent = model

	-- A second accent band for taller buildings.
	if building.level &gt;= 3 then
		local band = accent:Clone()
		band.Name = "Accent2"
		band.Position = center + Vector3.new(0, bodyHeight * 0.55, 0)
		band.Parent = model
	end

	model.PrimaryPart = body
	model.Parent = self:GetCityFolder()

	-- Fade-in.
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			local target = part.Transparency
			part.Transparency = 1
			TweenService:Create(part, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
				Transparency = target,
			}):Play()
		end
	end

	return model
end

-- Fade a building for its power/condition state without rebuilding it.
local function setActive(model: Model, active: boolean)
	for _, part in model:GetChildren() do
		if not part:IsA("BasePart") then
			continue
		end
		if part.Name == "Accent" or part.Name == "Accent2" then
			part.Transparency = active and 0 or 0.8
		else
			part.Transparency = active and 0 or 0.55
		end
	end
end

function WorldController:_syncBuildings(nation: any)
	local seen: { [string]: boolean } = {}

	for id, building in nation.buildings do
		local def = Buildings[building.kind]
		if not def then
			continue
		end
		seen[id] = true

		local model = self._parts[id]
		local fresh = not model
			or model:GetAttribute("level") ~= building.level
			or model:GetAttribute("rot") ~= building.rotation
		if fresh then
			if model then
				model:Destroy()
			end
			model = self:_buildModel(building)
			self._parts[id] = model
		end
		setActive(model, building.active ~= false)
	end

	for id, model in self._parts do
		if not seen[id] then
			model:Destroy()
			self._parts[id] = nil
		end
	end
end

-- Recolour region zones to match ownership (you / ally / AI / rival / unclaimed).
function WorldController:_updateRegionPads(map: { any }?)
	local StateController = require(script.Parent.StateController)
	local WorldStateController = require(script.Parent.WorldStateController)
	map = map or WorldStateController:GetTerritory()
	local myId = Players.LocalPlayer.UserId
	local nation = StateController:GetNation()
	local allies = nation and nation.diplomacy and nation.diplomacy.allies or {}

	local byId: { [string]: any } = {}
	for _, entry in map :: { any } do
		byId[entry.id] = entry
	end

	for regionId, refs in self._regionPads do
		local entry = byId[regionId]
		local color, tag
		if entry and entry.ownerId then
			local ownerId = entry.ownerId
			if ownerId == myId then
				color, tag = Theme.color.accent, "Your territory"
			elseif allies[tostring(ownerId)] then
				color, tag = Theme.color.good, "Ally: " .. (entry.ownerName or "?")
			elseif ownerId &lt; 0 then
				color, tag = Theme.color.warn, entry.ownerName or "AI"
			else
				color, tag = Color3.fromRGB(170, 130, 230), entry.ownerName or "Rival"
			end
		else
			color, tag = Theme.color.stroke, "Unclaimed"
		end
		refs.pad.Color = color:Lerp(Theme.color.bg, 0.6)
		refs.box.Color3 = color
		refs.owner.Text = tag
		refs.owner.TextColor3 = color
	end
end

function WorldController:Init()
	self:_buildWorld()
	self:_setupCamera()
end

function WorldController:Start()
	local StateController = require(script.Parent.StateController)
	local WorldStateController = require(script.Parent.WorldStateController)

	StateController.Changed:Connect(function(snapshot)
		self:_syncBuildings(snapshot.nation)
		self:_updateRegionPads(nil)
	end)
	WorldStateController.TerritoryChanged:Connect(function(map)
		self:_updateRegionPads(map)
	end)
	if StateController:IsReady() then
		self:_syncBuildings(StateController:GetSnapshot().nation)
	end
	self:_updateRegionPads(nil)
end

return WorldController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000059"><Properties><string name="Name">WorldStateController</string><ProtectedString name="Source">--!strict
--[[
	Controllers/WorldStateController.luau
	Client store for world-scope data that isn't part of the player's own nation:
	the ranked directory of all nations (WORLD_SYNC) and the player's trade inbox
	(TRADE_INBOX). Diplomacy and leaderboard panels subscribe here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Nexus.Net)
local NetRoutes = require(ReplicatedStorage.Nexus.NetRoutes)
local Signal = require(ReplicatedStorage.Nexus.Signal)

local WorldStateController = {
	Name = "WorldStateController",
	DirectoryChanged = Signal.new() :: any, -- fires (directory)
	InboxChanged = Signal.new() :: any, -- fires (inbox)
	TerritoryChanged = Signal.new() :: any, -- fires (territory map)
}

WorldStateController._directory = {} :: { any }
WorldStateController._inbox = { incoming = {}, outgoing = {} } :: any
WorldStateController._territory = {} :: { any }

function WorldStateController:GetDirectory(): { any }
	return self._directory
end

function WorldStateController:GetInbox(): any
	return self._inbox
end

function WorldStateController:GetTerritory(): { any }
	return self._territory
end

function WorldStateController:Init()
	Net.onEvent(NetRoutes.WORLD_SYNC, function(list)
		if typeof(list) ~= "table" then
			return
		end
		self._directory = list
		self.DirectoryChanged:Fire(list)
	end)
	Net.onEvent(NetRoutes.TRADE_INBOX, function(data)
		if typeof(data) ~= "table" then
			return
		end
		self._inbox = { incoming = data.incoming or {}, outgoing = data.outgoing or {} }
		self.InboxChanged:Fire(self._inbox)
	end)
	Net.onEvent(NetRoutes.TERRITORY_SYNC, function(map)
		if typeof(map) ~= "table" then
			return
		end
		self._territory = map
		self.TerritoryChanged:Fire(map)
	end)
end

return WorldStateController
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000068"><Properties><string name="Name">UI</string></Properties><Item class="Folder" referent="RBX00000061"><Properties><string name="Name">Components</string></Properties></Item><Item class="ModuleScript" referent="RBX00000062"><Properties><string name="Name">Create</string><ProtectedString name="Source">--!strict
--[[
	UI/Create.luau
	A tiny declarative helper for building Instance trees without the noise of
	imperative property assignment. Inspired by common Roblox UI idioms but kept
	dependency-free.

	Usage:
		Create("TextButton", {
			Text = "Build",
			Size = UDim2.fromOffset(120, 40),
			[Create.Event] = { Activated = function() ... end },
			[Create.Children] = { Create("UICorner", { CornerRadius = ... }) },
		})
]]

local Create = {}

-- Sentinel keys used inside the property table.
local CHILDREN = newproxy(false)
local EVENT = newproxy(false)

Create.Children = CHILDREN
Create.Event = EVENT

function Create.build(className: string, props: { [any]: any }?): Instance
	local instance = Instance.new(className)
	if props then
		local children = props[CHILDREN]
		local events = props[EVENT]

		for key, value in props do
			if key ~= CHILDREN and key ~= EVENT then
				(instance :: any)[key] = value
			end
		end

		if events then
			for eventName, handler in events do
				(instance :: any)[eventName]:Connect(handler)
			end
		end
		if children then
			for _, child in children do
				child.Parent = instance
			end
		end
	end
	return instance
end

-- Allow calling the module table itself: Create("Frame", { ... }).
local callable = setmetatable(Create, {
	__call = function(_, className: string, props: { [any]: any }?): Instance
		return Create.build(className, props)
	end,
})

-- The `any` cast lets callers use both `Create("Frame")` and `Create.Children`.
return (callable :: any) :: (((className: string, props: { [any]: any }?) -&gt; Instance) &amp; typeof(Create))
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000063"><Properties><string name="Name">Decor</string><ProtectedString name="Source">--!strict
--[[
	UI/Decor.luau
	Small cosmetic helpers so every panel, chip and button gets the same finish
	without repeating boilerplate. Purely presentational — safe to apply to any
	GuiObject after it is built.
]]

local Theme = require(script.Parent.Theme)

local Decor = {}

--- Apply a vertical gradient to a GuiObject's background. `pair` is a
--- `{ topColor, bottomColor }` from Theme.gradient.
function Decor.gradient(instance: GuiObject, pair: { Color3 }, rotation: number?)
	local existing = instance:FindFirstChildOfClass("UIGradient")
	local grad = existing or Instance.new("UIGradient")
	grad.Color = ColorSequence.new(pair[1], pair[2])
	grad.Rotation = rotation or 90
	grad.Parent = instance
	return grad
end

--- Standard panel finish: rounded corners, gradient body and a hairline stroke.
--- Idempotent — only adds what is missing.
function Decor.panel(frame: GuiObject)
	if not frame:FindFirstChildOfClass("UICorner") then
		local c = Instance.new("UICorner")
		c.CornerRadius = Theme.corner
		c.Parent = frame
	end
	if not frame:FindFirstChildOfClass("UIStroke") then
		local s = Instance.new("UIStroke")
		s.Color = Theme.color.stroke
		s.Thickness = 1
		s.Transparency = 0.15
		s.Parent = frame
	end
	Decor.gradient(frame, Theme.gradient.panel)
	return frame
end

--- A faux drop shadow: a soft, offset rounded frame placed behind `frame` in the
--- same parent. Cheap and asset-free. Returns the shadow frame.
function Decor.shadow(frame: GuiObject): Frame
	local shadow = Instance.new("Frame")
	shadow.Name = frame.Name .. "_Shadow"
	shadow.BackgroundColor3 = Color3.new(0, 0, 0)
	shadow.BackgroundTransparency = 0.55
	shadow.AnchorPoint = frame.AnchorPoint
	shadow.Position = frame.Position + UDim2.fromOffset(0, 6)
	shadow.Size = frame.Size + UDim2.fromOffset(10, 12)
	shadow.ZIndex = frame.ZIndex - 1
	local c = Instance.new("UICorner")
	c.CornerRadius = Theme.corner
	c.Parent = shadow
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0.85),
	})
	grad.Parent = shadow
	shadow.Parent = frame.Parent
	return shadow
end

return Decor
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000064"><Properties><string name="Name">Format</string><ProtectedString name="Source">--!strict
--[[
	UI/Format.luau
	Number/text formatting shared by every panel, so "12.3k" and "+4.5%" look the
	same everywhere.
]]

local Format = {}

--- Abbreviate a number: 1500 -&gt; "1.5k", 2_300_000 -&gt; "2.3M".
function Format.abbrev(n: number): string
	local abs = math.abs(n)
	local sign = n &lt; 0 and "-" or ""
	if abs &gt;= 1e9 then
		return ("%s%.2fB"):format(sign, abs / 1e9)
	elseif abs &gt;= 1e6 then
		return ("%s%.2fM"):format(sign, abs / 1e6)
	elseif abs &gt;= 1e3 then
		return ("%s%.1fk"):format(sign, abs / 1e3)
	end
	return ("%s%d"):format(sign, math.floor(abs + 0.5))
end

--- A signed flow value, e.g. "+120" or "-45".
function Format.signed(n: number): string
	local prefix = n &gt;= 0 and "+" or ""
	return prefix .. Format.abbrev(n)
end

function Format.percent(fraction: number): string
	return ("%d%%"):format(math.floor(fraction * 100 + 0.5))
end

function Format.round(n: number): string
	return tostring(math.floor(n + 0.5))
end

return Format
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000065"><Properties><string name="Name">Graph</string><ProtectedString name="Source">--!strict
--[[
	UI/Graph.luau
	A tiny, asset-free bar graph. Given a container size it returns the frame plus
	an `update(values)` function that redraws scaled bars. Used by the economy
	panel to visualise replicated GDP history. Bars are recreated on update, which
	is cheap at the economy tick's cadence.
]]

local Create = require(script.Parent.Create)
local Theme = require(script.Parent.Theme)

local Graph = {}

--- Returns (frame, update). `update(values, color?)` redraws the graph.
function Graph.new(size: UDim2): (Frame, (values: { number }, color: Color3?) -&gt; ())
	local plot = Create("Frame", {
		Name = "Plot",
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		BackgroundTransparency = 1,
	}) :: Frame

	local frame = Create("Frame", {
		Name = "Graph",
		Size = size,
		BackgroundColor3 = Theme.color.bg,
		BackgroundTransparency = 0.25,
		[Create.Children] = {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("UIStroke", { Color = Theme.color.stroke, Thickness = 1, Transparency = 0.4 }),
			plot,
		},
	}) :: Frame

	local function update(values: { number }, color: Color3?)
		for _, child in plot:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local n = #values
		if n == 0 then
			return
		end
		local maxV = 0
		for _, v in values do
			maxV = math.max(maxV, v)
		end
		if maxV &lt;= 0 then
			maxV = 1
		end
		local barColor = color or Theme.color.accent
		local slot = 1 / n
		for i, v in values do
			local h = math.clamp(v / maxV, 0.02, 1)
			local bar = Create("Frame", {
				Name = "Bar",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new((i - 0.5) * slot, 0, 1, 0),
				Size = UDim2.new(slot, -1, h, 0),
				BackgroundColor3 = barColor,
				BorderSizePixel = 0,
				[Create.Children] = {
					Create("UICorner", { CornerRadius = UDim.new(0, 2) }),
					-- Taller bars glow a little warmer.
					Create("UIGradient", {
						Rotation = 90,
						Color = ColorSequence.new(Theme.color.accent2, barColor),
						Transparency = NumberSequence.new(0.05, 0.35),
					}),
				},
			})
			bar.Parent = plot
		end
	end

	return frame, update
end

return Graph
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000066"><Properties><string name="Name">Motion</string><ProtectedString name="Source">--!strict
--[[
	UI/Motion.luau
	Tiny animation helpers so panels don't just snap on/off. Uses a UIScale child
	for a subtle pop and a background fade, keeping call sites to one line.
]]

local TweenService = game:GetService("TweenService")

local Motion = {}

local SHOW = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local HIDE = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local function scaleOf(frame: GuiObject): UIScale
	local s = frame:FindFirstChildOfClass("UIScale")
	if not s then
		s = Instance.new("UIScale")
		s.Parent = frame
	end
	return s
end

function Motion.show(frame: GuiObject)
	local s = scaleOf(frame)
	s.Scale = 0.92
	frame.Visible = true
	TweenService:Create(s, SHOW, { Scale = 1 }):Play()
end

function Motion.hide(frame: GuiObject)
	local s = scaleOf(frame)
	local tween = TweenService:Create(s, HIDE, { Scale = 0.94 })
	tween:Play()
	tween.Completed:Once(function()
		frame.Visible = false
	end)
end

function Motion.toggle(frame: GuiObject)
	if frame.Visible then
		Motion.hide(frame)
	else
		Motion.show(frame)
	end
end

return Motion
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000067"><Properties><string name="Name">Theme</string><ProtectedString name="Source">--!strict
--[[
	UI/Theme.luau
	Design tokens for the whole interface. One place to restyle the game. Tuned
	for a modern, cinematic strategy dashboard: deep navy chrome, a cyan-blue
	primary, a warm gold secondary, and gradient pairs used across panels, chips
	and buttons so the UI reads as one system.
]]

local Theme = {}

Theme.color = {
	bg = Color3.fromRGB(13, 17, 28),
	panel = Color3.fromRGB(23, 28, 43),
	panelLight = Color3.fromRGB(33, 40, 57),
	stroke = Color3.fromRGB(52, 63, 88),
	accent = Color3.fromRGB(79, 168, 255),
	accent2 = Color3.fromRGB(245, 196, 107),
	accentDim = Color3.fromRGB(46, 92, 153),
	text = Color3.fromRGB(234, 241, 251),
	textDim = Color3.fromRGB(138, 151, 173),
	good = Color3.fromRGB(70, 208, 138),
	warn = Color3.fromRGB(243, 180, 81),
	bad = Color3.fromRGB(240, 101, 95),
}

-- Gradient pairs (top -&gt; bottom) used by UI/Decor.
Theme.gradient = {
	panel = { Color3.fromRGB(30, 38, 56), Color3.fromRGB(19, 24, 37) },
	chip = { Color3.fromRGB(41, 50, 70), Color3.fromRGB(28, 34, 49) },
	accent = { Color3.fromRGB(93, 178, 255), Color3.fromRGB(62, 123, 214) },
	topbar = { Color3.fromRGB(20, 26, 41), Color3.fromRGB(12, 16, 26) },
}

Theme.font = {
	regular = Enum.Font.Gotham,
	medium = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
	black = Enum.Font.GothamBlack,
}

Theme.severityColor = {
	info = Theme.color.accent,
	success = Theme.color.good,
	warning = Theme.color.warn,
	error = Theme.color.bad,
}

Theme.corner = UDim.new(0, 12)
Theme.pad = 10

return Theme
</ProtectedString></Properties></Item></Item></Item></Item></Item><Item class="Workspace" referent="RBX00000074"><Properties><bool name="StreamingEnabled">true</bool></Properties></Item><Item class="Players" referent="RBX00000075"><Properties><bool name="CharacterAutoLoads">false</bool></Properties></Item>
