}

return Governments
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Laws</string><ProtectedString name="Source">--!strict
--[[
	Config/Laws.luau
	Toggleable national policies. Each law is a trade-off applied while active,
	so a player crafts an identity by stacking laws that fit their strategy.
	Some laws require a government type or technology to enact.
]]

local Types = require(script.Parent.Parent.Types)

type GovernmentId = Types.GovernmentId

export type LawDef = {
	id: string,
	displayName: string,
	description: string,
	requiresTech: string?,
	forbiddenGovernments: { GovernmentId },
	modifiers: {
		happiness: number?,
		taxEfficiency: number?,
		corruption: number?,
		researchBonus: number?,
		foodProduction: number?,
		stability: number?,
		upkeep: number?, -- multiplier on all building upkeep
	},
}

local Laws: { [string]: LawDef } = {
	free_healthcare = {
		id = "free_healthcare",
		displayName = "Universal Healthcare",
		description = "+happiness and health, but building upkeep rises 8%.",
		requiresTech = "medicine_1",
		forbiddenGovernments = {},
		modifiers = { happiness = 5, upkeep = 0.08 },
	},
	free_education = {
		id = "free_education",
		displayName = "Free Education",
		description = "Boosts research output 15% at the cost of 6% upkeep.",
		requiresTech = nil,
		forbiddenGovernments = {},
		modifiers = { researchBonus = 0.15, upkeep = 0.06 },
	},
	anti_corruption = {
		id = "anti_corruption",
		displayName = "Anti-Corruption Bureau",
		description = "Sharply reduces corruption; slightly lowers stability.",
		requiresTech = "government_1",
		forbiddenGovernments = { "authoritarian" },
		modifiers = { corruption = -12, stability = -2 },
	},
	subsidised_farming = {
		id = "subsidised_farming",
		displayName = "Farm Subsidies",
		description = "+20% food production, funded by lower tax efficiency.",
		requiresTech = nil,
		forbiddenGovernments = {},
		modifiers = { foodProduction = 0.20, taxEfficiency = -0.05 },
	},
	martial_law = {
		id = "martial_law",
		displayName = "Martial Law",
		description = "Large stability gain, heavy happiness cost.",
		requiresTech = nil,
		forbiddenGovernments = { "democracy" },
		modifiers = { stability = 15, happiness = -10 },
	},
	press_freedom = {
		id = "press_freedom",
		displayName = "Press Freedom",
		description = "Happier, less corrupt citizens; a small stability risk.",
		requiresTech = nil,
		forbiddenGovernments = { "authoritarian", "military" },
		modifiers = { happiness = 4, corruption = -5, stability = -3 },
	},
}

return Laws
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Market</string><ProtectedString name="Source">--!strict
--[[
	Config/Market.luau
	Tuning for the global commodity market. Prices are money-per-unit and move
	each market tick from three forces: mean-reversion toward `base`, random
	volatility, and net player demand (buys push up, sells push down). A small
	spread makes the market maker's buy price higher than its sell price, so you
	can't arbitrage instantly.

	Money is the currency and energy is a flow, so neither is marketable; the four
	stockpiled resources are.
]]

local Market = {}

Market.tick = 6 -- seconds between price updates
Market.spread = 0.03 -- buy at +3%, sell at -3%
Market.meanReversion = 0.05 -- pull toward base each tick
Market.impact = 0.0006 -- price move per unit of net demand
Market.demandDecay = 0.5 -- how fast demand pressure fades
Market.floorFactor = 0.4 -- price never below base * this
Market.ceilFactor = 2.5 -- ...nor above base * this

export type Commodity = { base: number, volatility: number }

Market.resources = {
	materials = { base = 8, volatility = 0.06 },
	food = { base = 3, volatility = 0.05 },
	research = { base = 16, volatility = 0.09 },
	influence = { base = 13, volatility = 0.08 },
} :: { [string]: Commodity }

-- Stable display order.
Market.order = { "materials", "food", "research", "influence" }

return Market
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">MilitaryUnits</string><ProtectedString name="Source">--!strict
--[[
	Config/MilitaryUnits.luau
	Unit definitions for the (optional) military layer. Keys match the fields of
	Types.Military (army/navy/air). Units are a strategy-and-logistics investment:
	they cost resources up front, draw money upkeep every tick, and contribute
	strength used for power ranking, region defense, and forceful expansion
	against AI. Higher tiers are gated behind military technology.
]]

local Types = require(script.Parent.Parent.Types)

export type UnitDef = {
	branch: string,
	displayName: string,
	description: string,
	cost: Types.ResourceBag,
	upkeep: number, -- money per economy tick per unit
	strength: number,
	requiresTech: string?,
}

local MilitaryUnits: { [string]: UnitDef } = {
	army = {
		branch = "army",
		displayName = "Army Division",
		description = "Cheap, versatile ground forces. No prerequisites.",
		cost = { money = 1500, materials = 20 },
		upkeep = 15,
		strength = 3,
		requiresTech = nil,
	},
	navy = {
		branch = "navy",
		displayName = "Naval Fleet",
		description = "Projects power along coasts. Needs Naval Command.",
		cost = { money = 4000, materials = 80 },
		upkeep = 40,
		strength = 4,
		requiresTech = "military_1",
	},
	air = {
		branch = "air",
		displayName = "Air Wing",
		description = "Elite strike capability. Needs Air Command.",
		cost = { money = 7000, materials = 140 },
		upkeep = 70,
		strength = 5,
		requiresTech = "military_2",
	},
}

return MilitaryUnits
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Regions</string><ProtectedString name="Source">--!strict
--[[
	Config/Regions.luau
	The shared world map of claimable regions. Regions sit on a grid; two regions
	are adjacent when they share an edge (computed from col/row in TerritoryService).
	Each owned region grants its `bonus` to the owner every economy tick and adds
	to national power. `cost` is the base influence to claim it (scaled by how many
	the claimant already holds).
]]

local Types = require(script.Parent.Parent.Types)

export type RegionDef = {
	id: string,
	displayName: string,
	col: number,
	row: number,
	cost: number, -- base influence
	value: number, -- strategic value (power score weight, display)
	bonus: Types.ResourceBag, -- per economy tick to the owner
}

local Regions: { [string]: RegionDef } = {}

local function define(def: RegionDef)
	Regions[def.id] = def
end

-- Row 0
define({ id = "harbor_flats", displayName = "Harbor Flats", col = 0, row = 0, cost = 40, value = 3, bonus = { money = 90 } })
define({ id = "iron_hills", displayName = "Iron Hills", col = 1, row = 0, cost = 45, value = 3, bonus = { materials = 10 } })
define({ id = "green_valley", displayName = "Green Valley", col = 2, row = 0, cost = 40, value = 2, bonus = { food = 30 } })
define({ id = "silver_coast", displayName = "Silver Coast", col = 3, row = 0, cost = 55, value = 4, bonus = { money = 70, influence = 2 } })
-- Row 1
define({ id = "emberworks", displayName = "Emberworks", col = 0, row = 1, cost = 50, value = 3, bonus = { materials = 8, money = 40 } })
define({ id = "central_basin", displayName = "Central Basin", col = 1, row = 1, cost = 60, value = 4, bonus = { money = 60, food = 15 } })
define({ id = "lumen_fields", displayName = "Lumen Fields", col = 2, row = 1, cost = 65, value = 4, bonus = { research = 6 } })
define({ id = "trade_nexus", displayName = "Trade Nexus", col = 3, row = 1, cost = 70, value = 5, bonus = { influence = 5, money = 50 } })
-- Row 2
define({ id = "frostmark", displayName = "Frostmark", col = 0, row = 2, cost = 50, value = 3, bonus = { materials = 6, research = 3 } })
define({ id = "highland_reach", displayName = "Highland Reach", col = 1, row = 2, cost = 55, value = 3, bonus = { food = 20, materials = 4 } })
define({ id = "aurora_steppe", displayName = "Aurora Steppe", col = 2, row = 2, cost = 75, value = 5, bonus = { research = 8 } })
define({ id = "meridian_cape", displayName = "Meridian Cape", col = 3, row = 2, cost = 70, value = 5, bonus = { influence = 6 } })

return Regions
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Resources</string><ProtectedString name="Source">--!strict
--[[
	Config/Resources.luau
	Display metadata for each resource. Simulation math lives elsewhere; this is
	purely how a resource is labelled and coloured in the UI.
]]

export type ResourceMeta = {
	id: string,
	displayName: string,
	symbol: string,
	color: { number }, -- {r, g, b} 0..1
	-- Whether the HUD shows an absolute stockpile or a per-tick flow.
	kind: "stock" | "flow",
	description: string,
}

local Resources: { [string]: ResourceMeta } = {
	money = {
		id = "money",
		displayName = "Treasury",
		symbol = "$",
		color = { 0.36, 0.82, 0.45 },
		kind = "stock",
